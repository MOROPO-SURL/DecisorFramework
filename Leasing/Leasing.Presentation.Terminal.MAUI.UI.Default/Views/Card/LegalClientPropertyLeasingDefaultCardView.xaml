<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Leasing.Interop.API.Common"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:ffimageloading_views="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:Class="MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Views.Card.LegalClientPropertyLeasingDefaultCardView"
    x:DataType="interop_common_display_models:LegalClientPropertyLeasingDisplayModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Frame Padding="0">
        <Grid ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ffimageloading_views:CachedImage
                Grid.Column="0"
                Aspect="AspectFill"               
                Source="{Binding Contract.Property.FeatureImage, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
            <BoxView Grid.Column="1" Color="{AppThemeBinding Light=LightGray, Dark=DimGray}" />
            <StackLayout 
                Grid.Column="2"
                Padding="16">
                <Label 
                    FontAttributes="Bold"
                    FontSize="Medium"
                    LineBreakMode="TailTruncation"
                    Text="{Binding Contract.Property.Name}" />
                <Label
                    FontAttributes="Bold"
                    Text="{Binding Contract.Property.Kind.Name}" />
                <Label 
                    Margin="0,8,0,0"
                    Text="Entidad Administrativa"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold" />
                <Label
                    LineBreakMode="TailTruncation"
                    Text="{Binding Contract.Property.Structure.Identity.Name}" />
                <Label 
                    Margin="0,8,0,4"
                    Text="Arrendatario"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border 
                        Grid.Column="0"
                        VerticalOptions="Center"
                        StrokeThickness="4"
                        StrokeLineJoin="Bevel">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <ffimageloading_views:CachedImage
                            WidthRequest="64" HeightRequest="64"
                            Source="{Binding Contract.Client.Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
                    </Border>
                    <StackLayout 
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Padding="10,0">
                        <Label
                            ToolTipProperties.Text="{Binding Contract.Client.Contact.Identity.Name}"
                            Text="{Binding Contract.Client.Contact.Identity.Name}"
                            FontSize="Medium"
                            LineBreakMode="TailTruncation" />
                        <Label
                            ToolTipProperties.Text="{Binding Contract.Client.Contact.BusinessKind.Name}"
                            Text="{Binding Contract.Client.Contact.BusinessKind.Name}"
                            LineBreakMode="TailTruncation" />
                    </StackLayout>
                </Grid>
            </StackLayout>
        </Grid>
    </Frame>
</ContentView>
