<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Leasing.Interop.API.Common"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    x:Class="MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Views.Card.PropertyLeaseOfferDefaultCardView"
    x:DataType="interop_common_display_models:PropertyLeaseOfferDisplayModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Frame Padding="0">
        <Grid ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Aspect="AspectFill"               
                Source="{Binding Propousal.Property.FeatureImage, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
            <StackLayout 
                Grid.Column="1"
                Padding="16">
                <Label 
                    FontAttributes="Bold"
                    FontSize="Medium"
                    LineBreakMode="TailTruncation"
                    MaxLines="2"
                    Text="{Binding Propousal.Property.Name}" />
                <Label Text="{Binding Propousal.Property.Kind.Name}" />
                <Label 
                    Margin="0,8,0,0"
                    Text="Entidad Administrativa"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold" />
                <Label
                    LineBreakMode="TailTruncation"
                    Text="{Binding Propousal.Property.Structure.Identity.Name}" />
                <Label 
                    Margin="0,8,0,0"
                    Text="Acuerdo C/D superior"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold" />
                <Label
                    LineBreakMode="TailTruncation">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="No." />
                            <Span Text="{Binding Agreement.Index}" />
                            <Span Text=" " />
                            <Span Text="{Binding Agreement.Title}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label 
                    Margin="0,8,0,0"
                    Text="Descripción"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold" />
                <Label
                    VerticalOptions="FillAndExpand"
                    LineBreakMode="TailTruncation"
                    MaxLines="2"
                    Text="{Binding Description, TargetNullValue='---'}" />
            </StackLayout>
        </Grid>
    </Frame>
</ContentView>
