<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:DetailBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Leasing.Interop.API.Common"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    x:Class="MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Pages.Detail.PropertyLeasePersonPostulationDetailPage"
    x:TypeArguments="interop_common_display_models:PropertyLeasePersonPostulationDisplayModel"
    x:DataType="interop_common_display_models:PropertyLeasePersonPostulationDisplayModel"
    Title="Detalles de Postulación a Oferta de Arrendamiento de Inmueble"
    BackgroundColor="Transparent"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid
                Padding="10"
                MaximumWidthRequest="400"
                VerticalOptions="Center">
                <Frame Style="{StaticResource PopupFrameStyle}">
                    <StackLayout Margin="20">
                        <Label 
                            Margin="0,0,0,20"
                            Text="Detalles"
                            FontAttributes="Bold"
                            FontSize="Medium" />
                        <Label
                            Style="{StaticResource CaptionPropertyLabelStyle}"
                            Margin="0"
                            Text="Contacto" />
                        <Label
                            Style="{StaticResource ValuePropertyLabelStyle}"
                            Text="{Binding Contact}" />
                        <Label 
                            Style="{StaticResource CaptionPropertyLabelStyle}"
                            Text="Argumento" />
                        <Label
                            Style="{StaticResource ValuePropertyLabelStyle}"
                            Text="{Binding Argument, TargetNullValue='---'}" />
                    </StackLayout>
                </Frame>
                <Button
                    HorizontalOptions="End" VerticalOptions="Start"
                    Text="&#xf5ad;"
                    FontSize="Medium"
                    FontFamily="MaterialDesignIcons"
                    BorderWidth="0"
                    WidthRequest="48" HeightRequest="48"
                    Clicked="DismissControl_Invoked" />
            </Grid>
        </Grid>
    </ScrollView>
</core_ui_base_pages:DetailBaseContentPage>