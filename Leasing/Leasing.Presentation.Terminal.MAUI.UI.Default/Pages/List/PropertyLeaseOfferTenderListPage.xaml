<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ListBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_card_views="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:local_detail_pages="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Pages.Detail"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:presentation_list_page_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.Models.Page.List;assembly=MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Leasing.Interop.API.Common"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Pages.List.PropertyLeaseOfferTenderListPage"
    x:TypeArguments="interop_common_display_models:PropertyLeaseOfferDisplayModel,presentation_list_page_models:PropertyLeaseOfferTenderListPageModel,local_detail_pages:PropertyLeaseOfferDetailPage"
    x:DataType="presentation_list_page_models:PropertyLeaseOfferTenderListPageModel"
    Title="Licitaciones de Arrendamiento de Inmuebles">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />

            <communitytoolkit_converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <communitytoolkit_converters:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="ReloadToolbarItems_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF450;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <StackLayout Orientation="Vertical">
                <SearchBar Margin="20,20,20,0" />
                <Grid 
                    VerticalOptions="FillAndExpand"
                    SizeChanged="ItemsCollectionViewLayout_SizeChanged">
                    <CollectionView
                        x:Name="ItemsCollectionView"
                        Margin="20"
                        ItemSizingStrategy="MeasureAllItems"
                        ItemsSource="{Binding Items}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="interop_common_display_models:PropertyLeaseOfferDisplayModel">
                                <Frame Margin="10" Padding="8">
                                    <VerticalStackLayout>
                                        <local_card_views:PropertyLeaseOfferDefaultCardView Margin="8">
                                            <ContentView.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="ItemTapGestureRecognizer_Tapped" />
                                            </ContentView.GestureRecognizers>
                                        </local_card_views:PropertyLeaseOfferDefaultCardView>
                                        <FlexLayout
                                            Wrap="Wrap"
                                            AlignItems="Start" AlignContent="Start">
                                            <VerticalStackLayout 
                                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=6, LargeContainerColumn=12}}"
                                                Margin="4"
                                                Spacing="6">
                                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Postulantes jurídicos" />
                                                <Frame Padding="8">
                                                    <Grid RowSpacing="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="2" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Button
                                                            Grid.Column="1" Grid.Row="0"
                                                            Margin="0,0,0,8"
                                                            Text="Agregar"
                                                            Clicked="OrganizationPostulationAgregationButton_Clicked" />
                                                        <BoxView
                                                            Grid.ColumnSpan="2" Grid.Row="1"
                                                            Color="{StaticResource Gray050}" />
                                                        <VerticalStackLayout
                                                            Grid.ColumnSpan="2" Grid.Row="2"
                                                            BindableLayout.ItemsSource="{Binding OrganizationPostulations}">
                                                            <BindableLayout.EmptyView>
                                                                <Label 
                                                                    Margin="0,8,0,0"
                                                                    Text="Sin elementos que mostrar" 
                                                                    FontAttributes="Italic" 
                                                                    TextColor="DimGray" />
                                                            </BindableLayout.EmptyView>
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="interop_common_display_models:PropertyLeaseOrganizationPostulationDisplayModel">
                                                                    <Frame 
                                                                        Margin="0,8,0,0"
                                                                        Padding="8"
                                                                        HeightRequest="156">
                                                                        <Frame.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="OganizationPostulationViewLayoutTapGestureRecognizer_Tapped" />
                                                                        </Frame.GestureRecognizers>
                                                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                                                                            <Frame 
                                                                                Grid.Column="0" Grid.RowSpan="3"
                                                                                VerticalOptions="Start"
                                                                                Padding="0">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Image
                                                                                        Grid.Column="0" Grid.RowSpan="3"
                                                                                        Aspect="AspectFill"
                                                                                        WidthRequest="136" HeightRequest="136"
                                                                                        Source="{Binding Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
                                                                                    <StackLayout 
                                                                                        Grid.Column="1"
                                                                                        Padding="10">
                                                                                        <Label 
                                                                                            FontSize="Medium"
                                                                                            LineBreakMode="TailTruncation"
                                                                                            ToolTipProperties.Text="{Binding Contact.Identity.Name}"
                                                                                            Text="{Binding Contact.Identity.Name}" />
                                                                                        <Label 
                                                                                            Margin="0,2,0,0"
                                                                                            FontAttributes="Bold"
                                                                                            LineBreakMode="TailTruncation"
                                                                                            ToolTipProperties.Text="{Binding Contact.BusinessKind.Name}"
                                                                                            Text="{Binding Contact.BusinessKind.Name}" />
                                                                                        <Label 
                                                                                            Margin="0,8,0,0"
                                                                                            Text="Argumento"
                                                                                            TextColor="DimGray"
                                                                                            FontSize="Caption"
                                                                                            FontAttributes="Bold" />
                                                                                        <Label
                                                                                            VerticalOptions="FillAndExpand"
                                                                                            LineBreakMode="TailTruncation"
                                                                                            MaxLines="2"
                                                                                            ToolTipProperties.Text="{Binding Argument}"
                                                                                            Text="{Binding Argument, TargetNullValue='---'}" />
                                                                                    </StackLayout>
                                                                                </Grid>
                                                                            </Frame>
                                                                            <Button
                                                                                Grid.Column="1" Grid.Row="0"
                                                                                FontFamily="MaterialDesignIcons" 
                                                                                Text="&#xF90B;"
                                                                                Clicked="OrganizationPostulationEditionButton_Clicked" />
                                                                            <Button
                                                                                Grid.Column="1" Grid.Row="1"
                                                                                FontFamily="MaterialDesignIcons" 
                                                                                Text="&#xFA78;"
                                                                                Clicked="OrganizationPostulationRemotionButton_Clicked" />
                                                                        </Grid>
                                                                    </Frame>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Frame>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout 
                                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=6, LargeContainerColumn=12}}"
                                                Margin="4"
                                                Spacing="6">
                                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Postulantes naturales" />
                                                <Frame Padding="8">
                                                    <Grid RowSpacing="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="2" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Button
                                                            Grid.Column="1" Grid.Row="0"
                                                            Margin="0,0,0,8"
                                                            Text="Agregar"
                                                            Clicked="PersonPostulationAgregationButton_Clicked" />
                                                        <BoxView
                                                            Grid.ColumnSpan="2" Grid.Row="1"
                                                            Color="{StaticResource Gray050}" />
                                                        <VerticalStackLayout
                                                            Grid.ColumnSpan="2" Grid.Row="2"
                                                            BindableLayout.ItemsSource="{Binding PersonPostulations}">
                                                            <BindableLayout.EmptyView>
                                                                <Label 
                                                                    Margin="0,8,0,0"
                                                                    Text="Sin elementos que mostrar" 
                                                                    FontAttributes="Italic" 
                                                                    TextColor="DimGray" />
                                                            </BindableLayout.EmptyView>
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="interop_common_display_models:PropertyLeasePersonPostulationDisplayModel">
                                                                    <Frame 
                                                                        Margin="0,8,0,0"
                                                                        Padding="8"
                                                                        HeightRequest="156">
                                                                        <Frame.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="PersonPostulationViewLayoutTapGestureRecognizer_Tapped" />
                                                                        </Frame.GestureRecognizers>
                                                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                                                                            <Frame 
                                                                                Grid.Column="0" Grid.RowSpan="3"
                                                                                VerticalOptions="Start"
                                                                                Padding="0">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Image
                                                                                        Grid.Column="0" Grid.RowSpan="3"
                                                                                        Aspect="AspectFill"
                                                                                        WidthRequest="136" HeightRequest="136"
                                                                                        Source="{Binding Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
                                                                                    <StackLayout 
                                                                                        Grid.Column="1"
                                                                                        Padding="10">
                                                                                        <Label 
                                                                                            FontSize="Medium"
                                                                                            LineBreakMode="TailTruncation"
                                                                                            ToolTipProperties.Text="{Binding Contact}">
                                                                                            <Label.FormattedText>
                                                                                                <FormattedString>
                                                                                                    <Span Text="{Binding Contact.Identity.Name}" />
                                                                                                    <Span Text=" " />
                                                                                                    <Span Text="{Binding Contact.Identity.LastName}" />
                                                                                                </FormattedString>
                                                                                            </Label.FormattedText>
                                                                                        </Label>
                                                                                        <Label 
                                                                                            FontAttributes="Bold"
                                                                                            LineBreakMode="TailTruncation"
                                                                                            ToolTipProperties.Text="{Binding BusinessKind.Name}"
                                                                                            Text="{Binding BusinessKind.Name}" />
                                                                                        <Label 
                                                                                            Margin="0,8,0,0"
                                                                                            Text="Argumento"
                                                                                            TextColor="DimGray"
                                                                                            FontSize="Caption"
                                                                                            FontAttributes="Bold" />
                                                                                        <Label
                                                                                            VerticalOptions="FillAndExpand"
                                                                                            LineBreakMode="TailTruncation"
                                                                                            MaxLines="2"
                                                                                            ToolTipProperties.Text="{Binding Argument}"
                                                                                            Text="{Binding Argument, TargetNullValue='---'}" />
                                                                                    </StackLayout>
                                                                                </Grid>
                                                                            </Frame>
                                                                            <Button
                                                                                Grid.Column="1" Grid.Row="0"
                                                                                FontFamily="MaterialDesignIcons" 
                                                                                Text="&#xF90B;"
                                                                                Clicked="PersonPostulationEditionButton_Clicked" />
                                                                            <Button
                                                                                Grid.Column="1" Grid.Row="1"
                                                                                FontFamily="MaterialDesignIcons" 
                                                                                Text="&#xFA78;"
                                                                                Clicked="PersonPostulationRemotionButton_Clicked" />
                                                                        </Grid>
                                                                    </Frame>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Frame>
                                            </VerticalStackLayout>
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label
                                IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                HorizontalTextAlignment="Center"
                                Margin="5"
                                Text="Sin elementos que mostrar"
                                TextColor="{AppThemeBinding Light=DimGray, Dark=Gray}"
                                FontAttributes="Italic" />
                        </CollectionView.EmptyView>
                        <CollectionView.Footer>
                            <StackLayout IsVisible="{Binding HasMoreItems}">
                                <Button
                                HorizontalOptions="Center"
                                Margin="5"
                                Text="Mostrar más"
                                Clicked="LoadMoreBurron_Clicked" />
                            </StackLayout>
                        </CollectionView.Footer>
                    </CollectionView>
                </Grid>
            </StackLayout>
            <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
        </Grid>
    </ContentPage.Content>
</core_ui_base_pages:ListBaseContentPage>