<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_converters="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Converters"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI"
    xmlns:domain_presentation_card_views="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_behaviors="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Behaviors;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Leasing.Interop.API.Common"    
    xmlns:domain_interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    xmlns:core_interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Core.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Core.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    xmlns:ffimageloading_views="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:Class="MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.LegalClientVehicleLeasingConfigurationPage"
    x:TypeArguments="interop_common_display_models:LegalClientVehicleLeasingDisplayModel,interop_common_display_models:LegalClientVehicleLeasingDisplayModel,presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <local_converters:DriveLicenceVehicleKindBridgesToStringConverter x:Key="DriveLicenceVehicleKindBridgesToStringConverter" />

            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyErrorMessageConverter x:Key="ValidationResultToTargetPropertyErrorMessageConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyHasErrorConverter x:Key="ValidationResultToTargetPropertyHasErrorConverter" />
            <core_ui_converters:StringToSubstringConverter x:Key="StringToSubstringConverter" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            
            <Array Type="{x:Type x:Int32}" x:Key="CIBornYearSubstringParameter">
                <x:Int32>4</x:Int32>
                <x:Int32>2</x:Int32>
            </Array>
            <Array Type="{x:Type x:Int32}" x:Key="CIBornMonthSubstringParameter">
                <x:Int32>2</x:Int32>
                <x:Int32>2</x:Int32>
            </Array>
            <Array Type="{x:Type x:Int32}" x:Key="CIBornDaySubstringParameter">
                <x:Int32>0</x:Int32>
                <x:Int32>2</x:Int32>
            </Array>
            <Array Type="{x:Type x:Int32}" x:Key="CITailSubstringParameter">
                <x:Int32>6</x:Int32>
                <x:Int32>5</x:Int32>
            </Array>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="0" Padding="8">
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Postulación" />
                        <Frame 
                            Padding="0"
                            HeightRequest="152">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ffimageloading_views:CachedImage
                                    Grid.Column="0" Grid.RowSpan="3"
                                    Aspect="AspectFill"
                                    WidthRequest="152" HeightRequest="152"
                                    Source="{Binding Postulation.Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
                                <BoxView Grid.Column="1" Color="{AppThemeBinding Light=LightGray, Dark=DimGray}" />
                                <StackLayout 
                                    Grid.Column="2"
                                    Padding="10">
                                    <Label 
                                        FontSize="Medium"
                                        LineBreakMode="TailTruncation"
                                        ToolTipProperties.Text="{Binding Postulation.Contact.Identity.Name}"
                                        Text="{Binding Postulation.Contact.Identity.Name}" />
                                    <Label 
                                        Margin="0,2,0,0"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        ToolTipProperties.Text="{Binding Postulation.Contact.BusinessKind.Name}"
                                        Text="{Binding Postulation.Contact.BusinessKind.Name}" />
                                    <Label 
                                        Margin="0,8,0,0"
                                        Text="Argumento"
                                        TextColor="DimGray"
                                        FontAttributes="Bold" />
                                    <Label
                                        VerticalOptions="FillAndExpand"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        ToolTipProperties.Text="{Binding Postulation.Argument}"
                                        Text="{Binding Postulation.Argument, TargetNullValue='---'}" />
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Acuerdo C/D" />
                        <Frame 
                            IsVisible="{Binding Agreement, Converter={StaticResource IsNotNullConverter}}"
                            Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Column="0" Grid.Row="0"
                                    Text="No." />
                                <Label
                                    Grid.Column="1" Grid.RowSpan="2"
                                    Margin="0,0,4,0"
                                    FontSize="Large"
                                    Text="{Binding Agreement.Index}" />
                                <Label
                                    Grid.Column="2" Grid.ColumnSpan="4"
                                    FontAttributes="Bold"
                                    Text="{Binding Agreement.Title}" />
                                <Label
                                    Grid.Column="2" Grid.Row="1"
                                    Style="{StaticResource CaptionFieldLabelStyle}"
                                    Margin="0"
                                    Text="Grupo Decisor:" />
                                <Label
                                    Grid.Column="3" Grid.Row="1"
                                    Margin="4,0,8,0"
                                    Text="{Binding Agreement.Meeting.DecisionMakingGroup.CanonicalName}" />
                                <Label
                                    Grid.Column="4" Grid.Row="1"
                                    Style="{StaticResource CaptionFieldLabelStyle}"
                                    Margin="0"
                                    Text="Reunión:" />
                                <Label
                                    Grid.Column="5" Grid.Row="1"
                                    Margin="4,0"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Agreement.Meeting.At}" />
                                <Label
                                    Grid.ColumnSpan="6" Grid.Row="2"
                                    Text="{Binding Agreement.Description, TargetNullValue='---'}" />
                            </Grid>
                        </Frame>
                        <Button
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="AgreementPickButton_Clicked" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.AgreementValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.AgreementValidableProperty}}"
                            TextColor="IndianRed" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Centro de Costo" />
                        <Picker 
                            x:Name="CostCenterPicker"
                            ItemsSource="{Binding AvailableConstCenters}"
                            ItemDisplayBinding="{Binding Path=Name}"
                            SelectedItem="{Binding CostCenter}"
                            SelectedIndexChanged="Picker_SelectedIndexChanged" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.CostCenterValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.CostCenterValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="No. Licencia Operativa" />
                        <Entry Text="{Binding OperativeLicenceCode}" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.OperativeLicenceCodeValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.OperativeLicenceCodeValidableProperty}}"
                            TextColor="IndianRed" />
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Conductores" />
                    <Frame Padding="4">
                        <Grid RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                Margin="8"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="DriveLicenceCreationButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="{StaticResource Gray050}" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                Margin="4"
                                ItemsSource="{Binding DriveLicences}">
                                <CollectionView.EmptyView>
                                    <Label Padding="4" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="1" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.Behaviors>
                                    <core_ui_behaviors:AdaptableGridItemLayoutCollectionViewBehavior ItemWidth="480" ItemSpacing="8" />
                                </CollectionView.Behaviors>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="interop_common_display_models:DriveLicenceDisplayModel">
                                        <Frame Padding="8">
                                            <VerticalStackLayout Spacing="0">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="7*" />
                                                        <ColumnDefinition Width="5*" />
                                                        <ColumnDefinition Width="3*" />
                                                        <ColumnDefinition Width="3*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="18" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <ffimageloading_views:CachedImage 
                                                        Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="4"
                                                        Margin="0,0,0,8"
                                                        VerticalOptions="Start"
                                                        BackgroundColor="DimGray"
                                                        HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                                                        Aspect="AspectFill"
                                                        Source="{Binding Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_person_picture.jpg'}" />
                                                    <Label
                                                        Grid.Column="3" Grid.ColumnSpan="4" Grid.Row="0"
                                                        FontAttributes="Bold"
                                                        TextColor="DimGray"
                                                        Text="NUMERO" />
                                                    <VerticalStackLayout Grid.Column="3" Grid.ColumnSpan="4" Grid.Row="1">
                                                        <Label
                                                            FontSize="Medium"
                                                            LineBreakMode="TailTruncation"
                                                            TextTransform="Uppercase"
                                                            Text="{Binding VehicleKindBridges, Converter={StaticResource DriveLicenceVehicleKindBridgesToStringConverter}}" />
                                                        <Label
                                                            FontSize="Medium"
                                                            LineBreakMode="TailTruncation"
                                                            TextTransform="Uppercase"
                                                            Text="{Binding Code}" />
                                                    </VerticalStackLayout>
                                                    <Label
                                                        Grid.Column="3" Grid.ColumnSpan="4" Grid.Row="2"
                                                        FontAttributes="Bold"
                                                        TextColor="DimGray"
                                                        Text="NOMBRE Y APELLIDOS" />
                                                    <VerticalStackLayout
                                                        Grid.Column="3" Grid.ColumnSpan="4" Grid.Row="3">
                                                        <Label
                                                            FontSize="Medium"
                                                            LineBreakMode="TailTruncation"
                                                            TextTransform="Uppercase"
                                                            Text="{Binding Contact.Identity.Name}" />
                                                        <Label
                                                            FontSize="Medium"
                                                            LineBreakMode="TailTruncation"
                                                            TextTransform="Uppercase"
                                                            Text="{Binding Contact.Identity.LastName}" />
                                                    </VerticalStackLayout>
                                                    <Label
                                                        Grid.Column="0" Grid.ColumnSpan="7" Grid.Row="4"
                                                        FontAttributes="Bold"
                                                        TextColor="DimGray"
                                                        Text="LIMITANTES" />
                                                    <Label
                                                        Grid.Column="0" Grid.ColumnSpan="7" Grid.Row="5"
                                                        Margin="0,0,0,8"
                                                        LineBreakMode="TailTruncation"
                                                        TextTransform="Uppercase"
                                                        Text="Ninguna" />
                                                    <Label
                                                        Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="6"
                                                        HorizontalOptions="Center"
                                                        FontAttributes="Bold"
                                                        FontSize="Caption"
                                                        LineBreakMode="TailTruncation"
                                                        TextColor="DimGray"
                                                        Text="FECHA DE NACIMIENTO" />
                                                    <Label
                                                        Grid.Column="0" Grid.Row="7"
                                                        HorizontalOptions="Center"
                                                        Text="{Binding Contact.PersonalIdentificationNumber, Converter={StaticResource StringToSubstringConverter}, ConverterParameter={StaticResource CIBornYearSubstringParameter}}" />
                                                    <Label
                                                        Grid.Column="0" Grid.Row="8"
                                                        HorizontalOptions="Center"
                                                        FontAttributes="Bold"
                                                        FontSize="Caption"
                                                        TextColor="DimGray"
                                                        Text="AÑO" />
                                                    <Label
                                                        Grid.Column="1" Grid.Row="7"
                                                        HorizontalOptions="Center"
                                                        Text="{Binding Contact.PersonalIdentificationNumber, Converter={StaticResource StringToSubstringConverter}, ConverterParameter={StaticResource CIBornMonthSubstringParameter}}" />
                                                    <Label
                                                        Grid.Column="1" Grid.Row="8"
                                                        HorizontalOptions="Center"
                                                        FontAttributes="Bold"
                                                        FontSize="Caption"
                                                        TextColor="DimGray"
                                                        Text="MES" />
                                                    <Label
                                                        Grid.Column="2" Grid.Row="7"
                                                        HorizontalOptions="Center"
                                                        Text="{Binding Contact.PersonalIdentificationNumber, Converter={StaticResource StringToSubstringConverter}, ConverterParameter={StaticResource CIBornDaySubstringParameter}}" />
                                                    <Label
                                                        Grid.Column="2" Grid.Row="8"
                                                        HorizontalOptions="Center"
                                                        FontAttributes="Bold"
                                                        FontSize="Caption"
                                                        TextColor="DimGray"
                                                        Text="DIA" />
                                                    <Label
                                                        Grid.Column="3" Grid.Row="7"
                                                        HorizontalOptions="Center"
                                                        Text="{Binding Contact.PersonalIdentificationNumber, Converter={StaticResource StringToSubstringConverter}, ConverterParameter={StaticResource CITailSubstringParameter}}" />
                                                    <Label
                                                        Grid.Column="4" Grid.Row="6"
                                                        FontAttributes="Bold"
                                                        FontSize="Caption"
                                                        LineBreakMode="TailTruncation"
                                                        TextColor="DimGray"
                                                        Text="EXPEDIDA" />
                                                    <Label
                                                        Grid.Column="4" Grid.Row="7"
                                                        Text="{Binding ReleasedAt.Year}" />
                                                    <Label
                                                        Grid.Column="4" Grid.Row="8"
                                                        FontAttributes="Bold"
                                                        FontSize="Caption"
                                                        TextColor="DimGray"
                                                        Text="AÑO" />
                                                    <Label
                                                        Grid.Column="5" Grid.ColumnSpan="2" Grid.Row="6"
                                                        FontAttributes="Bold"
                                                        FontSize="Caption"
                                                        LineBreakMode="TailTruncation"
                                                        TextColor="DimGray"
                                                        Text="VENCIMIENTO" />
                                                    <Label
                                                        Grid.Column="5" Grid.Row="7"
                                                        Text="{Binding ExpireAt.Month}" />
                                                    <Label
                                                        Grid.Column="5" Grid.Row="8"
                                                        FontAttributes="Bold"
                                                        FontSize="Caption"
                                                        TextColor="DimGray"
                                                        Text="MES" />
                                                    <Label
                                                        Grid.Column="6" Grid.Row="7"
                                                        Text="{Binding ExpireAt.Year}" />
                                                    <Label
                                                        Grid.Column="6" Grid.Row="8"
                                                        FontAttributes="Bold"
                                                        FontSize="Caption"
                                                        TextColor="DimGray"
                                                        Text="AÑO" />
                                                    <VerticalStackLayout 
                                                        Grid.Column="7" Grid.RowSpan="4"
                                                        Spacing="8">
                                                        <Button
                                                            Style="{StaticResource FontIconImageButtonStyle}"
                                                            Text="&#xF90B;"
                                                            Clicked="DriveLicenceEditionButton_Clicked" />
                                                        <Button
                                                            Style="{StaticResource DangerKindFontIconImageButtonStyle}"
                                                            Text="&#xFA78;"
                                                            Clicked="DriveLicenceRemotionButton_Clicked" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.DriveLicencesValidableProperty}}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.DriveLicencesValidableProperty}}"
                        TextColor="IndianRed" />
                </VerticalStackLayout>
                <Grid
                    Margin="8,16,8,8"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <BoxView 
                        Grid.Column="0"
                        VerticalOptions="Center"
                        HeightRequest="2" 
                        Color="DimGray" />
                    <Label
                        Grid.Column="1"
                        FontSize="Medium"
                        TextColor="DimGray"
                        Text="Información relativa a la contratación" />
                    <BoxView 
                        Grid.Column="2"
                        VerticalOptions="Center"
                        HeightRequest="2" 
                        Color="DimGray" />
                </Grid>
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=2, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Fecha de Inicio" />
                        <DatePicker Date="{Binding StartAt}" />
                    </VerticalStackLayout>
                    <Grid
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=2, SmallContainerColumn=12}}"
                        Margin="4"
                        ColumnSpacing="6" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Row="0"
                            Style="{StaticResource CaptionFieldLabelStyle}" Text="Número" />
                        <Entry
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            IsReadOnly="True"
                            Text="{Binding Index}" />
                        <Stepper
                            Grid.Row="1"
                            Margin="0,0,6,0"
                            HorizontalOptions="End" VerticalOptions="Center"
                            Minimum="1"
                            Value="{Binding Index}" />
                    </Grid>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Duración (U/M)" />
                        <Picker 
                            ItemsSource="{Binding AvailableDurationUnitMeasureKinds}"
                            SelectedItem="{Binding DurationUnitMeasureKind, Converter={StaticResource StringToLocalizedStringConverter}}"
                            SelectedIndexChanged="Picker_SelectedIndexChanged" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.DurationUnitMeasureKindValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.DurationUnitMeasureKindValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                    <Grid
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=12}}"
                        Margin="4"
                        ColumnSpacing="6" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Row="0"
                            Style="{StaticResource CaptionFieldLabelStyle}" Text="Duración (Ordinal)" />
                        <Entry
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            IsReadOnly="True"
                            Text="{Binding DurationUnitCount}" />
                        <Stepper
                            Grid.Row="1"
                            Margin="0,0,6,0"
                            HorizontalOptions="End" VerticalOptions="Center"
                            Minimum="1"
                            Value="{Binding DurationUnitCount}" />
                    </Grid>
                </FlexLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Objeto" />
                    <Editor Text="{Binding Objective}" HeightRequest="120" />
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.ObjectiveValidableProperty}}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.ObjectiveValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}" />
                </VerticalStackLayout>
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Valor del Arrendamiento" />
                        <Entry Text="{Binding Feed, StringFormat='{0:F2}'}" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.FeedValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.FeedValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Término de Pago" />
                        <Picker 
                            x:Name="PaymentTermPicker"
                            ItemsSource="{Binding AvailablePaymentTerms}"
                            ItemDisplayBinding="{Binding Path=Name}"
                            SelectedItem="{Binding PaymentTerm}"
                            SelectedIndexChanged="Picker_SelectedIndexChanged" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.PaymentTermValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:LegalClientVehicleLeasingConfigurationPageModel.PaymentTermValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <BoxView 
                    Margin="8,20,8,8"
                    HeightRequest="2" 
                    Color="DimGray" />
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <Grid
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        ColumnSpacing="6" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Row="0"
                            Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                        <Entry
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            IsReadOnly="True"
                            Text="{Binding Priority}" />
                        <Stepper
                            Grid.Row="1"
                            Margin="0,0,6,0"
                            HorizontalOptions="End" VerticalOptions="Center"
                            Minimum="1"
                            Maximum="100"
                            Value="{Binding Priority}" />
                    </Grid>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_ui_base_pages:ConfigurationBaseContentPage>