<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Leasing.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.PropertyLeaseOfferConfigurationPage"
    x:TypeArguments="interop_common_display_models:PropertyLeaseOfferDisplayModel,interop_common_display_models:PropertyLeaseOfferDisplayModel,presentation_configuration_page_models:PropertyLeaseOfferConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:PropertyLeaseOfferConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyErrorMessageConverter x:Key="ValidationResultToTargetPropertyErrorMessageConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyHasErrorConverter x:Key="ValidationResultToTargetPropertyHasErrorConverter" />

            <caneyframework_presentation_converters:ViewChildParentWidthToRelativeWidthConverter x:Key="ViewChildParentWidthToRelativeWidthConverter" ReferenceWidth="480" AbsoluteHorizontalSeparation="16" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="0" Padding="8">
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=8, LargeContainerColumn=9, MediumContainerColumn=10, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Propuesta" />
                        <Frame
                            IsVisible="{Binding Propousal, Converter={StaticResource IsNotNullConverter}}">
                            <VerticalStackLayout Spacing="4">
                                <Label 
                                    Style="{StaticResource CaptionFieldLabelStyle}" Text="Inmueble"
                                    Margin="0" />
                                <Frame Padding="0">
                                    <Grid ColumnSpacing="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            Aspect="AspectFill"               
                                            Source="{Binding Propousal.Property.FeatureImage, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
                                        <StackLayout 
                                            Grid.Column="1"
                                            Padding="16">
                                            <Label 
                                                FontAttributes="Bold"
                                                FontSize="Medium"
                                                Text="{Binding Propousal.Property.Name}" />
                                            <Label 
                                                Margin="0,8,0,0"
                                                Text="Acuerdo C/D primario"
                                                TextColor="DimGray"
                                                FontSize="Caption"
                                                FontAttributes="Bold" />
                                            <Label
                                                LineBreakMode="TailTruncation">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="No." />
                                                        <Span Text="{Binding Propousal.Agreement.Index}" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding Propousal.Agreement.Title}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label 
                                                Margin="0,8,0,0"
                                                Text="Argumento"
                                                TextColor="DimGray"
                                                FontSize="Caption"
                                                FontAttributes="Bold" />
                                            <Label
                                                VerticalOptions="FillAndExpand"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="2"
                                                Text="{Binding Propousal.Description, TargetNullValue='---'}" />
                                        </StackLayout>
                                    </Grid>
                                </Frame>
                                <Label 
                                    Style="{StaticResource CaptionFieldLabelStyle}" Text="Espacios específicos"
                                    Margin="0,4,0,0" />
                                <BoxView 
                                    Margin="0,0,0,8"
                                    HeightRequest="2" 
                                    Color="{StaticResource Gray050}" />
                                <FlexLayout
                                    Margin="4"
                                    Wrap="Wrap"
                                    AlignItems="Start" AlignContent="Start"
                                    BindableLayout.ItemsSource="{Binding Propousal.SpacePropousals}">
                                    <BindableLayout.EmptyView>
                                        <Label Text="Sin elementos que mostrar (propuesta incluye todos los espacios)" FontAttributes="Italic" TextColor="DimGray" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="interop_common_display_models:PropertySpaceLeasePropousalDisplayModel">
                                            <Frame
                                                Padding="0" Margin="4"
                                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource ViewChildParentWidthToRelativeWidthConverter}}"
                                                HeightRequest="196">
                                                <Grid ColumnSpacing="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="3*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Grid.Column="0"
                                                        Aspect="AspectFill"               
                                                        Source="{Binding Space.FeatureImage, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
                                                    <StackLayout 
                                                        Grid.Column="1"
                                                        Padding="8">
                                                        <Label 
                                                            FontAttributes="Bold"
                                                            FontSize="Medium"
                                                            LineBreakMode="TailTruncation"
                                                            MaxLines="2"
                                                            Text="{Binding Space.Name}" />
                                                        <Label 
                                                            Margin="0,8,0,0"
                                                            Text="Espacio útil"
                                                            TextColor="DimGray"
                                                            FontSize="Caption"
                                                            FontAttributes="Bold" />
                                                        <Label
                                                            LineBreakMode="TailTruncation"
                                                            Text="{Binding Space.Area, StringFormat='{0:F2} m²'}" />
                                                        <Label 
                                                            Margin="0,8,0,0"
                                                            Text="Descripción"
                                                            TextColor="DimGray"
                                                            FontSize="Caption"
                                                            FontAttributes="Bold" />
                                                        <Label
                                                            VerticalOptions="FillAndExpand"
                                                            LineBreakMode="TailTruncation"
                                                            MaxLines="4"
                                                            Text="{Binding Space.Description, TargetNullValue='---'}" />
                                                    </StackLayout>
                                                </Grid>
                                            </Frame>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Frame>
                        <Button
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="PropousalPickButton_Clicked" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:PropertyLeaseOfferConfigurationPageModel.PropousalValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:PropertyLeaseOfferConfigurationPageModel.PropousalValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, LargeContainerColumn=3, MediumContainerColumn=6}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Fecha de inicio" />
                        <DatePicker Date="{Binding OpenAt}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=8, LargeContainerColumn=9, MediumContainerColumn=10, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Acuerdo C/D superior" />
                        <Frame 
                            IsVisible="{Binding Agreement, Converter={StaticResource IsNotNullConverter}}"
                            Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Column="0" Grid.Row="0"
                                    Text="No." />
                                <Label
                                    Grid.Column="1" Grid.RowSpan="2"
                                    Margin="0,0,4,0"
                                    FontSize="Large"
                                    Text="{Binding Agreement.Index}" />
                                <Label
                                    Grid.Column="2" Grid.ColumnSpan="4"
                                    FontAttributes="Bold"
                                    Text="{Binding Agreement.Title}" />
                                <Label
                                    Grid.Column="2" Grid.Row="1"
                                    Style="{StaticResource CaptionFieldLabelStyle}"
                                    Margin="0"
                                    Text="Grupo Decisor:" />
                                <Label
                                    Grid.Column="3" Grid.Row="1"
                                    Margin="4,0,8,0"
                                    Text="{Binding Agreement.Meeting.DecisionMakingGroup.CanonicalName}" />
                                <Label
                                    Grid.Column="4" Grid.Row="1"
                                    Style="{StaticResource CaptionFieldLabelStyle}"
                                    Margin="0"
                                    Text="Reunión:" />
                                <Label
                                    Grid.Column="5" Grid.Row="1"
                                    Margin="4,0"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Agreement.Meeting.At}" />
                                <Label
                                    Grid.ColumnSpan="6" Grid.Row="2"
                                    Text="{Binding Agreement.Description, TargetNullValue='---'}" />
                            </Grid>
                        </Frame>
                        <Button
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="AgreementPickButton_Clicked" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:PropertyLeaseOfferConfigurationPageModel.AgreementValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:PropertyLeaseOfferConfigurationPageModel.AgreementValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, LargeContainerColumn=3, MediumContainerColumn=6}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Fecha límite (opcional)" />
                        <StackLayout Orientation="Horizontal">
                            <Switch IsToggled="{Binding HasClosetAtDate}" />
                            <DatePicker 
                                IsVisible="{Binding HasClosetAtDate}"
                                Date="{Binding ClosedAt}" />
                        </StackLayout>
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descrición" />
                    <Editor Text="{Binding Description}" HeightRequest="320" />
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:PropertyLeaseOfferConfigurationPageModel.DescriptionValidableProperty}}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:PropertyLeaseOfferConfigurationPageModel.DescriptionValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}" />
                </VerticalStackLayout>
                <BoxView 
                    Margin="8,16,8,8"
                    HeightRequest="1" 
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray100}}" />
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <Grid
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        ColumnSpacing="6" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Row="0"
                            Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                        <Entry
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            IsReadOnly="True"
                            Text="{Binding Priority}" />
                        <Stepper
                            Grid.Row="1"
                            Margin="0,0,6,0"
                            HorizontalOptions="End" VerticalOptions="Center"
                            Minimum="1"
                            Maximum="100"
                            Value="{Binding Priority}" />
                    </Grid>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_ui_base_pages:ConfigurationBaseContentPage>