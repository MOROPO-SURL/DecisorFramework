<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI"
    xmlns:domain_presentation_card_views="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:interop_common_bridge_display_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Interop.API.Common.Models.Bridge.Display;assembly=MOROPO.Framework.Decisor.Leasing.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    x:Class="MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.DriveLicenceVehicleKindBridgeConfigurationPage"
    x:TypeArguments="interop_common_bridge_display_models:DriveLicenceVehicleKindBridgeDisplayModel,interop_common_bridge_display_models:DriveLicenceVehicleKindBridgeDisplayModel,presentation_configuration_page_models:DriveLicenceVehicleKindBridgeConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:DriveLicenceVehicleKindBridgeConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:ValidationResultToTargetPropertyErrorMessageConverter x:Key="ValidationResultToTargetPropertyErrorMessageConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyHasErrorConverter x:Key="ValidationResultToTargetPropertyHasErrorConverter" />
            <core_ui_converters:IntToMonthNameStringConverter x:Key="IntToMonthNameStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ScrollView Orientation="Vertical">
        <VerticalStackLayout Spacing="0" Padding="8">
            <FlexLayout 
                Wrap="Wrap"
                AlignItems="Start" AlignContent="Start">
                <VerticalStackLayout 
                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=1, ExtraLargeContainerColumn=2, LargeContainerColumn=3, SmallContainerColumn=4}}"
                    Margin="4"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Categoría" />
                    <Picker
                        ItemsSource="{Static presentation_configuration_page_models:DriveLicenceVehicleKindBridgeConfigurationPageModel.AVAILABLE_DRIVE_LICENCE_CATEGORIES}"
                        SelectedItem="{Binding Category}"                            
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:DriveLicenceVehicleKindBridgeConfigurationPageModel.CategoryValidableProperty}}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:DriveLicenceVehicleKindBridgeConfigurationPageModel.CategoryValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}" />
                </VerticalStackLayout>
                <VerticalStackLayout 
                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=3, LargeContainerColumn=4, SmallContainerColumn=8}}"
                    Margin="4"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tipo de vehículo" />
                    <Picker
                        x:Name="VehicleKindPicker"
                        ItemsSource="{Binding AvailableVehicleKinds}"
                        ItemDisplayBinding="{Binding Path=Name}"
                        SelectedItem="{Binding Stern}"                            
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:DriveLicenceVehicleKindBridgeConfigurationPageModel.SternValidableProperty}}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:DriveLicenceVehicleKindBridgeConfigurationPageModel.SternValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}" />
                </VerticalStackLayout>
                <VerticalStackLayout 
                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, ExtraLargeContainerColumn=3, LargeContainerColumn=5, SmallContainerColumn=12}}"
                    Margin="4"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Especificación (opcional)" />
                    <Entry Text="{Binding Specification}" />
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:DriveLicenceVehicleKindBridgeConfigurationPageModel.SpecificationValidableProperty}}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:DriveLicenceVehicleKindBridgeConfigurationPageModel.SpecificationValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}" />
                </VerticalStackLayout>
                <Grid 
                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=4, MediumContainerColumn=9, SmallContainerColumn=12}}"
                    Margin="4"
                    ColumnSpacing="6" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label 
                        Grid.ColumnSpan="2" Grid.Row="0"
                        Style="{StaticResource CaptionFieldLabelStyle}" 
                        Text="Registrado" />
                    <Picker
                        Grid.Column="1" Grid.Row="1"
                        ItemsSource="{Static presentation_configuration_page_models:DriveLicenceVehicleKindBridgeConfigurationPageModel.AVAILABLE_MONTHS}"
                        ItemDisplayBinding="{Binding Converter={StaticResource IntToMonthNameStringConverter}}"
                        SelectedItem="{Binding AchievedAtMonth}"
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                    <Picker
                        Grid.Column="0" Grid.Row="1"
                        ItemsSource="{Binding AvailableAchievedYears}"
                        SelectedItem="{Binding AchievedAtYear}"
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                </Grid>
            </FlexLayout>
        </VerticalStackLayout>
    </ScrollView>
</core_ui_base_pages:ConfigurationBaseContentPage>