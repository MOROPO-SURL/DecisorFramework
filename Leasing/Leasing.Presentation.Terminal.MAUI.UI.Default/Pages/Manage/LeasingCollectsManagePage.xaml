    x:Class="MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Pages.Manage.LeasingCollectsManagePage"
    x:TypeArguments="presentation_view_models:LeasingCollectViewModel,presentation_manage_page_models:LeasingCollectsManagePageModel"
    x:DataType="presentation_manage_page_models:LeasingCollectsManagePageModel"
    Title="Registros de Cobros de Arrendamiento">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="4" SingleSpacing="2" />
            
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <communitytoolkit_converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />

            <local_view_template_selectors:LeasingCollectTemplateSelector x:Key="LeasingCollectTemplateSelector">
                <local_view_template_selectors:LeasingCollectTemplateSelector.LegalClientPropertyLeasingCollectDataTemplate>
                    <DataTemplate x:DataType="presentation_view_models:LeasingCollectViewModel">
                        <ContentView BindingContext="{Binding InteropModel}">
                            <ContentView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ItemTapGestureRecognizer_Tapped" />
                            </ContentView.GestureRecognizers>
                            <Frame 
                                x:DataType="interop_common_display_models:LegalClientPropertyLeasingCollectDisplayModel"
                                BindingContext="{Binding InteropModel}">
                                <VerticalStackLayout Spacing="2" Padding="4">
                                    <FlexLayout
                                        Wrap="Wrap"
                                        AlignItems="Start" AlignContent="Start">
                                        <VerticalStackLayout 
                                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, MediumContainerColumn=6, SmallContainerColumn=12}}"
                                            Margin="2"
                                            Spacing="6">
                                            <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Fecha" />
                                            <Label Text="{Binding At, StringFormat='{0:dd/mmmm/yyy}'}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout 
                                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, MediumContainerColumn=6, SmallContainerColumn=12}}"
                                            Margin="2"
                                            Spacing="6">
                                            <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Monto" />
                                            <Label LineBreakMode="TailTruncation">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Amount, StringFormat='{0:F2}'}" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding Leasing.CostCenter.DefaultBankAccount.Currency.Symbol}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout 
                                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, MediumContainerColumn=6, SmallContainerColumn=12}}"
                                            Margin="2"
                                            Spacing="6">
                                            <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Centro de Costo" />
                                            <Label LineBreakMode="TailTruncation">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Leasing.CostCenter.Name}" />
                                                        <Span Text=", " />
                                                        <Span Text="{Binding Leasing.CostCenter.Structure.Identity.Name}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout 
                                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, MediumContainerColumn=6, SmallContainerColumn=12}}"
                                            Margin="2"
                                            Spacing="6">
                                            <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Cliente" />
                                            <Label
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding Leasing.Contract.Client.Contact.Identity.Name}" />
                                        </VerticalStackLayout>
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </ContentView>
                    </DataTemplate>
                </local_view_template_selectors:LeasingCollectTemplateSelector.LegalClientPropertyLeasingCollectDataTemplate>
