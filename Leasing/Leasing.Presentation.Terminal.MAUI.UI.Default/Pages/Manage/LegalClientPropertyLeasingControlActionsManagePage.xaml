<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ManageBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_constants="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Constants"
    xmlns:local_view_template_selectors="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Views.Template.Selector"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Leasing.Interop.API.Common"
    xmlns:presentation_manage_page_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.Models.Page.Manage;assembly=MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Pages.Manage.LegalClientPropertyLeasingControlActionsManagePage"
    x:TypeArguments="interop_common_display_models:LegalClientPropertyLeasingControlActionDisplayModel,presentation_manage_page_models:LegalClientPropertyLeasingControlActionsManagePageModel,presentation_configuration_page_models:LegalClientPropertyLeasingControlActionConfigurationPageModel"
    x:DataType="presentation_manage_page_models:LegalClientPropertyLeasingControlActionsManagePageModel"
    Title="Acciones de Control de Arrendamiento de Inmueble a Cliente Jurídico">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="4" SingleSpacing="2" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <communitytoolkit_converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Agregar"
            Clicked="AddItemToolbarItems_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf415;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="ReloadToolbarItems_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF450;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <Grid 
                VerticalOptions="FillAndExpand"
                SizeChanged="ItemsCollectionViewLayout_SizeChanged">
                <CollectionView
                    x:Name="ItemsCollectionView"
                    Margin="10"
                    ItemsSource="{Binding Items}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label
                            IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            HorizontalTextAlignment="Center"
                            Margin="5"
                            Text="Sin elementos que mostrar"
                            TextColor="{AppThemeBinding Light=DimGray, Dark=Gray}"
                            FontAttributes="Italic" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="interop_common_display_models:LegalClientPropertyLeasingControlActionDisplayModel">
                            <Frame HeightRequest="{Static local_constants:CardViewHeightConstants.LEASING_CONTROL_ACTION_CARD_VIEW_HEIGHT}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ItemTapGestureRecognizer_Tapped" />
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding At, StringFormat='{0:D}'}" LineBreakMode="TailTruncation" />
                                    <VerticalStackLayout>
                                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Cliente" />
                                        <Label
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Leasing.Contract.Client.Contact.Identity}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout>
                                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Grupo de Supervición" />
                                        <Label
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding SupervisionGroup.Name}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
        </Grid>
    </ContentPage.Content>
</core_ui_base_pages:ManageBaseContentPage>