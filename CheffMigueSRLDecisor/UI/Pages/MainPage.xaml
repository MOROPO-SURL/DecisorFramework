<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:BindingContextedContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:decisorframework_core_models_page="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models.Page;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    x:Class="MOROPO.CheffMigueSRL.Decisor.Terminal.UI.Pages.MainPage"
    x:TypeArguments="decisorframework_core_models_page:MainPageModel"
    x:DataType="decisorframework_core_models_page:MainPageModel"
    Title="Inicio">
    <ContentPage.Resources>
        <ResourceDictionary>
            <caneyframework_presentation_converters:ViewChildParentWidthToRelativeWidthConverter x:Key="ViewChildParentWidthToRelativeWidthConverter" ReferenceWidth="240" AbsoluteHorizontalSeparation="20" />
            <caneyframework_presentation_converters:DoubleToFractionConverter x:Key="DoubleToFractionConverter" />

            <Style x:Key="SectionCardFrameStyle" TargetType="Frame">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="WidthRequest" Value="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource ViewChildParentWidthToRelativeWidthConverter}}" />
                <Setter Property="HeightRequest" Value="180" />
            </Style>
            <Style x:Key="SectionCardBackgroudImageStyle" TargetType="Image">
                <Setter Property="Aspect" Value="AspectFill" />
            </Style>
            <Style x:Key="SectionCardOverlayBoxViewStyle" TargetType="BoxView">
                <Setter Property="Color" Value="#A7000000" />
            </Style>
            <Style x:Key="SectionCardNameLabelStyle" TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="Large" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <StackLayout>
        <BoxView
            HeightRequest="1"
            Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
        <Grid
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray050}, Dark={StaticResource Gray900}}"
            Padding="20"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                Grid.Column="0" Grid.RowSpan="3"
                WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}"
                StrokeThickness="4"
                StrokeLineJoin="Bevel">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,40,40,0" />
                </Border.StrokeShape>
                <Image
                    WidthRequest="120" HeightRequest="120"
                    Source="default_person_picture.jpg" />
            </Border>
            <Label
                Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0"
                LineBreakMode="TailTruncation" 
                Text="{Binding User.Id}"
                FontSize="Medium"
                FontAttributes="Bold" />
            <Label
                Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                LineBreakMode="TailTruncation"
                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                FontSize="Default">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding User.Identity.Name}" />
                        <Span Text=" " />
                        <Span Text="{Binding User.Identity.LastName}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Button
                Grid.Column="1" Grid.Row="2"
                Margin="0, 10"
                Text="Perfil de Usuario" />
            <Button
                Grid.Column="2" Grid.Row="2"
                Margin="0, 10"
                HorizontalOptions="Start"
                Text="Cerrar Sesión" />
            <VerticalStackLayout
                Grid.Column="3" Grid.RowSpan="3"
                MinimumWidthRequest="124"
                VerticalOptions="Center"
                Padding="20" Spacing="4">
                <Label
                    HorizontalOptions="Center"
                    Text="&#xF09E;"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Black}}"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Header" />
                <Label
                    HorizontalOptions="Center"
                    Text="Avisos"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Black}}"
                    FontSize="Medium" />
            </VerticalStackLayout>
            <BoxView
                Grid.Column="4" Grid.RowSpan="3"
                Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}" />
            <VerticalStackLayout
                Grid.Column="5" Grid.RowSpan="3"
                MinimumWidthRequest="124"
                VerticalOptions="Center"
                Padding="20" Spacing="4">
                <Label
                    HorizontalOptions="Center"
                    Text="&#xF78A;"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Black}}"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Header" />
                <Label
                    HorizontalOptions="Center"
                    Text="Ayuda"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Black}}"
                    FontSize="Medium" />
            </VerticalStackLayout>
        </Grid>
        <BoxView
            HeightRequest="1"
            Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
        <ScrollView 
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray400}}"
            VerticalOptions="FillAndExpand">
            <FlexLayout
                MaximumWidthRequest="1440"
                Margin="10"
                Wrap="Wrap"
                AlignItems="Start" AlignContent="Start">
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="PurchasingSectionCardFrameTapGestureRecognizer_Tapped" />
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="purchasing.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="Compras" />
                        </Grid>
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="InventorySectionCardFrameTapGestureRecognizer_Tapped" />
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="warehousing.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="Inventario" />
                        </Grid>
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ProductionSectionCardFrameTapGestureRecognizer_Tapped" />
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="elaboration.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="Producción" />
                        </Grid>
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="sales.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="Ventas" />
                        </Grid>
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="HumanResourcesSectionCardFrameTapGestureRecognizer_Tapped" />
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="rr_hh.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="RR.HH." />
                        </Grid>
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="FinancialSectionCardFrameTapGestureRecognizer_Tapped" />
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="cash.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="Finanzas" />
                        </Grid>
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="accounting.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="Contabilidad" />
                        </Grid>
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="monitorization.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="Estrategia" />
                        </Grid>
                    </Grid>
                </Frame>
            </FlexLayout>
        </ScrollView>
    </StackLayout>
</caneyframework_mvvm_pages:BindingContextedContentPage>
