<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:decisorframework_core_page_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models.Page;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:decisorframework_core_view_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models.View;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    x:Class="MOROPO.CheffMigueSRL.Decisor.Terminal.UI.Pages.Flyout.HumanResourcesFlyoutPage"
    x:DataType="decisorframework_core_page_models:CommonFlyoutPageModel"
    Title="Navegación"
    BackgroundColor="{StaticResource Gray050}">
    <StackLayout Spacing="10">
        <Grid HeightRequest="180">
            <Image 
                Aspect="AspectFill"
                Source="rr_hh.jpg" />
            <BoxView
                Color="#A7000000" />
            <Grid
                Padding="16">
                <Button
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Text="&#xF2DE;"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Medium"
                    Padding="4"
                    BackgroundColor="#60FFFFFF"
                    Clicked="BackButton_Clicked" />
                <Label
                    Text="RR.HH."
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalOptions="Center"
                    FontSize="Large"
                    FontAttributes="Bold" />
            </Grid>
        </Grid>
        <CollectionView
            x:Name="ModuleNavigationSectionCollectionView"
            VerticalOptions="FillAndExpand"
            SelectionMode="Single"
            IsGrouped="True"
            ItemsSource="{Binding Path=ModuleNavigationSections, Mode=OneTime}"
            SelectionChanged="ModuleNavigationSectionCollectionView_SelectionChanged">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="decisorframework_core_view_models:ModuleNavigationSectionViewModel">
                    <Label
                        Text="{Binding Name}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                        FontSize="Medium"
                        FontAttributes="Bold" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="decisorframework_core_view_models:ModuleNavigationItemViewModel">
                    <StackLayout 
                        Orientation="Horizontal"
                        Padding="10"
                        Spacing="10">
                        <Label
                            Text="{Binding Glyph}"
                            FontFamily="MaterialDesignIcons"
                            FontSize="Medium" />
                        <Label
                            HorizontalOptions="FillAndExpand"
                            Text="{Binding Title}" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</caneyframework_mvvm_pages:ContentPage>