<?xml version="1.0" encoding="utf-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_pages="clr-namespace:MOROPO.CheffMigueSRL.Decisor.Terminal.UI.Pages"
    xmlns:decisorframework_essential_manage_pages="clr-namespace:MOROPO.Framework.Decisor.Essential.Presentation.Terminal.MAUI.UI.Pages.Manage;assembly=MOROPO.Framework.Decisor.Essential.Presentation.Terminal.MAUI"
    xmlns:decisorframework_inventory_manage_pages="clr-namespace:MOROPO.Framework.Decisor.Inventory.Presentation.Terminal.MAUI.UI.Pages.Manage;assembly=MOROPO.Framework.Decisor.Inventory.Presentation.Terminal.MAUI"
    x:Class="MOROPO.CheffMigueSRL.Decisor.Terminal.UI.Shells.InventoryShell"
    FlyoutBehavior="Locked">
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180">
            <Image 
                Aspect="AspectFill"
                Source="warehousing.jpg" />
            <BoxView
                Color="#A7000000" />
            <Grid
                Padding="16">
                <Button
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Text="&#xF2DE;"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Large"
                    Padding="4"
                    BackgroundColor="#60FFFFFF"
                    Clicked="BackHomeButton_Clicked" />
                <Label
                    Text="Inventario"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalOptions="Center"
                    FontSize="Large"
                    FontAttributes="Bold" />
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>
    <MenuFlyoutItem Text="Inicio" />
    <ShellContent
        Title="Panel de Control"
        ContentTemplate="{DataTemplate local_pages:InventoryDashboardPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF9E7;"
                Color="Black" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutSeparator />
    <MenuFlyoutItem Text="Operaciones" />
    <ShellContent
        Title="Recepciones">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF3D4;"
                Color="Black" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Salidas">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF3D5;"
                Color="Black" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutSeparator />
    <MenuFlyoutItem Text="Gestión" />
    <ShellContent
        Title="Almacenes"
        ContentTemplate="{DataTemplate decisorframework_inventory_manage_pages:WarehousesManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFFBB;"
                Color="Black" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Productos"
        ContentTemplate="{DataTemplate decisorframework_inventory_manage_pages:ProductsManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF3D7;"
                Color="Black" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Unidades de Medida"
        ContentTemplate="{DataTemplate decisorframework_essential_manage_pages:UnitMeasurementsManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF472;"
                Color="Black" />
        </ShellContent.Icon>
    </ShellContent>
</Shell>
