<?xml version="1.0" encoding="utf-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_pages="clr-namespace:MOROPO.CheffMigueSRL.Decisor.Terminal.UI.Pages"
    xmlns:decisorframework_purchasing_manage_pages="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.UI.Pages.Manage;assembly=MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI"
    x:Class="MOROPO.CheffMigueSRL.Decisor.Terminal.UI.Shells.PurchasingShell"
    FlyoutBehavior="Locked">
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180">
            <Image 
                Aspect="AspectFill"
                Source="purchasing.jpg" />
            <BoxView
                Color="#A7000000" />
            <Grid
                Padding="16">
                <Button
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Text="&#xF2DE;"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Large"
                    Padding="4"
                    BackgroundColor="#60FFFFFF"
                    Clicked="BackHomeButton_Clicked" />
                <Label
                    Text="Compras"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalOptions="Center"
                    FontSize="Large"
                    FontAttributes="Bold" />
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>
    <MenuFlyoutItem Text="Inicio" />
    <ShellContent
        Title="Panel de Control"
        ContentTemplate="{DataTemplate local_pages:PurchasingDashboardPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF9E7;"
                Color="Black" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutSeparator />
    <MenuFlyoutItem Text="Operaciones" />
    <FlyoutItem
        Title="Planes">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF787;"
                Color="Black" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Por Aprobar"
            ContentTemplate="{DataTemplate decisorframework_purchasing_manage_pages:ToApprovePurchasePlansManagePage}" />
        <ShellContent
            Title="Por Completar"
            ContentTemplate="{DataTemplate decisorframework_purchasing_manage_pages:ToCompletePurchasePlansManagePage}" />
        <ShellContent
            Title="Realizado"
            ContentTemplate="{DataTemplate decisorframework_purchasing_manage_pages:FilledPurchasePlansManagePage}" />
    </FlyoutItem>
    <ShellContent
        Title="Compras"
        ContentTemplate="{DataTemplate decisorframework_purchasing_manage_pages:PurchasesManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFCB0;"
                Color="Black" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutSeparator />
    <MenuFlyoutItem Text="Gestión" />
    <FlyoutItem
        Title="Proveedores">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF6D8;"
                Color="Black" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Jurídicos"
            ContentTemplate="{DataTemplate decisorframework_purchasing_manage_pages:LegalProvidersManagePage}" />
        <ShellContent
            Title="Naturales"
            ContentTemplate="{DataTemplate decisorframework_purchasing_manage_pages:NaturalProvidersManagePage}" />
    </FlyoutItem>
    <ShellContent
        Title="Zonas de Compra"
        ContentTemplate="{DataTemplate decisorframework_purchasing_manage_pages:PurchaseZonesManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFEBB;"
                Color="Black" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Tipos de Gasto"
        ContentTemplate="{DataTemplate decisorframework_purchasing_manage_pages:PurchaseSpentsManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF117;"
                Color="Black" />
        </ShellContent.Icon>
    </ShellContent>
</Shell>
