<?xml version="1.0" encoding="utf-8" ?>
<Shell 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_pages="clr-namespace:MOROPO.CheffMigueSRL.Decisor.Terminal.UI.Pages"
    xmlns:decisorframework_production_manage_pages="clr-namespace:MOROPO.Framework.Decisor.Production.Presentation.Terminal.MAUI.UI.Default.Pages.Manage;assembly=MOROPO.Framework.Decisor.Production.Presentation.Terminal.MAUI.UI.Default"
    x:Class="MOROPO.CheffMigueSRL.Decisor.Terminal.UI.Shells.ProductionShell"
    FlyoutBehavior="Locked">
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180">
            <Image 
                Aspect="AspectFill"
                Source="elaboration.jpg" />
            <BoxView
                Color="#A7000000" />
            <Grid
                Padding="16">
                <Button
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Text="&#xF2DE;"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Medium"
                    Padding="4"
                    BackgroundColor="#60FFFFFF"
                    Clicked="BackHomeButton_Clicked" />
                <Label
                    Text="Producción"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalOptions="Center"
                    FontSize="Large"
                    FontAttributes="Bold" />
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>
    <MenuFlyoutItem Text="Inicio" />
    <ShellContent
        Title="Panel de Control"
        ContentTemplate="{DataTemplate local_pages:ProductionDashboardPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF9E7;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Operaciones" />
    <FlyoutItem
        Title="Planes">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF14E;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Realizados"
            ContentTemplate="{DataTemplate decisorframework_production_manage_pages:FilledProductionPlansManagePage}" />
        <ShellContent
            Title="Por Realizar"
            ContentTemplate="{DataTemplate decisorframework_production_manage_pages:ToCompleteProductionPlansManagePage}" />
        <ShellContent
            Title="Por Aprobar"
            ContentTemplate="{DataTemplate decisorframework_production_manage_pages:ToApproveProductionPlansManagePage}" />
    </FlyoutItem>
    <ShellContent
        Title="Producciones"
        ContentTemplate="{DataTemplate decisorframework_production_manage_pages:ProductionsManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF8D5;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Gestión" />
    <ShellContent
        Title="Elaboraciones"
        ContentTemplate="{DataTemplate decisorframework_production_manage_pages:ElaborationsManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF093;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
</Shell>