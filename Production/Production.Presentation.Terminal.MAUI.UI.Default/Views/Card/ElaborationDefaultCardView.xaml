<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Production.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Production.Interop.API.Common"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    x:Class="MOROPO.Framework.Decisor.Production.Presentation.Terminal.MAUI.UI.Default.Views.Card.ElaborationDefaultCardView"
    x:DataType="interop_common_display_models:ElaborationDisplayModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />

            <caneyframework_presentation_converters:DoubleToFractionConverter x:Key="DoubleToFractionConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Frame Padding="0">
        <StackLayout 
            Orientation="Vertical"
            Spacing="0">
            <Image
                VerticalOptions="FillAndExpand"
                Aspect="AspectFill"
                Source="{Binding Product.FeatureImage, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
            <StackLayout
                Padding="16">
                <Label
                    ToolTipProperties.Text="{Binding Product.Name}"
                    LineBreakMode="TailTruncation"
                    FontSize="Medium"
                    Text="{Binding Product.Name}" />
                <Label
                    ToolTipProperties.Text="{Binding Name}"
                    LineBreakMode="TailTruncation"
                    FontAttributes="Bold"
                    Text="{Binding Name}" />
                <Label 
                    Margin="0,6,0,0"
                    Text="Descripción"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold" />
                <Label
                    VerticalOptions="FillAndExpand"
                    LineBreakMode="TailTruncation"
                    MaxLines="2"
                    Text="{Binding Description, TargetNullValue='---'}" />
            </StackLayout>
        </StackLayout>
    </Frame>
</ContentView>
