<?xml version="1.0" encoding="utf-8" ?>
<core_contract_configuration_pages:BaseConfigurationContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_card_views="clr-namespace:MOROPO.Framework.Decisor.Production.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Production.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Production.Presentation.Terminal.MAUI"
    xmlns:core_contract_configuration_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.Contract;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default"
    xmlns:interop_common_bridge_models="clr-namespace:MOROPO.Framework.Decisor.Production.Interop.API.Common.Models.Bridge;assembly=MOROPO.Framework.Decisor.Production.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Production.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.ElaborationStepProductionRoleBridgeConfigurationPage"
    x:TypeArguments="interop_common_bridge_models:ElaborationStepProductionRoleBridgeModel"
    x:DataType="presentation_configuration_page_models:ElaborationStepProductionRoleBridgeConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
        Text="Aplicar"
        Clicked="ApplyClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
        Text="Cancelar"
        Clicked="CancelClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ScrollView Orientation="Vertical">
        <Grid 
            Padding="20"
            ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="0">
                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Proveedor" />
                <Picker
                   x:Name="RolePicker"
                   ItemsSource="{Binding Path=AvailableRoles}"
                   ItemDisplayBinding="{Binding Name}"
                   SelectedIndexChanged="Picker_SelectedIndexChanged" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.Row="0">
                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Remuneración" />
                <Entry Text="{Binding Participation, StringFormat='{0:F2}'}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6" Grid.Column="2" Grid.Row="0">
                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Relativa?" />
                <Switch IsToggled="{Binding Linked}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6" Grid.ColumnSpan="3" Grid.Row="1">
                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descripción" />
                <Editor Text="{Binding Description}" HeightRequest="120" />
            </VerticalStackLayout>            
            <caneyframework_presentation_views:BusyView
                Grid.ColumnSpan="3" Grid.RowSpan="2"
                BackgroundColor="#A7FFFFFF"
                IsVisible="{Binding IsBusy}" />
        </Grid>
    </ScrollView>
</core_contract_configuration_pages:BaseConfigurationContentPage>