<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_card_views="clr-namespace:MOROPO.Framework.Decisor.Production.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:presentation_manage_page_models="clr-namespace:MOROPO.Framework.Decisor.Production.Presentation.Terminal.MAUI.Models.Page.Manage;assembly=MOROPO.Framework.Decisor.Production.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Production.Presentation.Terminal.MAUI.UI.Default.Pages.Manage.ToCompleteProductionPlansManagePage"
    x:DataType="presentation_manage_page_models:ProductionPlansManagePageModel"
    Title="Por Realizar">
    <ContentPage.Resources>
        <ResourceDictionary>
            <caneyframework_presentation_converters:ViewChildParentWidthToRelativeWidthConverter x:Key="ItemViewChildParentWidthToRelativeWidthConverter" ReferenceWidth="384" AbsoluteHorizontalSeparation="20" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />

            <Style TargetType="Label" x:Key="CaptionFieldLabelStyle">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=DimGray, Dark=Gray}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="Caption" />
                <Setter Property="Margin" Value="0,16,0,0" />
            </Style>
            <Style TargetType="Label" x:Key="ValueFieldLabelStyle">
                <Setter Property="FontSize" Value="Default" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="ReloadToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF450;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <ScrollView 
                Orientation="Vertical"
                VerticalOptions="FillAndExpand">
                <FlexLayout
                    Margin="10"
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start"
                    BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <local_card_views:ProductionPlanToCompleteDefaultCardView
                                Margin="5"
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource ItemViewChildParentWidthToRelativeWidthConverter}}"
                                HeightRequest="180">
                                <ContentView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ItemTapGestureRecognizer_Tapped" />
                                </ContentView.GestureRecognizers>
                            </local_card_views:ProductionPlanToCompleteDefaultCardView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                    <BindableLayout.EmptyView>
                        <Label
                            HorizontalTextAlignment="Center"
                            Margin="5"
                            Text="Sin elementos que mostrar"
                            TextColor="{AppThemeBinding Light=DimGray, Dark=Gray}"
                            FontAttributes="Italic" />
                    </BindableLayout.EmptyView>
                </FlexLayout>
            </ScrollView>
            <ContentView 
                IsVisible="{Binding PresentedItem, Converter={StaticResource IsNotNullConverter}}"
                BackgroundColor="#A9000000">
                <ScrollView Orientation="Vertical">
                    <Grid>
                        <Frame
                            VerticalOptions="Center" HorizontalOptions="Center"
                            Padding="0" Margin="20"
                            WidthRequest="400"
                            BackgroundColor="White">
                            <Grid>
                                <StackLayout Margin="20" Spacing="20">
                                    <StackLayout>
                                        <Label 
                                            Margin="0,0,0,20"
                                            Text="Detalles"
                                            FontAttributes="Bold"
                                            FontSize="Medium" />
                                        <Label
                                            Style="{StaticResource CaptionFieldLabelStyle}"
                                            Margin="0"
                                            Text="Producto" />
                                        <Label
                                            Style="{StaticResource ValueFieldLabelStyle}"
                                            Text="{Binding PresentedItem.Elaboration.Product.Name}" />
                                        <Label 
                                            Style="{StaticResource CaptionFieldLabelStyle}"
                                            Text="Prioridad" />
                                        <Label
                                            Style="{StaticResource ValueFieldLabelStyle}"
                                            Text="{Binding PresentedItem.Priority}" />
                                        <Label 
                                            Style="{StaticResource CaptionFieldLabelStyle}"
                                            Text="Descripción" />
                                        <Label
                                            Style="{StaticResource ValueFieldLabelStyle}"
                                            Text="{Binding PresentedItem.Description, TargetNullValue='---'}" />
                                    </StackLayout>
                                    <Button 
                                        HorizontalOptions="Center"
                                        Text="Eliminar"
                                        Clicked="PresentedItemRemoveButton_Clicked" />
                                </StackLayout>
                                <Button
                                    HorizontalOptions="End" VerticalOptions="Start"
                                    Padding="10"
                                    BackgroundColor="Transparent"
                                    Text="&#xf5ad;"
                                    TextColor="Black"
                                    FontSize="Medium"
                                    FontFamily="MaterialDesignIcons"
                                    BorderWidth="0"
                                    WidthRequest="48" HeightRequest="48"
                                    Clicked="PresentedItemDismissButton_Clicked" />
                            </Grid>
                        </Frame>
                    </Grid>
                </ScrollView>
            </ContentView>
            <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
        </Grid>
    </ContentPage.Content>
</caneyframework_mvvm_pages:ContentPage>