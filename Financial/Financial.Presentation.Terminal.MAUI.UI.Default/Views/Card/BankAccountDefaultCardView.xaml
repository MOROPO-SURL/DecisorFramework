<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Financial.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Financial.Interop.API.Common"
    x:Class="MOROPO.Framework.Decisor.Financial.Presentation.Terminal.MAUI.UI.Default.Views.Card.BankAccountDefaultCardView"
    x:DataType="interop_common_display_models:BankAccountDisplayModel">
    <Frame>
        <StackLayout>
            <Label
                FontAttributes="Bold"
                LineBreakMode="TailTruncation"
                Text="{Binding Number}"
                FontSize="Medium" />
            <Label 
                FontAttributes="Bold"
                LineBreakMode="TailTruncation"
                Text="{Binding Branch}" />
            <Label 
                LineBreakMode="TailTruncation"
                Text="{Binding Holder}" />
            <Label 
                Margin="0,6,0,0"
                Text="Moneda"
                TextColor="DimGray"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label>
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Currency.Name}" />
                        <Span Text=" (" />
                        <Span Text="{Binding Currency.Symbol}" />
                        <Span Text=")" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </StackLayout>        
    </Frame>
</ContentView>
