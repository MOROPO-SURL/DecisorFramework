<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:BindingContextedContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:decisorframework_core_models_page="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models.Page;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:freaky_controls="clr-namespace:Maui.FreakyControls;assembly=Maui.FreakyControls"
    x:Class="MOROPO.CITMACamaguey.Decisor.Terminal.UI.Pages.MainPage"
    x:TypeArguments="decisorframework_core_models_page:MainPageModel"
    x:DataType="decisorframework_core_models_page:MainPageModel"
    Title="Inicio">
    <ContentPage.Resources>
        <ResourceDictionary>
            <caneyframework_presentation_converters:ViewChildParentWidthToRelativeWidthConverter x:Key="ViewChildParentWidthToRelativeWidthConverter" ReferenceWidth="240" AbsoluteHorizontalSeparation="20" />
            <caneyframework_presentation_converters:DoubleToFactorConverter x:Key="DoubleToFactorConverter" />

            <Style x:Key="SectionCardFrameStyle" TargetType="Frame">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="WidthRequest" Value="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource ViewChildParentWidthToRelativeWidthConverter}}" />
                <Setter Property="HeightRequest" Value="180" />
            </Style>
            <Style x:Key="SectionCardBackgroudImageStyle" TargetType="Image">
                <Setter Property="Aspect" Value="AspectFill" />
            </Style>
            <Style x:Key="SectionCardOverlayBoxViewStyle" TargetType="BoxView">
                <Setter Property="Color" Value="#A7000000" />
            </Style>
            <Style x:Key="SectionCardNameLabelStyle" TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="Large" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <x:Double x:Key="LogoArtFrameImageWithFactor">1.25</x:Double>
        </ResourceDictionary>
    </ContentPage.Resources>
    <StackLayout>
        <Grid 
            BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite}, Dark={StaticResource OffBlack}}"
            HeightRequest="168"
            ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="LogoWrapLayout"
                Grid.Column="1"
                MinimumWidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}">
                <Image
                    Margin="32,16"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Style="{StaticResource LogoImageViewStyle}" />
            </Grid>
            <Grid
                Grid.Column="0"
                Padding="20"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Column="0" Grid.RowSpan="3"
                    WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}"
                    StrokeThickness="4"
                    StrokeLineJoin="Bevel">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,30,30,00" />
                    </Border.StrokeShape>
                    <Image
                        WidthRequest="120" HeightRequest="120"
                        Source="default_person_picture.jpg" />
                </Border>
                <Label
                    Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0"
                    LineBreakMode="TailTruncation" 
                    Text="{Binding User.Id}"
                    FontSize="Medium"
                    FontAttributes="Bold" />
                <Label
                    Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                    LineBreakMode="TailTruncation"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                    FontSize="Default">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding User.Identity.Name}" />
                            <Span Text=" " />
                            <Span Text="{Binding User.Identity.LastName}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Button
                    Grid.Column="1" Grid.Row="2"
                    Margin="0, 10"
                    FontSize="Medium"
                    FontFamily="MaterialDesignIcons"
                    Text="&#xF6BB;" />
                <Button
                    Grid.Column="2" Grid.Row="2"
                    HorizontalOptions="Start"
                    Margin="0, 10"
                    FontSize="Medium"
                    FontFamily="MaterialDesignIcons"
                    Text="&#xF5FD;" />
            </Grid>
            <Grid
                Grid.Column="2"
                Padding="20"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <VerticalStackLayout
                    Grid.Column="1"
                    MinimumWidthRequest="124"
                    VerticalOptions="Center"
                    Padding="20" Spacing="4">
                    <Label
                        HorizontalOptions="Center"
                        Text="&#xF09E;"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        FontFamily="MaterialDesignIcons"
                        FontSize="Header" />
                    <Label
                        HorizontalOptions="Center"
                        Text="Avisos"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        FontSize="Medium" />
                </VerticalStackLayout>
                <BoxView
                    Grid.Column="2"
                    Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}" />
                <VerticalStackLayout
                    Grid.Column="3"
                    MinimumWidthRequest="124"
                    VerticalOptions="Center"
                    Padding="20" Spacing="4">
                    <Label
                        HorizontalOptions="Center"
                        Text="&#xF78A;"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        FontFamily="MaterialDesignIcons"
                        FontSize="Header" />
                    <Label
                        HorizontalOptions="Center"
                        Text="Ayuda"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        FontSize="Medium" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
        <ScrollView VerticalOptions="FillAndExpand">
            <FlexLayout
                MaximumWidthRequest="1440"
                Margin="10"
                Wrap="Wrap"
                AlignItems="Start" AlignContent="Start">
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="DomainSectionCardFrameTapGestureRecognizer_Tapped" />
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="domain.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="Dominio" />
                        </Grid>
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="LegalSectionCardFrameTapGestureRecognizer_Tapped" />
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="legal.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="Jurídico" />
                        </Grid>
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="HumanResourcesSectionCardFrameTapGestureRecognizer_Tapped" />
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="rr_hh.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="RR.HH." />
                        </Grid>
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="GovernanceSectionCardFrameTapGestureRecognizer_Tapped" />
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="governance.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="Gobernanza" />
                        </Grid>
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="CommecrcialSectionCardFrameTapGestureRecognizer_Tapped" />
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="commercial.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="Comercial" />
                        </Grid>
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SectionCardFrameStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="FinancialSectionCardFrameTapGestureRecognizer_Tapped" />
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Image Style="{StaticResource SectionCardBackgroudImageStyle}" Source="cash.jpg" />
                        <BoxView Style="{StaticResource SectionCardOverlayBoxViewStyle}" />
                        <Grid Padding="5">
                            <Label Style="{StaticResource SectionCardNameLabelStyle}" Text="Finanzas" />
                        </Grid>
                    </Grid>
                </Frame>
            </FlexLayout>
        </ScrollView>
    </StackLayout>
</caneyframework_mvvm_pages:BindingContextedContentPage>
