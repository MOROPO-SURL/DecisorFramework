<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:BindingContextedContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fwrk_core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:fwrk_core_dashboard_page_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models.Page.Dashboard;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:fwrk_core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.CITMACamaguey.Decisor.Terminal.UI.Pages.SimplifiedGovernanceDashboardPage"
    x:TypeArguments="fwrk_core_dashboard_page_models:BaseGovernanceDashboardPageModel"
    x:DataType="fwrk_core_dashboard_page_models:BaseGovernanceDashboardPageModel"
    Title="Panel de Control para Gobernanza">
    <ContentPage.Resources>
        <fwrk_core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />

        <communitytoolkit_converters:BoolToObjectConverter 
            x:Key="BoolToColor" 
            TrueObject="#45A049"            
            FalseObject="#E65100" />
        <communitytoolkit_converters:BoolToObjectConverter 
            x:Key="IsModuleReadeyToGlyph" 
            TrueObject="&#xF790;"
            FalseObject="&#xFCC1;" />
        <communitytoolkit_converters:BoolToObjectConverter 
            x:Key="HasAnyToGlyph" 
            TrueObject="&#xFE70;"
            FalseObject="&#xF026;" />
        <communitytoolkit_converters:BoolToObjectConverter 
            x:Key="IsModuleReadeyToTitle" 
            TrueObject="Configuración mínima del módulo completada"
            FalseObject="Se requiere configuración mínima del módulo" />
        <communitytoolkit_converters:BoolToObjectConverter 
            x:Key="BoolToTitle" 
            TrueObject="Al menos una definida"
            FalseObject="0 definidas" />
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="ReloadToolbarItems_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF450;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="4" Margin="8">
                <Frame Margin="8">
                    <VerticalStackLayout>
                        <Label
                            HorizontalTextAlignment="Center"
                            FontFamily="MaterialDesignIcons"
                            FontSize="96"
                            TextColor="{Binding IsModuleReady, Converter={StaticResource BoolToColor}}"
                            Text="{Binding IsModuleReady, Converter={StaticResource IsModuleReadeyToGlyph}}" />
                        <Label
                            HorizontalTextAlignment="Center"
                            FontSize="Medium"
                            TextColor="{Binding IsModuleReady, Converter={StaticResource BoolToColor}}"
                            Text="{Binding IsModuleReady, Converter={StaticResource IsModuleReadeyToTitle}}" />
                        <BoxView
                            Style="{StaticResource SeparatorBoxView}"
                            Margin="0,24"
                            HeightRequest="2" />
                        <FlexLayout
                            Wrap="Wrap"
                            AlignItems="Start" AlignContent="Start">
                            <VerticalStackLayout
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={fwrk_core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=4, SmallContainerColumn=6}}"
                                Margin="4,8">
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="48"
                                    Text="{StaticResource DecisionMakingGroupMaterialDesignGlyphIconId}" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontAttributes="Bold"
                                    Text="Grupos Decisores" />
                                <Label
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="36"
                                    TextColor="{Binding HasAnyGroup, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyGroup, Converter={StaticResource HasAnyToGlyph}}" />
                                <Label
                                    HorizontalOptions="Center"
                                    TextColor="{Binding HasAnyGroup, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyGroup, Converter={StaticResource BoolToTitle}}" />
                                <Button
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    Text="Gestionar"
                                    Clicked="GoGroupsManageSiteButton_Clicked" />
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={fwrk_core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=4, SmallContainerColumn=6}}"
                                Margin="4,8">
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="48"
                                    Text="{StaticResource MeetingMaterialDesignGlyphIconId}" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontAttributes="Bold"
                                    Text="Reuniones" />
                                <Label
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="36"
                                    TextColor="{Binding HasAnyMeeting, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyMeeting, Converter={StaticResource HasAnyToGlyph}}" />
                                <Label
                                    HorizontalOptions="Center"
                                    TextColor="{Binding HasAnyMeeting, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyMeeting, Converter={StaticResource BoolToTitle}}" />
                                <Button
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    Text="Gestionar"
                                    Clicked="GoMeetingsManageSiteButton_Clicked" />
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={fwrk_core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=4, SmallContainerColumn=6}}"
                                Margin="4,8">
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="48"
                                    Text="&#xFE71;" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontAttributes="Bold"
                                    Text="Acuerdos" />
                                <Label
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="36"
                                    TextColor="{Binding HasAnyAgreement, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyAgreement, Converter={StaticResource HasAnyToGlyph}}" />
                                <Label
                                    HorizontalOptions="Center"
                                    TextColor="{Binding HasAnyAgreement, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyAgreement, Converter={StaticResource BoolToTitle}}" />
                                <Button
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    Text="Gestionar"
                                    Clicked="GoMeetingsManageSiteButton_Clicked" />
                            </VerticalStackLayout>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}" />
    </Grid>
</caneyframework_mvvm_pages:BindingContextedContentPage>