<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:BindingContextedContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fwrk_core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:fwrk_core_dashboard_page_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models.Page.Dashboard;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:fwrk_core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.EPTCamaguey.Decisor.Terminal.UI.Pages.SimplifiedHumanResourcesDashboardPage"
    x:TypeArguments="fwrk_core_dashboard_page_models:BaseHumanResourcesDashboardPageModel"
    x:DataType="fwrk_core_dashboard_page_models:BaseHumanResourcesDashboardPageModel"
    Title="Panel de Control para Recursos Humanos">
    <ContentPage.Resources>
        <fwrk_core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />

        <communitytoolkit_converters:BoolToObjectConverter 
            x:Key="BoolToColor" 
            TrueObject="#45A049"            
            FalseObject="#E65100" />
        <communitytoolkit_converters:BoolToObjectConverter 
            x:Key="IsModuleReadeyToGlyph" 
            TrueObject="&#xF790;"
            FalseObject="&#xFCC1;" />
        <communitytoolkit_converters:BoolToObjectConverter 
            x:Key="HasAnyToGlyph" 
            TrueObject="&#xFE70;"
            FalseObject="&#xF026;" />
        <communitytoolkit_converters:BoolToObjectConverter 
            x:Key="IsModuleReadeyToTitle" 
            TrueObject="Configuración mínima del módulo completada"
            FalseObject="Se requiere configuración mínima del módulo" />
        <communitytoolkit_converters:BoolToObjectConverter 
            x:Key="BoolToTitle" 
            TrueObject="Al menos una definida"
            FalseObject="0 definidas" />
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="ReloadToolbarItems_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF450;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="4" Margin="8">
                <Frame Margin="8">
                    <VerticalStackLayout>
                        <Label
                            HorizontalTextAlignment="Center"
                            FontFamily="MaterialDesignIcons"
                            FontSize="96"
                            TextColor="{Binding IsModuleReady, Converter={StaticResource BoolToColor}}"
                            Text="{Binding IsModuleReady, Converter={StaticResource IsModuleReadeyToGlyph}}" />
                        <Label
                            HorizontalTextAlignment="Center"
                            FontSize="Medium"
                            TextColor="{Binding IsModuleReady, Converter={StaticResource BoolToColor}}"
                            Text="{Binding IsModuleReady, Converter={StaticResource IsModuleReadeyToTitle}}" />
                        <BoxView
                            Style="{StaticResource SeparatorBoxView}"
                            Margin="0,24"
                            HeightRequest="2" />
                        <FlexLayout
                            Wrap="Wrap"
                            AlignItems="Start" AlignContent="Start">
                            <VerticalStackLayout
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={fwrk_core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}}"
                                Margin="4,8">
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="48"
                                    Text="{StaticResource WorkPositionKindMaterialDesignGlyphIconId}" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontAttributes="Bold"
                                    Text="Categorías Ocupacionales" />
                                <Label
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="36"
                                    TextColor="{Binding HasAnyWorkPositionKind, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyWorkPositionKind, Converter={StaticResource HasAnyToGlyph}}" />
                                <Label
                                    HorizontalOptions="Center"
                                    TextColor="{Binding HasAnyWorkPositionKind, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyWorkPositionKind, Converter={StaticResource BoolToTitle}}" />
                                <Button
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    Text="Administrar"
                                    Clicked="GoWorkPositionKindsAdminSiteButton_Clicked" />
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={fwrk_core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}}"
                                Margin="4,8">
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="48"
                                    Text="{StaticResource WorkPositionMaterialDesignGlyphIconId}" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontAttributes="Bold"
                                    Text="Plazas Laborales" />
                                <Label
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="36"
                                    TextColor="{Binding HasAnyWorkPosition, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyWorkPosition, Converter={StaticResource HasAnyToGlyph}}" />
                                <Label
                                    HorizontalOptions="Center"
                                    TextColor="{Binding HasAnyWorkPosition, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyWorkPosition, Converter={StaticResource BoolToTitle}}" />
                                <Button
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    Text="Gestionar"
                                    Clicked="GoWorkPositionsManageSiteButton_Clicked" />
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={fwrk_core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}}"
                                Margin="4,8">
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="48"
                                    Text="{StaticResource SalaryStandardMaterialDesignGlyphIconId}" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontAttributes="Bold"
                                    Text="Escalas Salariales" />
                                <Label
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="36"
                                    TextColor="{Binding HasAnySalaryStandard, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnySalaryStandard, Converter={StaticResource HasAnyToGlyph}}" />
                                <Label
                                    HorizontalOptions="Center"
                                    TextColor="{Binding HasAnySalaryStandard, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnySalaryStandard, Converter={StaticResource BoolToTitle}}" />
                                <Button
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    Text="Gestionar"
                                    Clicked="GoSalaryStandardsManageSiteButton_Clicked" />
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={fwrk_core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}}"
                                Margin="4,8">
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="48"
                                    Text="{StaticResource WorkforceMaterialDesignGlyphIconId}" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontAttributes="Bold"
                                    Text="Estructuras de Plantilla" />
                                <Label
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="36"
                                    TextColor="{Binding HasAnyWorkforce, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyWorkforce, Converter={StaticResource HasAnyToGlyph}}" />
                                <Label
                                    HorizontalOptions="Center"
                                    TextColor="{Binding HasAnyWorkforce, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyWorkforce, Converter={StaticResource BoolToTitle}}" />
                                <Button
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    Text="Gestionar"
                                    Clicked="GoWorkforcesManageSiteButton_Clicked" />
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={fwrk_core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}}"
                                Margin="4,8">
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="48"
                                    Text="{StaticResource StaffMaterialDesignGlyphIconId}" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontAttributes="Bold"
                                    Text="Configuraciones de Plantilla" />
                                <Label
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="36"
                                    TextColor="{Binding HasAnyStaff, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyStaff, Converter={StaticResource HasAnyToGlyph}}" />
                                <Label
                                    HorizontalOptions="Center"
                                    TextColor="{Binding HasAnyStaff, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyStaff, Converter={StaticResource BoolToTitle}}" />
                                <Button
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    Text="Gestionar"
                                    Clicked="GoStaffsManageSiteManagePageButton_Clicked" />
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={fwrk_core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}}"
                                Margin="4,8">
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="48"
                                    Text="{StaticResource OcupationMaterialDesignGlyphIconId}" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontAttributes="Bold"
                                    Text="Personal en Plantilla" />
                                <Label
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="36"
                                    TextColor="{Binding HasAnyOcupation, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyOcupation, Converter={StaticResource HasAnyToGlyph}}" />
                                <Label
                                    HorizontalOptions="Center"
                                    TextColor="{Binding HasAnyOcupation, Converter={StaticResource BoolToColor}}"
                                    Text="{Binding HasAnyOcupation, Converter={StaticResource BoolToTitle}}" />
                                <Button
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0"
                                    Text="Gestionar"
                                    Clicked="GoOcupationsManageSiteManagePageButton_Clicked" />
                            </VerticalStackLayout>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}" />
    </Grid>
</caneyframework_mvvm_pages:BindingContextedContentPage>