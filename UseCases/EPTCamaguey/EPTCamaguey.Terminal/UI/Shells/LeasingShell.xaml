<?xml version="1.0" encoding="utf-8" ?>
<Shell 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:decisorframework_leasing_manage_pages="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Pages.Manage;assembly=MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default"
    xmlns:decisorframework_leasing_list_pages="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Pages.List;assembly=MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default"
    xmlns:decisorframework_domain_manage_pages="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Pages.Manage;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default"
    xmlns:decisorframework_commercial_manage_pages="clr-namespace:MOROPO.Framework.Decisor.Commercial.Presentation.Terminal.MAUI.UI.Default.Pages.Manage;assembly=MOROPO.Framework.Decisor.Commercial.Presentation.Terminal.MAUI.UI.Default"
    xmlns:decisorframework_supervision_manage_pages="clr-namespace:MOROPO.Framework.Decisor.Supervision.Presentation.Terminal.MAUI.UI.Default.Pages;assembly=MOROPO.Framework.Decisor.Supervision.Presentation.Terminal.MAUI.UI.Default"
    x:Class="MOROPO.EPTCamaguey.Decisor.Terminal.UI.Shells.LeasingShell">
    <Shell.FlyoutBehavior>
        <OnIdiom Default="Flyout" Desktop="Locked" />
    </Shell.FlyoutBehavior>
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180">
            <Image 
                Aspect="AspectFill"
                Source="leasing.jpg" />
            <BoxView
                Color="#A7000000" />
            <Grid
                Padding="16">
                <Button
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Text="&#xF2DE;"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Medium"
                    Padding="4"
                    BackgroundColor="#60FFFFFF"
                    Clicked="BackHomeButton_Clicked" />
                <Label
                    Text="Arrendamiento"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalOptions="Center"
                    FontSize="Large"
                    FontAttributes="Bold" />
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>
    <MenuFlyoutItem Text="Inicio" />
    <ShellContent
        Title="Panel de Control"
        ContentTemplate="{DataTemplate decisorframework_supervision_manage_pages:LeasingDashboardPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF9E7;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Operaciones" />
    <FlyoutItem
        Title="Propuestas">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource LeasePropousalMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Vehículos"
            ContentTemplate="{DataTemplate decisorframework_leasing_manage_pages:VehicleLeasePropousalsManagePage}" />
        <ShellContent
            Title="Inmuebles"
            ContentTemplate="{DataTemplate decisorframework_leasing_manage_pages:PropertyLeasePropousalsManagePage}" />
    </FlyoutItem>
    <FlyoutItem
        Title="Ofertas">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource LeaseOfferMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Vehículos"
            ContentTemplate="{DataTemplate decisorframework_leasing_manage_pages:VehicleLeaseOffersManagePage}" />
        <ShellContent
            Title="Inmuebles"
            ContentTemplate="{DataTemplate decisorframework_leasing_manage_pages:PropertyLeaseOffersManagePage}" />
    </FlyoutItem>
    <FlyoutItem
        Title="Licitaciones">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF0032;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Vehículos"
            ContentTemplate="{DataTemplate decisorframework_leasing_list_pages:VehicleLeaseOfferTenderListPage}" />
        <ShellContent
            Title="Inmuebles"
            ContentTemplate="{DataTemplate decisorframework_leasing_list_pages:PropertyLeaseOfferTenderListPage}" />
    </FlyoutItem>
    <MenuFlyoutItem Text="Expedientes" IsEnabled="False" />
    <FlyoutItem
        Title="Arrendamiento de Inmuebles">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource PropertyMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Clientes Jurídicos"
            ContentTemplate="{DataTemplate decisorframework_leasing_list_pages:LegalClientPropertyLeasingListPage}" />
        <ShellContent
            Title="Clientes Naturales"
            ContentTemplate="{DataTemplate decisorframework_leasing_list_pages:NaturalClientPropertyLeasingListPage}" />
    </FlyoutItem>
    <FlyoutItem
        Title="Arrendamiento de Vehículos">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource VehicleMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Clientes Jurídicos"
            ContentTemplate="{DataTemplate decisorframework_leasing_list_pages:LegalClientVehicleLeasingListPage}" />
        <ShellContent
            Title="Clientes Naturales"
            ContentTemplate="{DataTemplate decisorframework_leasing_list_pages:NaturalClientVehicleLeasingListPage}" />
    </FlyoutItem>
    <MenuFlyoutItem Text="Acciones de Control" IsEnabled="False" />
    <FlyoutItem
        Title="Arrendamiento de Inmuebles">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource PropertyMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Clientes Jurídicos"
            ContentTemplate="{DataTemplate decisorframework_leasing_manage_pages:LegalClientPropertyLeasingControlActionsManagePage}" />
        <ShellContent
            Title="Clientes Naturales"
            ContentTemplate="{DataTemplate decisorframework_leasing_manage_pages:NaturalClientPropertyLeasingControlActionsManagePage}" />
    </FlyoutItem>
    <FlyoutItem
        Title="Arrendamiento de Vehículos">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource VehicleMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Clientes Jurídicos"
            ContentTemplate="{DataTemplate decisorframework_leasing_manage_pages:LegalClientVehicleLeasingControlActionsManagePage}" />
        <ShellContent
            Title="Clientes Naturales"
            ContentTemplate="{DataTemplate decisorframework_leasing_manage_pages:NaturalClientVehicleLeasingControlActionsManagePage}" />
    </FlyoutItem>
    <MenuFlyoutItem Text="Gestión" IsEnabled="False" />
    <ShellContent
        Title="Grupos de Supervisión"
        ContentTemplate="{DataTemplate decisorframework_leasing_manage_pages:SupervisionGroupsManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource SupervisionGroupMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Inmuebles"
        ContentTemplate="{DataTemplate decisorframework_domain_manage_pages:PropertiesManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource PropertyMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Vehículos"
        ContentTemplate="{DataTemplate decisorframework_domain_manage_pages:VehiclesManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource VehicleMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Marcas"
        Route="BrandsManagePage"
        ContentTemplate="{DataTemplate decisorframework_domain_manage_pages:BrandsManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource BrandMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <FlyoutItem Title="Contactos">
        <FlyoutItem.Icon>
            <FontImageSource
             FontFamily="MaterialDesignIcons"
             Glyph="&#xF5D2;"
             Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
             Title="Organizaciones"
             ContentTemplate="{DataTemplate decisorframework_domain_manage_pages:OrganizationContactsManagePage}" />
        <ShellContent
            Title="Personas"
            ContentTemplate="{DataTemplate decisorframework_domain_manage_pages:PersonContactsManagePage}" />
    </FlyoutItem>
</Shell>