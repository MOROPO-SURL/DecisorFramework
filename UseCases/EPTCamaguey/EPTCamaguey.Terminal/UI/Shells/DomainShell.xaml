<?xml version="1.0" encoding="utf-8" ?>
<Shell 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_pages="clr-namespace:MOROPO.EPTCamaguey.Decisor.Terminal.UI.Pages"
    xmlns:fwrk_domain_list_pages="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Pages.List;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default"
    xmlns:fwrk_domain_manage_pages="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Pages.Manage;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default"
    x:Class="MOROPO.EPTCamaguey.Decisor.Terminal.UI.Shells.DomainShell">
    <Shell.FlyoutBehavior>
        <OnIdiom Default="Flyout" Desktop="Locked" />
    </Shell.FlyoutBehavior>
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180">
            <Image 
                Aspect="AspectFill"
                Source="domain.jpg" />
            <BoxView
                Color="#A7000000" />
            <Grid
                Padding="16">
                <Button
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Text="&#xF2DE;"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Medium"
                    Padding="4"
                    BackgroundColor="#60FFFFFF"
                    Clicked="BackHomeButton_Clicked" />
                <Label
                    Text="Dominio"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalOptions="Center"
                    FontSize="Large"
                    FontAttributes="Bold" />
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>
    <MenuFlyoutItem Text="Inicio" IsEnabled="False" />
    <ShellContent
        Title="Panel de Control"
        ContentTemplate="{DataTemplate local_pages:SimplifiedDomainDashboardPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF9E7;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Gestión" IsEnabled="False" />
    <MenuFlyoutItem Text="- Estructural -" IsEnabled="False" />
    <ShellContent
        Title="Entidades Administrativas"
        Route="AdministrativeEntitiesManagePage"
        ContentTemplate="{DataTemplate fwrk_domain_manage_pages:AdministrativeEntitiesManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource AdministrativeEntityMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Estructuras Organizacionales"
        Route="OrganizationalStructuresManagePage"
        ContentTemplate="{DataTemplate fwrk_domain_manage_pages:OrganizationalStructuresManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource OrganizationalStructureMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Unidades Organizativas"
        Route="OrganizationalUnitsManagePage"
        ContentTemplate="{DataTemplate fwrk_domain_manage_pages:OrganizationalUnitsManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource OrganizationalUnitDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="- Activos -" IsEnabled="False" />
    <ShellContent
        Title="Inmuebles"
        ContentTemplate="{DataTemplate fwrk_domain_manage_pages:PropertiesManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource PropertyMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Vehículos"
        ContentTemplate="{DataTemplate fwrk_domain_manage_pages:VehiclesManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource VehicleMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="- Complementarios -" IsEnabled="False" />
    <ShellContent
        Title="Organismos"
        ContentTemplate="{DataTemplate fwrk_domain_manage_pages:CentralStateStructuresManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFA35;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Marcas"
        ContentTemplate="{DataTemplate fwrk_domain_manage_pages:BrandsManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource BrandMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Áreas de Conocimiento"
        Route="KnowledgeAreasManagePage"
        ContentTemplate="{DataTemplate fwrk_domain_manage_pages:KnowledgeAreasManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF9D0;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Configuración" IsEnabled="False" />
    <ShellContent
        Title="Tipos de Entidad Administrativa"
        ContentTemplate="{DataTemplate fwrk_domain_list_pages:StructureKindsListPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF006C;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Tipos de Inmueble"
        ContentTemplate="{DataTemplate fwrk_domain_list_pages:PropertyKindsListPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource PropertyKindMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Tipos de Vehículo"
        ContentTemplate="{DataTemplate fwrk_domain_list_pages:VehicleKindsListPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource VehicleKindMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Tipos de Motorización"
        ContentTemplate="{DataTemplate fwrk_domain_list_pages:VehicleEngineKindsListPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource VehicleEngineKindMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
</Shell>