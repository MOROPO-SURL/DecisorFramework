<?xml version = "1.0" encoding = "UTF-8" ?>
<Application 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fwrk_core_presentation_dictionary_resources="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Resources.Styles;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    x:Class="MOROPO.EPTCamaguey.Decisor.Terminal.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Values.xaml" />
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />

                <fwrk_core_presentation_dictionary_resources:SharedStylesDictionary />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LogoImageViewStyle" TargetType="Image">
                <Setter Property="Source" Value="{AppThemeBinding Light='identity_color.png', Dark='identity_white.png'}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
