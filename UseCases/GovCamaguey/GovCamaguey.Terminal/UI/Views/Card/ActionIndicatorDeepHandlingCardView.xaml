<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.GovCamaguey.Decisor.Prototype.Interop.API.Common.Models.Display;assembly=MOROPO.GovCamaguey.Decisor.Prototype.Interop.API.Common"
    x:Class="MOROPO.GovCamaguey.Decisor.Prototype.Terminal.UI.Views.Card.ActionIndicatorDeepHandlingCardView"
    x:DataType="interop_common_display_models:ActionIndicatorDisplayModel">
    <Frame Padding="16">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <VerticalStackLayout 
                Grid.Column="0"
                VerticalOptions="Center">
                <Label Text="{Binding Name}" />
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span FontAttributes="Bold" Text="Meta: " />
                            <Span Text="{Binding Amount}" />
                            <Span Text=" " />
                            <Span Text="{Binding UnitMeasurement.Symbol}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
            <VerticalStackLayout 
                Grid.Column="1"
                VerticalOptions="Center">
                <Label 
                    FontAttributes="Bold"
                    Text="Estado" />
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span x:Name="BalanceSpan" Text="{Binding Balance, StringFormat='{0:F2}', Mode=OneTime}" />
                            <Span Text=" " />
                            <Span Text="{Binding UnitMeasurement.Symbol}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
            <Button
                Grid.Column="2"
                VerticalOptions="Center"
                Padding="0"
                FontSize="21"
                FontFamily="MaterialDesignIcons" 
                Text="&#xF90B;"
                Clicked="ResultUpgradeButton_Clicked" />
        </Grid>
    </Frame>
</ContentView>
