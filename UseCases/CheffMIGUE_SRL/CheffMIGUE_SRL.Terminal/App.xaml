<Application 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MOROPO.CheffMIGUE.Decisor.Terminal.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Values.xaml" />
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LogoImageViewStyle" TargetType="Image">
                <Setter Property="Source" Value="{AppThemeBinding Light='logo_chef_nuevo.png', Dark='logo_chef_nuevo.png'}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
