<?xml version="1.0" encoding="utf-8" ?>
<Shell 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MOROPO.Tool.Decisor.Terminal.UI.Shells.LegalShell"
    FlyoutBehavior="Locked">
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180">
            <Image 
                Aspect="AspectFill"
                Source="legal.jpg" />
            <BoxView
                Color="#A7000000" />
            <Grid
                Padding="16">
                <Button
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Text="&#xF2DE;"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Medium"
                    Padding="4"
                    BackgroundColor="#60FFFFFF"
                    Clicked="BackHomeButton_Clicked" />
                <Label
                    Text="Jurídico"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalOptions="Center"
                    FontSize="Large"
                    FontAttributes="Bold" />
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>
    <MenuFlyoutItem Text="Inicio" />
    <ShellContent
        Title="Panel de Control"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF9E7;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Operaciones" />
    <ShellContent
        Title="Resoluciones"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFD15;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Proformas de Contrato"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF00A6;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Gestión" />
    <ShellContent
        Title="Secciones"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF728;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Cláusulas"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFCA9;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Etiqutas"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF4F9;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
</Shell>