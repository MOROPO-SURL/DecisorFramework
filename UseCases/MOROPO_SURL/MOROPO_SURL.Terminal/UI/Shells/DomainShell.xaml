<?xml version="1.0" encoding="utf-8" ?>
<Shell 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:decisorframework_domain_list_pages="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Pages.List;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default"
    x:Class="MOROPO.Tool.Decisor.Terminal.UI.Shells.DomainShell"
    FlyoutBehavior="Locked">
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180">
            <Image 
                Aspect="AspectFill"
                Source="domain.jpg" />
            <BoxView
                Color="#A7000000" />
            <Grid
                Padding="16">
                <Button
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Text="&#xF2DE;"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Medium"
                    Padding="4"
                    BackgroundColor="#60FFFFFF"
                    Clicked="BackHomeButton_Clicked" />
                <Label
                    Text="Dominio"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalOptions="Center"
                    FontSize="Large"
                    FontAttributes="Bold" />
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>
    <MenuFlyoutItem Text="Inicio" />
    <ShellContent
        Title="Panel de Control"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF9E7;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Operaciones" />
    <ShellContent
        Title="Acuerdos de C/D"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF0D7;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Gestión" />
    <ShellContent
        Title="Estructuras"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF006B;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Inmuebles"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFCF1;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Vehículos"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF0E7;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Configuración" />
    <ShellContent
        Title="Tipos de Estructura"
        ContentTemplate="{DataTemplate decisorframework_domain_list_pages:StructureKindsListPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF006C;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Tipos de Inmueble"
        ContentTemplate="{DataTemplate decisorframework_domain_list_pages:PropertyKindsListPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFCF2;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Categorías de Vehículo"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFA98;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Tipos de Motorización"
        ContentTemplate="{DataTemplate decisorframework_domain_list_pages:VehicleEngineKindsListPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF1FA;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
</Shell>