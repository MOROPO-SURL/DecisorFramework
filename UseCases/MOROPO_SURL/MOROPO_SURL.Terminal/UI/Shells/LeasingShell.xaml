<?xml version="1.0" encoding="utf-8" ?>
<Shell 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:decisorframework_leasing_manage_pages="clr-namespace:MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default.Pages.Manage;assembly=MOROPO.Framework.Decisor.Leasing.Presentation.Terminal.MAUI.UI.Default"
    xmlns:decisorframework_domain_manage_pages="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Pages.Manage;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default"
    x:Class="MOROPO.Tool.Decisor.Terminal.UI.Shells.LeasingShell">
    <Shell.FlyoutBehavior>
        <OnIdiom Default="Flyout" Desktop="Locked" />
    </Shell.FlyoutBehavior>
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180">
            <Image 
                Aspect="AspectFill"
                Source="leasing.jpg" />
            <BoxView
                Color="#A7000000" />
            <Grid
                Padding="16">
                <Button
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Text="&#xF2DE;"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Medium"
                    Padding="4"
                    BackgroundColor="#60FFFFFF"
                    Clicked="BackHomeButton_Clicked" />
                <Label
                    Text="Arrendamiento"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalOptions="Center"
                    FontSize="Large"
                    FontAttributes="Bold" />
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>
    <MenuFlyoutItem Text="Inicio" />
    <ShellContent
        Title="Panel de Control"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF9E7;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Operaciones" />
    <FlyoutItem
        Title="Propuestas">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF64A;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Vehículos"
            ContentTemplate="{DataTemplate decisorframework_leasing_manage_pages:VehicleLeasePropousalsManagePage}" />
        <ShellContent
            Title="Inmuebles"
            ContentTemplate="{DataTemplate decisorframework_leasing_manage_pages:PropertyLeasePropousalsManagePage}" />
    </FlyoutItem>
    <FlyoutItem
        Title="Ofertas">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF0246;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Vehículos"
            ContentTemplate="{DataTemplate decisorframework_leasing_manage_pages:VehicleLeaseOffersManagePage}" />
        <ShellContent
            Title="Inmuebles"
            ContentTemplate="{DataTemplate decisorframework_leasing_manage_pages:PropertyLeaseOffersManagePage}" />
    </FlyoutItem>
    <ShellContent
        Title="Licitaciones"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF0032;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Contrataciones"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF01C9;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Gestión" IsEnabled="False" />
    <ShellContent
        Title="Inmuebles"
        ContentTemplate="{DataTemplate decisorframework_domain_manage_pages:PropertiesManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFCF1;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Vehículos"
        ContentTemplate="{DataTemplate decisorframework_domain_manage_pages:VehiclesManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF0E7;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
</Shell>