<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Servicing.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.ISCamaguey.Decisor.Servicing.Presentation.Terminal.MAUI"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Servicing.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.Servicing.Interop.API.Common"
    xmlns:domain_interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    xmlns:fwrk_core_interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Core.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Core.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.ISCamaguey.Decisor.Servicing.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.SampleAnalysisServiceConfigurationPage"
    x:TypeArguments="interop_common_display_models:SampleAnalysisServiceDisplayModel,interop_common_display_models:SampleAnalysisServiceDisplayModel,presentation_configuration_page_models:SampleAnalysisServiceConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:SampleAnalysisServiceConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:ValidationResultToTargetPropertyErrorMessageConverter x:Key="ValidationResultToTargetPropertyErrorMessageConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyHasErrorConverter x:Key="ValidationResultToTargetPropertyHasErrorConverter" />
            <core_ui_converters:DocumentDisplayModelToMaterialDesignFontIconTextConverter x:Key="DocumentDisplayModelToMaterialDesignFontIconTextConverter" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="4" Padding="8">
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                    <Entry Text="{Binding Name}" />
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:SampleAnalysisServiceConfigurationPageModel.NameValidableProperty}}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:SampleAnalysisServiceConfigurationPageModel.NameValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}" />
                </VerticalStackLayout>
                <FlexLayout
                    Wrap="Wrap"
                    AlignItems="Start"
                    AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tipo de Muestra" />
                        <Picker 
                            x:Name="SampleKindPicker" 
                            ItemsSource="{Binding AvailableSampleKinds}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SampleKind}"
                            SelectedIndexChanged="Picker_SelectedIndexChanged" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:SampleAnalysisServiceConfigurationPageModel.SampleKindValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:SampleAnalysisServiceConfigurationPageModel.SampleKindValidableProperty}}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descripción" />
                    <Editor Text="{Binding Description}" HeightRequest="240" />
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:SampleAnalysisServiceConfigurationPageModel.DescriptionValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:SampleAnalysisServiceConfigurationPageModel.DescriptionValidableProperty}}" />
                </VerticalStackLayout>
                <VerticalStackLayout Margin="8" Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Etapas" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="StepAgregationButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="{StaticResource Gray050}" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemsSource="{Binding Steps}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label Padding="8,8,8,0" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="interop_common_display_models:SampleAnalysisServiceStepDisplayModel">
                                        <Frame 
                                            Padding="8"
                                            Margin="0,12,0,0">
                                            <StackLayout
                                                Spacing="8"
                                                Orientation="Horizontal">
                                                <Label
                                                    HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                                    FontSize="Medium"
                                                    LineBreakMode="TailTruncation"
                                                    Text="{Binding Name}" />
                                                <Button
                                                    FontFamily="MaterialDesignIcons"
                                                    Padding="0"
                                                    FontSize="21"
                                                    Text="&#xF2FD;"
                                                    Clicked="StepDetailButton_Clicked" />
                                                <Button
                                                    FontFamily="MaterialDesignIcons" 
                                                    Padding="0"
                                                    FontSize="21"
                                                    Text="&#xF90B;"
                                                    Clicked="StepEditionButton_Clicked" />
                                                <Button
                                                    VerticalOptions="Start"
                                                    FontFamily="MaterialDesignIcons" 
                                                    Padding="0"
                                                    FontSize="21"
                                                    Text="&#xFA78;"
                                                    Clicked="StepRemotionButton_Clicked" />
                                            </StackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Documentos" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="DocumentAgregationButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="{StaticResource Gray050}" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemsSource="{Binding Documents}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label Padding="8" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="fwrk_core_interop_common_display_models:DocumentDisplayModel">
                                        <Frame 
                                            Padding="0"
                                            Margin="0,12,0,0">
                                            <StackLayout Orientation="Horizontal">
                                                <Grid
                                                    WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}"
                                                    BackgroundColor="DimGray">
                                                    <Label
                                                        HorizontalOptions="Center" VerticalOptions="Center"
                                                        Text="{Binding Converter={StaticResource DocumentDisplayModelToMaterialDesignFontIconTextConverter}}"
                                                        TextColor="White"
                                                        FontSize="80"
                                                        FontFamily="MaterialDesignIcons" />
                                                </Grid>
                                                <Grid 
                                                    HorizontalOptions="FillAndExpand"
                                                    Padding="16"
                                                    ColumnSpacing="8" RowSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <VerticalStackLayout
                                                        Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                                                        Spacing="2">
                                                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                                                        <Label Text="{Binding Name}" LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout
                                                        Grid.Column="0" Grid.Row="1"
                                                        Spacing="2">
                                                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tipo" />
                                                        <Label Text="{Binding Extension}" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout
                                                        Grid.Column="1" Grid.Row="1"
                                                        Spacing="2">
                                                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tamaño" />
                                                        <Label Text="{Binding Length, StringFormat='{0} bytes'}" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <VerticalStackLayout 
                                                    Padding="8"
                                                    Spacing="8">
                                                    <Button
                                                        Padding="0"
                                                        FontSize="21"
                                                        FontFamily="MaterialDesignIcons" 
                                                        Text="&#xF90B;"
                                                        Clicked="DocumentEditionButton_Clicked" />
                                                    <Button
                                                        VerticalOptions="Start"
                                                        Padding="0"
                                                        FontSize="21"
                                                        FontFamily="MaterialDesignIcons" 
                                                        Text="&#xFA78;"
                                                        Clicked="DocumentRemotionButton_Clicked" />
                                                </VerticalStackLayout>
                                            </StackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <BoxView 
                    Margin="8,16,8,8"
                    HeightRequest="1" 
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray100}}" />
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                        <Picker SelectedItem="{Binding Priority}" ItemsSource="{StaticResource PriorityValues}" />
                    </VerticalStackLayout>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_ui_base_pages:ConfigurationBaseContentPage>