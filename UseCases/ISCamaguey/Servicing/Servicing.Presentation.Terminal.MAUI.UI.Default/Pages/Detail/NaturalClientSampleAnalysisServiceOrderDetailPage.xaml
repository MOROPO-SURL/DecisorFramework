<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:DetailBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Servicing.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.Servicing.Interop.API.Common"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:fwrk_core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    xmlns:ffimageloading_views="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:Class="MOROPO.ISCamaguey.Decisor.Servicing.Presentation.Terminal.MAUI.UI.Default.Pages.Detail.NaturalClientSampleAnalysisServiceOrderDetailPage"
    x:TypeArguments="interop_common_display_models:NaturalClientSampleAnalysisServiceOrderDisplayModel"
    x:DataType="interop_common_display_models:NaturalClientSampleAnalysisServiceOrderDisplayModel"
    Title="Detalles de Órden de Servicio para Cliente Natural"
    BackgroundColor="Transparent"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <fwrk_core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <communitytoolkit_converters:IsNullConverter x:Key="IsNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid
                Padding="10"
                MaximumWidthRequest="600"
                VerticalOptions="Center">
                <Frame Style="{StaticResource PopupFrameStyle}">
                    <StackLayout Margin="20">
                        <Label 
                            Margin="0,0,0,20"
                            Text="Detalles"
                            FontAttributes="Bold"
                            FontSize="Medium" />
                        <Label
                            FontSize="Header"
                            Text="{Binding Id, StringFormat='# {0}'}" />
                        <Label 
                            Style="{StaticResource CaptionPropertyLabelStyle}"
                            Text="Fecha" />
                        <Label
                            Style="{StaticResource ValuePropertyLabelStyle}"
                            Text="{Binding At, StringFormat='{0:dd/MM/yyyy HH:mm}'}" />
                        <Label 
                            Style="{StaticResource CaptionPropertyLabelStyle}"
                            Text="Cliente" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border 
                                Grid.Column="0"
                                VerticalOptions="Center"
                                StrokeThickness="4"
                                StrokeLineJoin="Bevel">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="32" />
                                </Border.StrokeShape>
                                <ffimageloading_views:CachedImage
                                    WidthRequest="64" HeightRequest="64"
                                    Source="{Binding Contract.Client.Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_person_picture.jpg'}" />
                            </Border>
                            <StackLayout 
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Padding="10,0">
                                <Label
                                    ToolTipProperties.Text="{Binding Contract.Client.Contact.Identity.Name}"
                                    Text="{Binding Contract.Client.Contact.Identity.Name}"
                                    FontSize="Medium"
                                    LineBreakMode="TailTruncation" />
                                <Label
                                    IsVisible="{Binding Contract.Client.Contact.Identity.LastName, Converter={StaticResource IsNotNullConverter}}"
                                    ToolTipProperties.Text="{Binding Contract.Client.Contact.Identity.LastName}"
                                    Text="{Binding Contract.Client.Contact.Identity.LastName}"
                                    LineBreakMode="TailTruncation" />
                                <Label
                                    ToolTipProperties.Text="{Binding Contract.Client.Contact.BusinessKind.Name}"
                                    Text="{Binding Contract.Client.Contact.BusinessKind.Name}"
                                    LineBreakMode="TailTruncation" />
                            </StackLayout>
                        </Grid>
                        <Label 
                            Style="{StaticResource CaptionPropertyLabelStyle}"
                            Text="Técnica solicitada" />
                        <Label
                            Style="{StaticResource ValuePropertyLabelStyle}"
                            Text="{Binding RequestedTechnique.Name, TargetNullValue='---', FallbackValue='---'}" />
                        <Label 
                            Style="{StaticResource CaptionPropertyLabelStyle}"
                            Text="Descripción" />
                        <Label
                            Style="{StaticResource ValuePropertyLabelStyle}"
                            Text="{Binding Description}" />
                        <StackLayout
                            x:Name="OptionButtonsLayout"
                            Margin="0,20,0,0"
                            Orientation="Horizontal"
                            Spacing="20">
                            <Button 
                                IsEnabled="{Binding ExecutedAt, Converter={StaticResource IsNullConverter}}"
                                HorizontalOptions="FillAndExpand"
                                Text="Modificar"
                                Clicked="EditButton_Clicked" />
                            <Button 
                                IsEnabled="{Binding HandledAt, Converter={StaticResource IsNullConverter}}"
                                Style="{StaticResource DangerKindButtonStyle}"
                                HorizontalOptions="FillAndExpand"
                                Text="Eliminar"
                                Clicked="DeleteButton_Clicked" />
                        </StackLayout>
                    </StackLayout>
                </Frame>
                <Button
                    Style="{StaticResource DetailPageCloseButtonStyle}"
                    Clicked="DismissControl_Invoked" />
            </Grid>
        </Grid>
    </ScrollView>
</core_ui_base_pages:DetailBaseContentPage>