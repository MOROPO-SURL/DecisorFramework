<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Servicing.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.Servicing.Interop.API.Common"
    x:Class="MOROPO.ISCamaguey.Decisor.Servicing.Presentation.Terminal.MAUI.UI.Default.Views.Card.SampleAnalysisServiceDefaultCardView"
    x:DataType="interop_common_display_models:SampleAnalysisServiceDisplayModel">
    <Frame>
        <VerticalStackLayout>
            <Label 
                LineBreakMode="TailTruncation"
                FontSize="Medium"
                Text="{Binding Name}" />
            <Label 
                Margin="0,4,0,0"
                Text="Descripción"
                TextColor="DimGray"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label 
                VerticalOptions="FillAndExpand"
                LineBreakMode="TailTruncation"
                MaxLines="2"
                Text="{Binding Description, TargetNullValue='---'}" />
        </VerticalStackLayout>
    </Frame>
</ContentView>
