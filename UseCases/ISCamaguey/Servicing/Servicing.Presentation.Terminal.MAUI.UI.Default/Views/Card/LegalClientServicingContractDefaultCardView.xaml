<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Servicing.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.Servicing.Interop.API.Common"
    x:Class="MOROPO.ISCamaguey.Decisor.Servicing.Presentation.Terminal.MAUI.UI.Default.Views.Card.LegalClientServicingContractDefaultCardView"
    x:DataType="interop_common_display_models:LegalClientServicingContractDisplayModel">
    <Frame>
        <VerticalStackLayout>
            <Label FontSize="Large">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Index}" />
                        <Span Text=" / " />
                        <Span Text="{Binding Year}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label 
                Margin="0,8,0,0"
                Text="Inicio"
                TextColor="DimGray"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label
                LineBreakMode="TailTruncation"
                MaxLines="3"
                Text="{Binding StarAt, StringFormat='{0:dd/MM/yyyy}'}" />
            <Label 
                Margin="0,8,0,0"
                TextColor="DimGray"
                Text="Duración"
                FontSize="Caption"
                FontAttributes="Bold" />
            <HorizontalStackLayout>
                <Label Text="{Binding DurationUnitCount, TargetNullValue='---', FallbackValue='---'}" />
                <Label Text="{Binding DurationUnitMeasureKind}" Margin="6,0,0,0" />
            </HorizontalStackLayout>
            <Label 
                Margin="0,8,0,0"
                Text="Objeto"
                TextColor="DimGray"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label
                LineBreakMode="TailTruncation"
                MaxLines="3"
                Text="{Binding Objective}" />
        </VerticalStackLayout>
    </Frame>
</ContentView>
