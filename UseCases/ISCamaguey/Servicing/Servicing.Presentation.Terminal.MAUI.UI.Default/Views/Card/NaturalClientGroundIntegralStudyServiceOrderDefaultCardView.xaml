<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Servicing.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.Servicing.Interop.API.Common"
    xmlns:fwrk_core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.ISCamaguey.Decisor.Servicing.Presentation.Terminal.MAUI.UI.Default.Views.Card.NaturalClientGroundIntegralStudyServiceOrderDefaultCardView"
    x:DataType="interop_common_display_models:NaturalClientGroundIntegralStudyServiceOrderDisplayModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <fwrk_core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Frame>
        <VerticalStackLayout>
            <Label 
                FontSize="Large"
                Text="{Binding Id, StringFormat='# {0}'}" />
            <Label
                ToolTipProperties.Text="{Binding At, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                LineBreakMode="TailTruncation"
                Text="{Binding At, StringFormat='{0:dd/MM/yyyy HH:mm}'}" />
            <Label 
                Margin="0,8,0,0"
                TextColor="DimGray"
                Text="Servicio"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label
                ToolTipProperties.Text="{Binding Service.Name}"
                LineBreakMode="TailTruncation"
                Text="{Binding Service.Name}" />
            <Label 
                Margin="0,8,0,0"
                TextColor="DimGray"
                Text="Cliente"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border 
                    Grid.Column="0"
                    VerticalOptions="Center"
                    StrokeThickness="4"
                    StrokeLineJoin="Bevel">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32" />
                    </Border.StrokeShape>
                    <Image
                        WidthRequest="64" HeightRequest="64"
                        Source="{Binding Contract.Client.Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_person_picture.jpg'}" />
                </Border>
                <StackLayout 
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Padding="10,0">
                    <Label
                        ToolTipProperties.Text="{Binding Contract.Client.Contact.Identity.Name}"
                        Text="{Binding Contract.Client.Contact.Identity.Name}"
                        FontSize="Medium"
                        LineBreakMode="TailTruncation" />
                    <Label
                        IsVisible="{Binding Contract.Client.Contact.Identity.LastName, Converter={StaticResource IsNotNullConverter}}"
                        ToolTipProperties.Text="{Binding Contract.Client.Contact.Identity.LastName}"
                        Text="{Binding Contract.Client.Contact.Identity.LastName}"
                        LineBreakMode="TailTruncation" />
                    <Label
                        ToolTipProperties.Text="{Binding Contract.Client.Contact.BusinessKind.Name}"
                        Text="{Binding Contract.Client.Contact.BusinessKind.Name}"
                        LineBreakMode="TailTruncation" />
                </StackLayout>
            </Grid>
        </VerticalStackLayout>
    </Frame>
</ContentView>