        <VerticalStackLayout>
            <CarouselView
                x:Name="MainCarouselView"
                HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width, Converter={StaticResource MathExpressionConverter}, ConverterParameter='X * 0.5'}"
                ItemsSource="{Binding Images}"
                Loop="True"
                IsBounceEnabled="False"
                IsSwipeEnabled="False"
                IndicatorView="MainIndicatorView">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="ImageSource">
                        <Image 
                            Aspect="AspectFill"
                            Source="{Binding .}" />
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
            <IndicatorView 
                x:Name="MainIndicatorView" 
                Margin="0,16,0,0"
                InputTransparent="True" />
