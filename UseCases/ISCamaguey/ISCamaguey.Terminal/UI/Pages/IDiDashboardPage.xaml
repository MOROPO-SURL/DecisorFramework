                x:Key="BoolToColor" 
                TrueObject="#45A049"            
                FalseObject="#E65100" />
            <communitytoolkit_converters:BoolToObjectConverter 
                x:Key="IsModuleReadeyToGlyph" 
                TrueObject="&#xF790;"
                FalseObject="&#xFCC1;" />
            <communitytoolkit_converters:BoolToObjectConverter 
                x:Key="HasAnyToGlyph" 
