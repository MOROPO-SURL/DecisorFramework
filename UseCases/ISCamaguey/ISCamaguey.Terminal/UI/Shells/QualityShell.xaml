<?xml version="1.0" encoding="utf-8" ?>
<Shell 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_pages="clr-namespace:MOROPO.ISCamaguey.Decisor.Terminal.UI.Pages"
    xmlns:quality_manage_pages="clr-namespace:MOROPO.ISCamaguey.Decisor.Quality.Presentation.Terminal.MAUI.UI.Default.Pages.Manage;assembly=MOROPO.ISCamaguey.Decisor.Quality.Presentation.Terminal.MAUI.UI.Default"
    xmlns:lab_manage_pages="clr-namespace:MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI.UI.Default.Pages.Manage;assembly=MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI.UI.Default"
    xmlns:production_manage_pages="clr-namespace:MOROPO.ISCamaguey.Decisor.Production.Presentation.Terminal.MAUI.UI.Default.Pages.Manage;assembly=MOROPO.ISCamaguey.Decisor.Production.Presentation.Terminal.MAUI.UI.Default"
    x:Class="MOROPO.ISCamaguey.Decisor.Terminal.UI.Shells.QualityShell">
    <Shell.FlyoutBehavior>
        <OnIdiom Default="Flyout" Desktop="Locked" />
    </Shell.FlyoutBehavior>
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180">
            <Image 
                Aspect="AspectFill"
                Source="quality.jpg" />
            <BoxView
                Color="Black"
                Opacity="0.5" />
            <Grid
                Padding="16">
                <Button
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Text="&#xF2DE;"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Medium"
                    Padding="4"
                    BackgroundColor="#60FFFFFF"
                    Clicked="BackHomeButton_Clicked" />
                <Label
                    Text="Calidad"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalOptions="Center"
                    FontSize="Large"
                    FontAttributes="Bold" />
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>
    <MenuFlyoutItem Text="Inicio" IsEnabled="False" />
    <ShellContent
        Title="Panel de Control"
        ContentTemplate="{DataTemplate local_pages:QualityDashboardPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF9E7;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Operaciones" IsEnabled="False" />
    <FlyoutItem
        Title="Evaluaciones de Calidad">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="{StaticResource QualityCheckMaterialDesignGlyphIconId}"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Producciones"
            ContentTemplate="{DataTemplate production_manage_pages:ProductionQualityCheckQualityChecksManagePage}" />
        <ShellContent 
            Title="Análisis de Muestras"
            ContentTemplate="{DataTemplate lab_manage_pages:AnalysisQualityCheckQualityChecksManagePage}" />
        <ShellContent 
            Title="Procesamientos de Muestra"
            ContentTemplate="{DataTemplate lab_manage_pages:AssessmentQualityCheckQualityChecksManagePage}" />
    </FlyoutItem>
    <ShellContent
        Title="Certificaciones"
        ContentTemplate="{DataTemplate quality_manage_pages:CertificationManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF124;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Gestión" IsEnabled="False" />
    <ShellContent
        Title="Normas Cubanas"
        ContentTemplate="{DataTemplate quality_manage_pages:CubanStandardManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF6F8;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Normas ISO"
        ContentTemplate="{DataTemplate quality_manage_pages:IsoStandardManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF790;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
</Shell>