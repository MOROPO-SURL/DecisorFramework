<?xml version="1.0" encoding="utf-8" ?>
<Shell 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_pages="clr-namespace:MOROPO.ISCamaguey.Decisor.Terminal.UI.Pages"
    xmlns:decisor_usescase_quality_manage_pages="clr-namespace:MOROPO.ISCamaguey.Decisor.Quality.Presentation.Terminal.MAUI.UI.Default.Pages.Manage;assembly=MOROPO.ISCamaguey.Decisor.Quality.Presentation.Terminal.MAUI.UI.Default"
    x:Class="MOROPO.ISCamaguey.Decisor.Terminal.UI.Shells.QualityShell">
    <Shell.FlyoutBehavior>
        <OnIdiom Default="Flyout" Desktop="Locked" />
    </Shell.FlyoutBehavior>
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180">
            <Image 
                Aspect="AspectFill"
                Source="quality.jpg" />
            <BoxView
                BackgroundColor="Black"
                Opacity="0.5" />
            <Grid
                Padding="16">
                <Button
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Text="&#xF2DE;"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Medium"
                    Padding="4"
                    BackgroundColor="#60FFFFFF"
                    Clicked="BackHomeButton_Clicked" />
                <Label
                    Text="Calidad"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalOptions="Center"
                    FontSize="Large"
                    FontAttributes="Bold" />
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>
    <MenuFlyoutItem Text="Inicio" IsEnabled="False" />
    <ShellContent
        Title="Panel de Control"
        ContentTemplate="{DataTemplate local_pages:QualityDashboardPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF9E7;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Operaciones" IsEnabled="False" />
    <ShellContent
        Title="Revisiones de Calidad (%)"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF14C;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Certificaciones (%)"
        ContentTemplate="{DataTemplate ContentPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF124;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Gestión" IsEnabled="False" />
    <ShellContent
        Title="Normas Cubanas"
        ContentTemplate="{DataTemplate decisor_usescase_quality_manage_pages:CubanStandardManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF6F8;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Normas ISO"
        ContentTemplate="{DataTemplate decisor_usescase_quality_manage_pages:IsoStandardManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF790;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
</Shell>