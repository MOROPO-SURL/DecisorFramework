<?xml version="1.0" encoding="utf-8" ?>
<Shell 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_pages="clr-namespace:MOROPO.ISCamaguey.Decisor.Terminal.UI.Pages"
    xmlns:fwrk_commercial_manage_pages="clr-namespace:MOROPO.Framework.Decisor.Commercial.Presentation.Terminal.MAUI.UI.Default.Pages.Manage;assembly=MOROPO.Framework.Decisor.Commercial.Presentation.Terminal.MAUI.UI.Default"
    xmlns:domain_list_pages="clr-namespace:MOROPO.ISCamaguey.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Pages.List;assembly=MOROPO.ISCamaguey.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default"
    xmlns:servicing_manage_pages="clr-namespace:MOROPO.ISCamaguey.Decisor.Servicing.Presentation.Terminal.MAUI.UI.Default.Pages.Manage;assembly=MOROPO.ISCamaguey.Decisor.Servicing.Presentation.Terminal.MAUI.UI.Default"
    xmlns:servicing_list_pages="clr-namespace:MOROPO.ISCamaguey.Decisor.Servicing.Presentation.Terminal.MAUI.UI.Default.Pages.List;assembly=MOROPO.ISCamaguey.Decisor.Servicing.Presentation.Terminal.MAUI.UI.Default"
    x:Class="MOROPO.ISCamaguey.Decisor.Terminal.UI.Shells.ServicingShell">
    <Shell.FlyoutBehavior>
        <OnIdiom Default="Flyout" Desktop="Locked" />
    </Shell.FlyoutBehavior>
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180">
            <Image 
                Aspect="AspectFill"
                Source="service.jpg" />
            <BoxView
                Color="Black"
                Opacity="0.5" />
            <Grid
                Padding="16">
                <Button
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Text="&#xF2DE;"
                    FontFamily="MaterialDesignIcons"
                    FontSize="Medium"
                    Padding="4"
                    BackgroundColor="#60FFFFFF"
                    Clicked="BackHomeButton_Clicked" />
                <Label
                    Text="Servicios"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalOptions="Center"
                    FontSize="Large"
                    FontAttributes="Bold" />
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>
    <MenuFlyoutItem Text="Inicio" IsEnabled="False" />
    <ShellContent
        Title="Panel de Control"
        ContentTemplate="{DataTemplate local_pages:ServicingDashboardPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF9E7;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Órdenes" IsEnabled="False" />
    <FlyoutItem Title="Capacitación">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF88F;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Jurídicos"
            ContentTemplate="{DataTemplate servicing_manage_pages:LegalClientTrainingServiceOrdersManagePage}" />
        <ShellContent
            Title="Naturales"
            ContentTemplate="{DataTemplate servicing_manage_pages:NaturalClientTrainingServiceOrdersManagePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Procesamiento de Muestras">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF025C;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Jurídicos"
            ContentTemplate="{DataTemplate servicing_manage_pages:LegalClientSampleAnalysisServiceOrdersManagePage}" />
        <ShellContent
            Title="Naturales"
            ContentTemplate="{DataTemplate servicing_manage_pages:NaturalClientSampleAnalysisServiceOrdersManagePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Estudios Int. de Suelo">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFE49;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Jurídicos"
            ContentTemplate="{DataTemplate servicing_manage_pages:LegalClientGroundIntegralStudyServiceOrdersManagePage}" />
        <ShellContent
            Title="Naturales"
            ContentTemplate="{DataTemplate servicing_manage_pages:NaturalClientGroundIntegralStudyServiceOrdersManagePage}" />
    </FlyoutItem>
    <MenuFlyoutItem Text="Ejecusiones" IsEnabled="False" />
    <FlyoutItem Title="Capacitación">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF88F;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Jurídicos"
            ContentTemplate="{DataTemplate servicing_manage_pages:LegalClientTrainingServiceExecutionsManagePage}" />
        <ShellContent
            Title="Naturales"
            ContentTemplate="{DataTemplate servicing_manage_pages:NaturalClientTrainingServiceExecutionsManagePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Procesamiento de Muestras">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF025C;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Jurídicos"
            ContentTemplate="{DataTemplate servicing_manage_pages:LegalClientSampleAnalysisServiceExecutionsManagePage}" />
        <ShellContent
            Title="Naturales"
            ContentTemplate="{DataTemplate servicing_manage_pages:NaturalClientSampleAnalysisServiceExecutionsManagePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Estudios Int. de Suelo">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFE49;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Jurídicos"
            ContentTemplate="{DataTemplate servicing_manage_pages:LegalClientGroundIntegralStudyServiceExecutionsManagePage}" />
        <ShellContent
            Title="Naturales"
            ContentTemplate="{DataTemplate servicing_manage_pages:NaturalClientGroundIntegralStudyServiceExecutionsManagePage}" />
    </FlyoutItem>
    <MenuFlyoutItem Text="Catálogo" IsEnabled="False" />
    <ShellContent
        Title="Capacitación"
        ContentTemplate="{DataTemplate servicing_manage_pages:TrainingServicesManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF88F;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Procesamiento de Muestras"
        ContentTemplate="{DataTemplate servicing_manage_pages:SampleAnalysisServicesManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF025C;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <ShellContent
        Title="Estudios Int. de Suelo"
        ContentTemplate="{DataTemplate servicing_manage_pages:GroundIntegralStudyServicesManagePage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFE49;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
    <MenuFlyoutItem Text="Gestión" IsEnabled="False" />
    <FlyoutItem Title="Clientes">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xFAC0;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Jurídicos"
            ContentTemplate="{DataTemplate fwrk_commercial_manage_pages:LegalClientsManagePage}" />
        <ShellContent
            Title="Naturales"
            ContentTemplate="{DataTemplate fwrk_commercial_manage_pages:NaturalClientsManagePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Contratos">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF01B1;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </FlyoutItem.Icon>
        <ShellContent
            Title="Jurídicos"
            ContentTemplate="{DataTemplate servicing_list_pages:LegalClientWidthContractingStatussesListPage}" />
        <ShellContent
            Title="Naturales"
            ContentTemplate="{DataTemplate servicing_list_pages:NaturalClientWidthContractingStatussesListPage}" />
    </FlyoutItem>
    <MenuFlyoutItem Text="Configuración" IsEnabled="False" />
    <ShellContent
        Title="Tipos de Muestra"
        ContentTemplate="{DataTemplate domain_list_pages:SampleKindsListPage}">
        <ShellContent.Icon>
            <FontImageSource
                FontFamily="MaterialDesignIcons"
                Glyph="&#xF68F;"
                Color="{AppThemeBinding Light=Black, Dark=White}" />
        </ShellContent.Icon>
    </ShellContent>
</Shell>