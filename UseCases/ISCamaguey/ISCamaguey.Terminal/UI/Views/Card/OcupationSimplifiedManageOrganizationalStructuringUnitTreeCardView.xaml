<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MOROPO.ISCamaguey.Decisor.Terminal.UI.Views.Card"
    xmlns:presentation_view_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.View;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.HumanResources.Interop.API.Common"
    xmlns:core_ui_behaviors="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Behaviors;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    xmlns:ffimageloading_views="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:Class="MOROPO.ISCamaguey.Decisor.Terminal.UI.Views.Card.OcupationSimplifiedManageOrganizationalStructuringUnitTreeCardView"
    x:DataType="presentation_view_models:TreeOcupationManageOrganizationalStructuringUnitViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />
            
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <communitytoolkit_converters:IsNullConverter x:Key="IsNullConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid ColumnSpacing="0" RowSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label
            IsVisible="{Binding Parent, Converter={StaticResource IsNotNullConverter}}"
            Grid.Column="0"
            VerticalOptions="Start"
            FontSize="Large"
            FontFamily="MaterialDesignIcons"
            Text="&#xF60D;" />
        <BoxView
            IsVisible="{Binding Parent, Converter={StaticResource IsNotNullConverter}}"
            Grid.Column="1" Grid.RowSpan="2"
            WidthRequest="2"
            Color="DimGray" />
        <Frame 
            Grid.Column="2"
            Margin="8,0,0,0"
            Padding="16">
            <VerticalStackLayout Spacing="0">
                <Label
                    LineBreakMode="TailTruncation"
                    FontSize="Medium"
                    Text="{Binding Context.OrganizationalUnit.Name}"
                    ToolTipProperties.Text="{Binding Context.OrganizationalUnit.Name}" />
                <Label 
                    Style="{StaticResource CaptionFieldLabelStyle}"
                    Margin="0,8"
                    Text="Ocupaciones" />
                <CollectionView 
                    x:Name="VacantsCollectionView"
                    ItemsSource="{Binding Vacants}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="1" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Behaviors>
                        <core_ui_behaviors:AdaptableGridItemLayoutCollectionViewBehavior ItemWidth="240" ItemSpacing="8" />
                    </CollectionView.Behaviors>
                    <CollectionView.EmptyView>
                        <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="presentation_view_models:OcupationsManageVacantViewModel">
                            <Frame Padding="0">
                                <VerticalStackLayout Spacing="0">
                                    <Grid HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}">
                                        <ffimageloading_views:CachedImage 
                                            BackgroundColor="DimGray"
                                            Source="{Binding Ocupation.Employee.Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_person_picture.jpg'}" />
                                        <Grid
                                            IsVisible="{Binding Ocupation, Converter={StaticResource IsNotNullConverter}}"
                                            VerticalOptions="End"
                                            BackgroundColor="{AppThemeBinding Light=#BBDDDDDD, Dark=#A9333333}">
                                            <VerticalStackLayout Margin="8">
                                                <Label
                                                    ToolTipProperties.Text="{Binding Ocupation.Employee.Contact.Identity.Name}"
                                                    LineBreakMode="TailTruncation"
                                                    Text="{Binding Ocupation.Employee.Contact.Identity.Name}"
                                                    FontAttributes="Bold" />
                                                <Label
                                                    ToolTipProperties.Text="{Binding Ocupation.Employee.Contact.Identity.LastName}"
                                                    LineBreakMode="TailTruncation"
                                                    Text="{Binding Ocupation.Employee.Contact.Identity.LastName, TargetNullValue='---'}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Grid>
                                    <VerticalStackLayout Margin="8,8,8,12" Spacing="8">
                                        <Label
                                            HorizontalOptions="Center"
                                            ToolTipProperties.Text="{Binding WorkPosition.Name}"
                                            Text="{Binding WorkPosition.Name}"
                                            FontAttributes="Bold"
                                            LineBreakMode="TailTruncation" />
                                        <StackLayout 
                                            HorizontalOptions="Center"
                                            Orientation="Horizontal" 
                                            Spacing="8">
                                            <Button
                                                Style="{StaticResource PrimaryKindFontIconImageButtonStyle}"
                                                IsVisible="{Binding Ocupation, Converter={StaticResource IsNullConverter}}"
                                                ToolTipProperties.Text="Seleccionar contacto ..."
                                                Text="&#xF016;"
                                                Clicked="ContactPickButton_Clicked" />
                                            <Button
                                                Style="{StaticResource DangerKindFontIconImageButtonStyle}"
                                                IsVisible="{Binding Ocupation, Converter={StaticResource IsNotNullConverter}}"
                                                ToolTipProperties.Text="Liberar plaza ..."
                                                Text="&#xF015;"
                                                Clicked="RemoveOcupationButton_Clicked" />
                                            <Button
                                                Style="{StaticResource FontIconImageButtonStyle}"
                                                IsEnabled="{Binding Ocupation, Converter={StaticResource IsNotNullConverter}}"
                                                ToolTipProperties.Text="Detalles de Empleado ..."
                                                Text="&#xF2FD;"
                                                Clicked="EmployeeDetailButton_Clicked" />
                                        </StackLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label 
                    Style="{StaticResource CaptionFieldLabelStyle}"
                    VerticalOptions="End"
                    Margin="0,16,0,4"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold"
                    Text="Agregados" />
                <BoxView
                    HeightRequest="2"
                    Color="DimGray" />
                <CollectionView 
                    Margin="0,4,0,0"
                    ItemsSource="{Binding CompositionChildren}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label Padding="4,0,4,4" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <local:OcupationSimplifiedManageOrganizationalStructuringUnitLeafCardView
                                ContactPickButtonClick="ContactPickButton_Clicked"
                                RemoveOcupationButtonClick="RemoveOcupationButton_Clicked"
                                EmployeeDetailButtonClick="EmployeeDetailButton_Clicked" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Frame>
        <VerticalStackLayout
            Grid.Column="2" Grid.Row="1"
            Margin="8,0,0,0"
            Spacing="8">
            <Label 
                Style="{StaticResource CaptionFieldLabelStyle}"
                VerticalOptions="End"
                Text="Dependencias" />
            <BoxView
                HeightRequest="2"
                Color="DimGray" />
            <CollectionView ItemsSource="{Binding DependencyChildren}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Padding="4" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <local:OcupationSimplifiedManageOrganizationalStructuringUnitTreeCardView
                            ContactPickButtonClick="ContactPickButton_Clicked"
                            RemoveOcupationButtonClick="RemoveOcupationButton_Clicked"
                            EmployeeDetailButtonClick="EmployeeDetailButton_Clicked" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentView>
