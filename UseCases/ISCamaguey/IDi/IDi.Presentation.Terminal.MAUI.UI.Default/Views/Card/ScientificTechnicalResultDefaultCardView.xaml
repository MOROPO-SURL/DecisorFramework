<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.IDi.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.IDi.Interop.API.Common"
    x:Class="MOROPO.ISCamaguey.Decisor.IDi.Presentation.Terminal.MAUI.UI.Default.Views.Card.ScientificTechnicalResultDefaultCardView"
    x:DataType="interop_common_display_models:ScientificTechnicalResultDisplayModel">
    <Frame>
        <StackLayout Orientation="Vertical">
            <Label 
                VerticalOptions="FillAndExpand"
                LineBreakMode="TailTruncation"
                MaxLines="2"
                Text="{Binding Title}" />
            <Label 
                Margin="0,4,0,0"
                Text="Tipo"
                TextColor="DimGray"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label Text="{Binding Kind.Name}" />
            <Label 
                Margin="0,4,0,0"
                Text="Fecha"
                TextColor="DimGray"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label Text="{Binding At, StringFormat='{0:D}'}" />
        </StackLayout>
    </Frame>
</ContentView>
