<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.IDi.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.IDi.Interop.API.Common"
    xmlns:fwrk_core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    x:Class="MOROPO.ISCamaguey.Decisor.IDi.Presentation.Terminal.MAUI.UI.Default.Views.Card.ExternalResearcherDefaultCardView"
    x:DataType="interop_common_display_models:ExternalResearcherDisplayModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <fwrk_core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Frame Padding="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0" Grid.RowSpan="3"
                Aspect="AspectFill"
                WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}"
                Source="{Binding Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_person_picture.jpg'}" />
            <VerticalStackLayout 
                Grid.Column="1"
                Padding="10">
                <Label 
                    FontSize="Medium"
                    LineBreakMode="TailTruncation"
                    Text="{Binding Contact.Identity}" />
                <Label 
                    FontAttributes="Bold"
                    LineBreakMode="TailTruncation"
                    Text="{Binding ParticipatingOrganization.Contact.Identity.Name}" />
                <Label 
                    Margin="0,16,0,0"
                    Text="Categoría Científica"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold" />
                <Label
                    VerticalOptions="FillAndExpand"
                    LineBreakMode="TailTruncation"
                    Text="{Binding Category.Name, TargetNullValue='---', FallbackValue='---'}" />
                <Label 
                    Margin="0,6,0,0"
                    Text="Categoría Docente"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold" />
                <Label
                    VerticalOptions="FillAndExpand"
                    LineBreakMode="TailTruncation"
                    Text="{Binding TeachingCategory.Name, TargetNullValue='---', FallbackValue='---'}" />
            </VerticalStackLayout>
        </Grid>
    </Frame>
</ContentView>
