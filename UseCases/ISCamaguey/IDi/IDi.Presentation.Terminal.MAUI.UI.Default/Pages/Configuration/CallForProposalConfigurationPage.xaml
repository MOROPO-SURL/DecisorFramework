<?xml version="1.0" encoding="utf-8" ?>
<fwrk_core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_card_views="clr-namespace:MOROPO.ISCamaguey.Decisor.IDi.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.ISCamaguey.Decisor.IDi.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.ISCamaguey.Decisor.IDi.Presentation.Terminal.MAUI"
    xmlns:fwrk_core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:fwrk_core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:fwrk_core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.IDi.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.IDi.Interop.API.Common"
    xmlns:fwrk_core_interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Core.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Core.Interop.API.Common"
    xmlns:fwrk_core_presentation_behaviors="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Behaviors;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.ISCamaguey.Decisor.IDi.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.CallForProposalConfigurationPage"
    x:TypeArguments="interop_common_display_models:CallForProposalDisplayModel,interop_common_display_models:CallForProposalDisplayModel,presentation_configuration_page_models:CallForProposalConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:CallForProposalConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <fwrk_core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <fwrk_core_ui_converters:ValidationResultToTargetPropertyErrorMessageConverter x:Key="ValidationResultToTargetPropertyErrorMessageConverter" />
            <fwrk_core_ui_converters:ValidationResultToTargetPropertyHasErrorConverter x:Key="ValidationResultToTargetPropertyHasErrorConverter" />
            <fwrk_core_ui_converters:DocumentDisplayModelToMaterialDesignFontIconTextConverter x:Key="DocumentDisplayModelToMaterialDesignFontIconTextConverter" />

            <caneyframework_presentation_converters:ViewChildParentWidthToRelativeWidthConverter x:Key="ViewChildParentWidthToRelativeWidthConverter" ReferenceWidth="360" AbsoluteHorizontalSeparation="12" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="4" Padding="8">
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Título" />
                    <Entry Text="{Binding Title}" />
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:CallForProposalConfigurationPageModel.TitleValidableProperty}}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:CallForProposalConfigurationPageModel.TitleValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}" />
                </VerticalStackLayout>
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={fwrk_core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, LargeContainerColumn=8, MediumContainerColumn=10, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Financista" />
                        <ContentView                        
                            IsVisible="{Binding Financier, Converter={StaticResource IsNotNullConverter}}"
                            HeightRequest="144">
                            <local_card_views:FinancierDefaultCardView
                                BindingContext="{Binding Financier}" />
                        </ContentView>
                        <Button
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="FinancierPickButton_Clicked" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:CallForProposalConfigurationPageModel.FinancierValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:CallForProposalConfigurationPageModel.FinancierValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={fwrk_core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, LargeContainerColumn=6, MediumContainerColumn=6, SmallContainerColumn=6}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Inicia" />
                        <DatePicker Date="{Binding StartAt}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={fwrk_core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, LargeContainerColumn=6, MediumContainerColumn=6, SmallContainerColumn=6}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Concluye" />
                        <DatePicker Date="{Binding EndAt}" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:CallForProposalConfigurationPageModel.EndAtValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:CallForProposalConfigurationPageModel.EndAtValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descrición" />
                    <Editor Text="{Binding Description}" HeightRequest="120" />
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:CallForProposalConfigurationPageModel.DescriptionValidableProperty}}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:CallForProposalConfigurationPageModel.DescriptionValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}" />
                </VerticalStackLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Áreas de Investigación" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="ResearchAreaAgregationButton_Clicked" />
                            <BoxView
                                Style="{StaticResource SeparatorBoxView}"
                                Grid.ColumnSpan="2" Grid.Row="1" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemSizingStrategy="MeasureAllItems"
                                ItemsSource="{Binding ResearchAreas}">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="1" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.Behaviors>
                                    <fwrk_core_presentation_behaviors:AdaptableGridItemLayoutCollectionViewBehavior ItemWidth="360" ItemSpacing="8" />
                                </CollectionView.Behaviors>
                                <CollectionView.EmptyView>
                                    <Label Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="interop_common_display_models:ResearchAreaDisplayModel">
                                        <Frame 
                                            Padding="8" Margin="4" 
                                            HeightRequest="124">
                                            <Grid ColumnSpacing="8" RowSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackLayout 
                                                    Grid.Column="0" Grid.RowSpan="2" 
                                                    VerticalOptions="Start"
                                                    Padding="8">
                                                    <Label 
                                                        LineBreakMode="TailTruncation"
                                                        FontSize="Medium"
                                                        Text="{Binding Name}" />
                                                    <Label 
                                                        Margin="0,4,0,0"
                                                        Text="Descripción"
                                                        TextColor="DimGray"
                                                        FontSize="Caption"
                                                        FontAttributes="Bold" />
                                                    <Label 
                                                        VerticalOptions="FillAndExpand"
                                                        LineBreakMode="TailTruncation"
                                                        MaxLines="2"
                                                        Text="{Binding Description, TargetNullValue='---'}" />
                                                </StackLayout>
                                                <Button
                                                    Grid.Column="1" Grid.Row="0"
                                                    Padding="0"
                                                    FontSize="21"
                                                    FontFamily="MaterialDesignIcons"
                                                    Text="&#xF2FD;"
                                                    Clicked="ResearchAreaDetailButton_Clicked" />
                                                <Button
                                                    Grid.Column="1" Grid.Row="1" VerticalOptions="Start"
                                                    Padding="0"
                                                    FontSize="21"
                                                    FontFamily="MaterialDesignIcons"
                                                    Text="&#xFA78;"
                                                    Clicked="ResearchAreaRemotionButton_Clicked" />
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Documentos" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="DocumentAgregationButton_Clicked" />
                            <BoxView
                                Style="{StaticResource SeparatorBoxView}"
                                Grid.ColumnSpan="2" Grid.Row="1" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemSizingStrategy="MeasureAllItems"
                                ItemsSource="{Binding Documents}">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="1" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.Behaviors>
                                    <fwrk_core_presentation_behaviors:AdaptableGridItemLayoutCollectionViewBehavior ItemWidth="480" ItemSpacing="8" />
                                </CollectionView.Behaviors>
                                <CollectionView.EmptyView>
                                    <Label Padding="8" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="fwrk_core_interop_common_display_models:DocumentDisplayModel">
                                        <Frame 
                                            Padding="0"
                                            HeightRequest="128">
                                            <StackLayout Orientation="Horizontal">
                                                <Grid
                                                    WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}"
                                                    BackgroundColor="DimGray">
                                                    <Label
                                                        HorizontalOptions="Center" VerticalOptions="Center"
                                                        Text="{Binding Converter={StaticResource DocumentDisplayModelToMaterialDesignFontIconTextConverter}}"
                                                        TextColor="White"
                                                        FontSize="80"
                                                        FontFamily="MaterialDesignIcons" />
                                                </Grid>
                                                <Grid 
                                                    HorizontalOptions="FillAndExpand"
                                                    Padding="16"
                                                    ColumnSpacing="8" RowSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <VerticalStackLayout
                                                        Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                                                        Spacing="2">
                                                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                                                        <Label Text="{Binding Name}" LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout
                                                        Grid.Column="0" Grid.Row="1"
                                                        Spacing="2">
                                                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tipo" />
                                                        <Label Text="{Binding Extension}" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout
                                                        Grid.Column="1" Grid.Row="1"
                                                        Spacing="2">
                                                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tamaño" />
                                                        <Label Text="{Binding Length, StringFormat='{0} bytes'}" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <VerticalStackLayout 
                                                    Padding="8"
                                                    Spacing="8">
                                                    <Button
                                                        Padding="0"
                                                        FontSize="21"
                                                        FontFamily="MaterialDesignIcons" 
                                                        Text="&#xF90B;"
                                                        Clicked="DocumentEditionButton_Clicked" />
                                                    <Button
                                                        VerticalOptions="Start"
                                                        Padding="0"
                                                        FontSize="21"
                                                        FontFamily="MaterialDesignIcons" 
                                                        Text="&#xFA78;"
                                                        Clicked="DocumentRemotionButton_Clicked" />
                                                </VerticalStackLayout>
                                            </StackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</fwrk_core_ui_base_pages:ConfigurationBaseContentPage>