<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.ISCamaguey.Decisor.IDi.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.ISCamaguey.Decisor.IDi.Presentation.Terminal.MAUI"
    xmlns:domain_presentation_card_views="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.IDi.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.IDi.Interop.API.Common"
    xmlns:domain_interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.ISCamaguey.Decisor.IDi.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.ProgramConfigurationPage"
    x:TypeArguments="interop_common_display_models:ProgramDisplayModel,interop_common_display_models:ProgramDisplayModel,presentation_configuration_page_models:ProgramConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:ProgramConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:ValidationResultToTargetPropertyErrorMessageConverter x:Key="ValidationResultToTargetPropertyErrorMessageConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyHasErrorConverter x:Key="ValidationResultToTargetPropertyHasErrorConverter" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="4" Padding="8">
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                    <Entry Text="{Binding Name}" />
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:ProgramConfigurationPageModel.NameValidableProperty}}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:ProgramConfigurationPageModel.NameValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}" />
                </VerticalStackLayout>
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Alias (opcional)" />
                        <Entry Text="{Binding Alias}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=3, LargeContainerColumn=4, MediumContainerColumn=6}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Código" />
                        <Entry Text="{Binding Code}" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:ProgramConfigurationPageModel.CodeValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:ProgramConfigurationPageModel.CodeValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, LargeContainerColumn=6, MediumContainerColumn=10, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Organización Gestora" />
                        <ContentView                        
                            IsVisible="{Binding Manager, Converter={StaticResource IsNotNullConverter}}"
                            HeightRequest="140">
                            <domain_presentation_card_views:OrganizationContactDefaultCardView
                                BindingContext="{Binding Manager}" />
                        </ContentView>
                        <Button
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="ManagerPickButton_Clicked" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:ProgramConfigurationPageModel.ManagerValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:ProgramConfigurationPageModel.ManagerValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, LargeContainerColumn=6, MediumContainerColumn=8, SmallContainerColumn=10}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Jefe" />
                        <ContentView                        
                            IsVisible="{Binding Chief, Converter={StaticResource IsNotNullConverter}}"
                            HeightRequest="140">
                            <domain_presentation_card_views:PersonContactDefaultCardView
                                BindingContext="{Binding Chief}" />
                        </ContentView>
                        <Button
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="ChiefPickButton_Clicked" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:ProgramConfigurationPageModel.ChiefValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:ProgramConfigurationPageModel.ChiefValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout Margin="8" Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridades" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="ProgramExpectResultAgregationButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="{StaticResource Gray050}" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemsSource="{Binding ExpectResults}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label Padding="8,8,8,0" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="interop_common_display_models:ProgramExpectResultDisplayModel">
                                        <Frame 
                                            Padding="8"
                                            Margin="0,12,0,0">
                                            <StackLayout
                                                Spacing="8"
                                                Orientation="Horizontal">
                                                <Label 
                                                    Margin="8,0,0,0"
                                                    VerticalOptions="Center"
                                                    Text="No." />
                                                <Label 
                                                    VerticalOptions="Center"
                                                    Text="{Binding Index}" />
                                                <Label
                                                    HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                                    LineBreakMode="TailTruncation"
                                                    Text="{Binding Title}" />
                                                <Button
                                                    FontFamily="MaterialDesignIcons"
                                                    Padding="0"
                                                    FontSize="21"
                                                    Text="&#xF2FD;"
                                                    Clicked="ProgramExpectResultDetailButton_Clicked" />
                                                <Button
                                                    FontFamily="MaterialDesignIcons" 
                                                    Padding="0"
                                                    FontSize="21"
                                                    Text="&#xF90B;"
                                                    Clicked="ProgramExpectResultEditionButton_Clicked" />
                                                <Button
                                                    VerticalOptions="Start"
                                                    FontFamily="MaterialDesignIcons" 
                                                    Padding="0"
                                                    FontSize="21"
                                                    Text="&#xFA78;"
                                                    Clicked="ProgramExpectResultRemotionButton_Clicked" />
                                            </StackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                    <Label
                        Grid.ColumnSpan="2" Grid.Row="3"
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:ProgramConfigurationPageModel.ExpectResultsValidableProperty}}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:ProgramConfigurationPageModel.ExpectResultsValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}" />
                </VerticalStackLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descripción (Opcional)" />
                    <Editor Text="{Binding Description}" HeightRequest="180" />
                </VerticalStackLayout>
                <BoxView 
                    Margin="8,16,8,8"
                    HeightRequest="1" 
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray100}}" />
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <Grid
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        ColumnSpacing="6" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Row="0"
                            Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                        <Entry
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            IsReadOnly="True"
                            Text="{Binding Priority}" />
                        <Stepper
                            Grid.Row="1"
                            Margin="0,0,6,0"
                            HorizontalOptions="End" VerticalOptions="Center"
                            Minimum="1"
                            Maximum="100"
                            Value="{Binding Priority}" />
                    </Grid>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_ui_base_pages:ConfigurationBaseContentPage>