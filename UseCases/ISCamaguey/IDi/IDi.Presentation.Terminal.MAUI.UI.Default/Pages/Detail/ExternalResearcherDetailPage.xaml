<?xml version="1.0" encoding="utf-8" ?>
<fwrk_core_ui_base_pages:DetailBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.IDi.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.IDi.Interop.API.Common"
    xmlns:fwrk_core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    x:Class="MOROPO.ISCamaguey.Decisor.IDi.Presentation.Terminal.MAUI.UI.Default.Pages.Detail.ExternalResearcherDetailPage"
    x:TypeArguments="interop_common_display_models:ExternalResearcherDisplayModel"
    x:DataType="interop_common_display_models:ExternalResearcherDisplayModel"
    Title="Detalles de Investigador Externo"
    BackgroundColor="Transparent"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid
                Padding="10"
                MaximumWidthRequest="400"
                VerticalOptions="Center">
                <Frame Style="{StaticResource PopupFrameStyle}">
                    <StackLayout Margin="20" Spacing="20">
                        <StackLayout>
                            <Label 
                                Margin="0,0,0,20"
                                Text="Detalles"
                                FontAttributes="Bold"
                                FontSize="Medium" />
                            <Label
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Margin="0"
                                Text="Contacto" />
                            <Label
                                Style="{StaticResource ValuePropertyLabelStyle}"
                                Text="{Binding Contact.Identity}" />
                            <Label 
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Text="Categoría Científica" />
                            <Label
                                Style="{StaticResource ValuePropertyLabelStyle}"
                                Text="{Binding Category.Name, TargetNullValue='---', FallbackValue='---'}" />
                            <Label 
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Text="Categoría Docente" />
                            <Label
                                Style="{StaticResource ValuePropertyLabelStyle}"
                                Text="{Binding TeachingCategory.Name, TargetNullValue='---', FallbackValue='---'}" />
                            <Label 
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Text="Prioridad" />
                            <Label
                                Style="{StaticResource ValuePropertyLabelStyle}"
                                Text="{Binding Priority}" />
                        </StackLayout>
                        <StackLayout
                            x:Name="OptionButtonsStackLayout"
                            Orientation="Horizontal"
                            Spacing="20">
                            <Button 
                                HorizontalOptions="FillAndExpand"
                                Text="Modificar"
                                Clicked="EditButton_Clicked" />
                            <Button 
                                HorizontalOptions="FillAndExpand"
                                Text="Eliminar"
                                Clicked="DeleteButton_Clicked" />
                        </StackLayout>
                    </StackLayout>
                </Frame>
                <Button
                    Style="{StaticResource DetailPageCloseButtonStyle}"
                    Clicked="DismissControl_Invoked" />
            </Grid>
        </Grid>
    </ScrollView>
</fwrk_core_ui_base_pages:DetailBaseContentPage>