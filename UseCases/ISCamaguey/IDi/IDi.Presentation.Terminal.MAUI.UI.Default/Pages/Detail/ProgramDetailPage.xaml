<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:DetailBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.IDi.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.IDi.Interop.API.Common"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:fwrk_core_constants="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Constants;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    x:Class="MOROPO.ISCamaguey.Decisor.IDi.Presentation.Terminal.MAUI.UI.Default.Pages.Detail.ProgramDetailPage"
    x:TypeArguments="interop_common_display_models:ProgramDisplayModel"
    x:DataType="interop_common_display_models:ProgramDisplayModel"
    Title="Detalles de Programa"
    BackgroundColor="Transparent"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid
                Padding="10"
                MaximumWidthRequest="{Static fwrk_core_constants:CommonDetailPageConstants.MediumLargeDetailPageFrameWrapperWidth}"
                VerticalOptions="Center">
                <Frame Style="{StaticResource PopupFrameStyle}">
                    <VerticalStackLayout Margin="0" Spacing="0">
                        <VerticalStackLayout Margin="20,20,20,0">
                            <Label 
                                Margin="0,0,0,20"
                                Text="Detalles"
                                FontAttributes="Bold"
                                FontSize="Medium" />
                            <Label
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Margin="0"
                                Text="Nombre" />
                            <Label
                                Style="{StaticResource ValuePropertyLabelStyle}"
                                Text="{Binding Name}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Margin="12,0" Spacing="0">
                            <FlexLayout
                                Wrap="Wrap"
                                AlignItems="Start" AlignContent="Start">
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                    Margin="4">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Margin="0,12,0,0"
                                        Text="Alias" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Alias, TargetNullValue='---'}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                    Margin="4">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Margin="0,12,0,0"
                                        Text="Código" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Code}" />
                                </VerticalStackLayout>
                            </FlexLayout>
                            <FlexLayout
                                Wrap="Wrap"
                                AlignItems="Start" AlignContent="Start">
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                    Margin="4">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Margin="0,12,0,0"
                                        Text="Organización Gestora" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Manager.Identity.Name, TargetNullValue='---'}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                    Margin="4">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Margin="0,12,0,0"
                                        Text="Jefe" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Chief.Identity}" />
                                </VerticalStackLayout>
                            </FlexLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Margin="20,0">
                            <VerticalStackLayout 
                                Spacing="6">
                                <Label Style="{StaticResource CaptionPropertyLabelStyle}" Text="Prioridades" />
                                <BoxView Color="DimGray" HeightRequest="2" />
                                <VerticalStackLayout
                                    Spacing="8"
                                    BindableLayout.ItemsSource="{Binding ExpectResults}">
                                    <BindableLayout.EmptyView>
                                        <Label
                                            FontAttributes="Italic"
                                            TextColor="DimGray"
                                            Text="Sin elementos que mostrar" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="interop_common_display_models:ProgramExpectResultDisplayModel">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <BoxView
                                                    Grid.Column="0" Grid.RowSpan="2"
                                                    Color="DimGray" />
                                                <Label         
                                                    Grid.Column="1" Grid.Row="0"
                                                    FontAttributes="Bold"
                                                    Text="{Binding Index, StringFormat='No. {0}'}" />
                                                <Label         
                                                    Grid.Column="2" Grid.Row="0"
                                                    FontAttributes="Bold"
                                                    Text="{Binding Title}" />
                                                <Label                                                    
                                                    Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                                    Text="{Binding Description, FallbackValue='---', TargetNullValue='---'}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                            <Label 
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Text="Descripción" />
                            <Label
                                Style="{StaticResource ValuePropertyLabelStyle}"
                                Text="{Binding Description, TargetNullValue='---'}" />
                            <Label 
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Text="Prioridad" />
                            <Label
                                Style="{StaticResource ValuePropertyLabelStyle}"
                                Text="{Binding Priority}" />
                        </VerticalStackLayout>
                        <StackLayout
                            Orientation="Horizontal"
                            Margin="20,0,20,20" Spacing="20">
                            <Button 
                                HorizontalOptions="FillAndExpand"
                                Text="Modificar"
                                Clicked="EditButton_Clicked" />
                            <Button 
                                HorizontalOptions="FillAndExpand"
                                Text="Eliminar"
                                Clicked="DeleteButton_Clicked" />
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>
                <Button
                    Style="{StaticResource DetailPageCloseButtonStyle}"
                    Clicked="DismissControl_Invoked" />
            </Grid>
        </Grid>
    </ScrollView>
</core_ui_base_pages:DetailBaseContentPage>