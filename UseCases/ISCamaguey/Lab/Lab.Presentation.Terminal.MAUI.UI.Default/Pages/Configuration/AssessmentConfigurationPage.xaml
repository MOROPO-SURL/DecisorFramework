<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_constants="clr-namespace:MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI.UI.Default.Constants"
    xmlns:local_card_views="clr-namespace:MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:local_converters="clr-namespace:MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI.UI.Default.Converters"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI"
    xmlns:presentation_view_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI.Models.View;assembly=MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI"
    xmlns:fwrk_domain_presentation_card_views="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Lab.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.Lab.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.AssessmentConfigurationPage"
    x:TypeArguments="presentation_view_models:AssessmentDetailViewModel,presentation_view_models:AssessmentDetailViewModel,presentation_configuration_page_models:AssessmentConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:AssessmentConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <local_converters:QualityPercentDoubleToQualityStartSymbolGroupConverter x:Key="QualityPercentDoubleToQualityStartSymbolGroupConverter" />
            
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:ValidationResultToTargetPropertyErrorMessageConverter x:Key="ValidationResultToTargetPropertyErrorMessageConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyHasErrorConverter x:Key="ValidationResultToTargetPropertyHasErrorConverter" />
            <core_ui_converters:StringToLocalizedStringConverter x:Key="StringToLocalizedStringConverter" />
            <core_ui_converters:DocumentDisplayModelToMaterialDesignFontIconTextConverter x:Key="DocumentDisplayModelToMaterialDesignFontIconTextConverter" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <communitytoolkit_converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="4" Padding="8">
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, LargeContainerColumn=2, MediumContainerColumn=3, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Fecha" />
                        <DatePicker Date="{Binding At}" Format="dd/MM/yyyy" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=6, LargeContainerColumn=10, MediumContainerColumn=9, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Plan de trabajo" />
                        <ContentView                        
                            IsVisible="{Binding WorkPlan, Converter={StaticResource IsNotNullConverter}}"
                            HeightRequest="{Static local_constants:CardViewHeightConstants.WORK_PLAN_DEFAULT_CARD_VIEW_HEIGHT}">
                            <local_card_views:WorkPlanDefaultCardView
                                BindingContext="{Binding WorkPlan}" />
                        </ContentView>
                        <Button
                            IsVisible="{Binding OnEditionMode, Converter={StaticResource InvertedBoolConverter}}"
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="WorkPlanPickButton_Clicked" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:AssessmentConfigurationPageModel.WorkPlanValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:AssessmentConfigurationPageModel.WorkPlanValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, LargeContainerColumn=5, MediumContainerColumn=7, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Especialista" />
                        <ContentView                        
                            IsVisible="{Binding Author, Converter={StaticResource IsNotNullConverter}}"
                            HeightRequest="140">
                            <fwrk_domain_presentation_card_views:EmployeeDefaultCardView
                                BindingContext="{Binding Author}" />
                        </ContentView>
                        <Button
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="AuthorPickButton_Clicked" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:AssessmentConfigurationPageModel.AuthorValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:AssessmentConfigurationPageModel.AuthorValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, LargeContainerColumn=6, MediumContainerColumn=8, SmallContainerColumn=10}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Muestra" />
                        <Frame                        
                            IsVisible="{Binding Sample, Converter={StaticResource IsNotNullConverter}}"
                            HeightRequest="{Static local_constants:CardViewHeightConstants.SAMPLE_DEFAULT_CARD_VIEW_HEIGHT}">
                            <VerticalStackLayout Spacing="0">
                                <Label 
                                    LineBreakMode="TailTruncation"
                                    FontSize="Large">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Sample.Index}" />
                                            <Span Text="{Binding Sample.Year, StringFormat=' / {0}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label 
                                    Margin="0,8,0,0"
                                    LineBreakMode="TailTruncation"
                                    FontSize="Medium">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Sample.Kind.Name}" />
                                            <Span Text="{Binding Sample.Amount, StringFormat=', {0:F2}'}" />
                                            <Span Text="{Binding Sample.UnitMeasurement.Symbol, StringFormat=' {0}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label 
                                    Margin="0,12,0,0"
                                    LineBreakMode="TailTruncation"
                                    FontAttributes="Bold"
                                    Text="Origen" />
                                <Label 
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Sample.Type, Converter={StaticResource StringToLocalizedStringConverter}}" />
                            </VerticalStackLayout>
                        </Frame>
                        <Button
                            IsVisible="{Binding OnEditionMode, Converter={StaticResource InvertedBoolConverter}}"
                            IsEnabled="{Binding WorkPlan, Converter={StaticResource IsNotNullConverter}}"
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="SamplePickButton_Clicked" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:AssessmentConfigurationPageModel.SampleValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:AssessmentConfigurationPageModel.SampleValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Análisis realizados" />
                    <BoxView HeightRequest="2" Style="{StaticResource SeparatorBoxView}" />
                    <CollectionView
                        ItemsSource="{Binding Analyses}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label
                                Padding="5"
                                Text="Seleccione una muestra con análisis realizados"
                                TextColor="{AppThemeBinding Light=DimGray, Dark=Gray}"
                                FontAttributes="Italic" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="presentation_view_models:AnalysisDetailViewModel">
                                <Frame>
                                    <VerticalStackLayout>
                                        <Label 
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Target.At, StringFormat='{0:D} - {0:hh:mm tt}'}" />
                                        <Label 
                                            Margin="0,12,0,0"
                                            LineBreakMode="TailTruncation"
                                            FontAttributes="Bold"
                                            Text="Especialista" />
                                        <Label 
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Target.Author.Contact}" />
                                        <Label 
                                            Margin="0,12,0,0"
                                            LineBreakMode="TailTruncation"
                                            FontAttributes="Bold"
                                            Text="Técnica" />
                                        <Label 
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Target.Technique.Name}" />
                                        <Label 
                                            Margin="0,12,0,0"
                                            LineBreakMode="TailTruncation"
                                            FontAttributes="Bold"
                                            Text="Observaciones" />
                                        <Label Text="{Binding Target.Description}" />
                                        <Label 
                                            Margin="0,12,0,0"
                                            LineBreakMode="TailTruncation"
                                            FontAttributes="Bold"
                                            Text="Evaluaciones de Calidad" />
                                        <BoxView HeightRequest="2" Style="{StaticResource SeparatorBoxView}" />
                                        <CollectionView
                                            ItemsSource="{Binding QualityChecks}">
                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                                            </CollectionView.ItemsLayout>
                                            <CollectionView.EmptyView>
                                                <Label
                                                    Padding="5"
                                                    Text="Sin elementos que mostrar"
                                                    TextColor="{AppThemeBinding Light=DimGray, Dark=Gray}"
                                                    FontAttributes="Italic" />
                                            </CollectionView.EmptyView>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="interop_common_display_models:AnalysisQualityCheckDisplayModel">
                                                    <Frame>
                                                        <VerticalStackLayout>
                                                            <Label Text="{Binding At, StringFormat='{0:D} - {0:hh:mm tt}'}" />
                                                            <StackLayout Orientation="Horizontal" Spacing="8">
                                                                <Label 
                                                                    FontFamily="MaterialDesignIcons"
                                                                    FontSize="Medium"
                                                                    Text="{Binding QualityPercent, Converter={StaticResource QualityPercentDoubleToQualityStartSymbolGroupConverter}}" />
                                                                <Label
                                                                    VerticalOptions="Center"
                                                                    Text="{Binding QualityPercent, StringFormat='({0:F2}%)'}" />
                                                            </StackLayout>
                                                            <Label 
                                                                Margin="0,8,0,0"
                                                                LineBreakMode="TailTruncation"
                                                                FontAttributes="Bold"
                                                                Text="Especialista" />
                                                            <Label 
                                                                LineBreakMode="TailTruncation"
                                                                Text="{Binding Author.Contact}" />
                                                            <Label 
                                                                Margin="0,8,0,0"
                                                                LineBreakMode="TailTruncation"
                                                                FontAttributes="Bold"
                                                                Text="Conclusiones" />
                                                            <Label Text="{Binding Description}" />
                                                        </VerticalStackLayout>
                                                    </Frame>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:AssessmentConfigurationPageModel.AnalysesValidableProperty}}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:AssessmentConfigurationPageModel.AnalysesValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}" />
                    <BoxView HeightRequest="2" Style="{StaticResource SeparatorBoxView}" />
                </VerticalStackLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Conclusiones" />
                    <Editor Text="{Binding Description}" HeightRequest="240" />
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:AssessmentConfigurationPageModel.DescriptionValidableProperty}}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:AssessmentConfigurationPageModel.DescriptionValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}" />
                </VerticalStackLayout>
                <FlexLayout
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, ExtraLargeContainerColumn=6, LargeContainerColumn=8, MediumContainerColumn=10, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Documento" />
                        <Frame 
                            IsVisible="{Binding Document, Converter={StaticResource IsNotNullConverter}}"
                            Padding="0">
                            <StackLayout Orientation="Horizontal">
                                <Grid
                                    WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}"
                                    BackgroundColor="DimGray">
                                    <Label
                                        HorizontalOptions="Center" VerticalOptions="Center"
                                        Text="{Binding Document, Converter={StaticResource DocumentDisplayModelToMaterialDesignFontIconTextConverter}}"
                                        TextColor="White"
                                        FontSize="80"
                                        FontFamily="MaterialDesignIcons" />
                                </Grid>
                                <Grid 
                                    HorizontalOptions="FillAndExpand"
                                    Padding="16"
                                    ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <VerticalStackLayout
                                        Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                                        Spacing="2">
                                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                                        <Label Text="{Binding Document.Name}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        Grid.Column="0" Grid.Row="1"
                                        Spacing="2">
                                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tipo" />
                                        <Label Text="{Binding Document.Extension}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        Grid.Column="1" Grid.Row="1"
                                        Spacing="2">
                                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tamaño" />
                                        <Label Text="{Binding Document.Length, StringFormat='{0} bytes'}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </StackLayout>
                        </Frame>
                        <Button
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="DocumentPickButton_Clicked" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:AssessmentConfigurationPageModel.DocumentValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:AssessmentConfigurationPageModel.DocumentValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_ui_base_pages:ConfigurationBaseContentPage>