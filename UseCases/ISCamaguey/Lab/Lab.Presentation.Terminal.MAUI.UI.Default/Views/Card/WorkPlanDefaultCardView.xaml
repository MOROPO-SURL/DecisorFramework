<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Lab.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.Lab.Interop.API.Common"
    x:Class="MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI.UI.Default.Views.Card.WorkPlanDefaultCardView"
    x:DataType="interop_common_display_models:WorkPlanDisplayModel">
    <Frame>
        <VerticalStackLayout Spacing="0">
            <Label 
                LineBreakMode="TailTruncation"
                FontSize="Medium"
                Text="{Binding At, StringFormat='{0:D}'}" />
            <Label 
                Margin="0,12,0,0"
                LineBreakMode="TailTruncation"
                FontAttributes="Bold"
                Text="Grupo de Trabajo" />
            <Label
                LineBreakMode="TailTruncation"
                Text="{Binding WorkingGroup.Name}" />
        </VerticalStackLayout>
    </Frame>
</ContentView>