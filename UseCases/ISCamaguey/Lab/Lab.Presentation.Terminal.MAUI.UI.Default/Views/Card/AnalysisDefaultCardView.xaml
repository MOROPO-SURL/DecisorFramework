<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Lab.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.Lab.Interop.API.Common"
    x:Class="MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI.UI.Default.Views.Card.AnalysisDefaultCardView"
    x:DataType="interop_common_display_models:AnalysisDisplayModel">
    <Frame>
        <VerticalStackLayout Spacing="0">
            <Label 
                LineBreakMode="TailTruncation"
                FontSize="Large">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Sample.Index}" />
                        <Span Text="{Binding Sample.Year, StringFormat=' / {0}'}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label 
                Margin="0,8,0,0"
                LineBreakMode="TailTruncation"
                FontSize="Medium">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Sample.Kind.Name}" />
                        <Span Text="{Binding Sample.Amount, StringFormat=', {0:F2}'}" />
                        <Span Text="{Binding Sample.UnitMeasurement.Symbol, StringFormat=' {0}'}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label 
                Margin="0,12,0,0"
                LineBreakMode="TailTruncation"
                FontAttributes="Bold"
                Text="Técnica" />
            <Label 
                LineBreakMode="TailTruncation"
                Text="{Binding Technique.Name}" />
        </VerticalStackLayout>
    </Frame>
</ContentView>
