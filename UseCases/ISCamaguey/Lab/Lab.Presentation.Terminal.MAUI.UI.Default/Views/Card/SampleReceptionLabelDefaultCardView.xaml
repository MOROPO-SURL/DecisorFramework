<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Lab.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.Lab.Interop.API.Common"
    x:Class="MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI.UI.Default.Views.Card.SampleReceptionLabelDefaultCardView"
    x:DataType="interop_common_display_models:SampleReceptionLabelDisplayModel">
    <Frame>
        <StackLayout>
            <Label 
                ToolTipProperties.Text="{Binding Reference}"
                LineBreakMode="TailTruncation"
                FontSize="Large"
                Text="{Binding Reference}" />
        </StackLayout>
    </Frame>
</ContentView>
