<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Lab.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.Lab.Interop.API.Common"
    x:Class="MOROPO.ISCamaguey.Decisor.Lab.Presentation.Terminal.MAUI.UI.Default.Views.Card.ProductionSampleDefaultCardView"
    x:DataType="interop_common_display_models:ProductionSampleDisplayModel">
    <Frame>
        <VerticalStackLayout Spacing="0">
            <Label 
                LineBreakMode="TailTruncation"
                FontSize="Large">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Index}" />
                        <Span Text="{Binding Year, StringFormat=' / {0}'}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label 
                Margin="0,8,0,0"
                LineBreakMode="TailTruncation"
                FontSize="Medium">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding SampleKind.Name}" />
                        <Span Text="{Binding Amount, StringFormat=', {0:F2}'}" />
                        <Span Text="{Binding UnitMeasurement.Symbol, StringFormat=' {0}'}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label 
                Margin="0,12,0,0"
                LineBreakMode="TailTruncation"
                FontAttributes="Bold"
                Text="Producción" />
            <Label
                LineBreakMode="TailTruncation">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Production.Order.Elaboration.Product.Name}" />
                        <Span Text="{Binding Production.Amount, StringFormat=', {0:F2}'}" />
                        <Span Text="{Binding Production.UnitMeasurement.Symbol, StringFormat=' {0}'}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label 
                LineBreakMode="TailTruncation"
                Text="{Binding Production.At, StringFormat='{0:D}'}" />
        </VerticalStackLayout>
    </Frame>
</ContentView>