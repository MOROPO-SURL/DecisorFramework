<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:DetailBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.ISCamaguey.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.ISCamaguey.Decisor.Domain.Interop.API.Common"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    x:Class="MOROPO.ISCamaguey.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Pages.Detail.SampleKindDetailPage"
    x:TypeArguments="interop_common_display_models:SampleKindDisplayModel"
    x:DataType="interop_common_display_models:SampleKindDisplayModel"
    Title="Detalles de Tipo de Muestra"
    BackgroundColor="Transparent"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid
                Padding="10"
                MaximumWidthRequest="400"
                VerticalOptions="Center">
                <Frame Style="{StaticResource PopupFrameStyle}">
                    <StackLayout Margin="20">
                        <Label 
                            Margin="0,0,0,20"
                            Text="Detalles"
                            FontAttributes="Bold"
                            FontSize="Medium" />
                        <Label
                            Style="{StaticResource CaptionPropertyLabelStyle}"
                            Margin="0"
                            Text="Nombre" />
                        <Label
                            Style="{StaticResource ValuePropertyLabelStyle}"
                            Text="{Binding Name}" />
                        <Label 
                            Style="{StaticResource CaptionPropertyLabelStyle}"
                            Text="Prioridad" />
                        <Label
                            Style="{StaticResource ValuePropertyLabelStyle}"
                            Text="{Binding Priority}" />
                        <Label 
                            Style="{StaticResource CaptionPropertyLabelStyle}"
                            Text="Descripción" />
                        <Label
                            Style="{StaticResource ValuePropertyLabelStyle}"
                            Text="{Binding Description, TargetNullValue='---'}" />
                    </StackLayout>
                </Frame>
                <Button
                    Style="{StaticResource DetailPageCloseButtonStyle}"
                    Clicked="DismissControl_Invoked" />
            </Grid>
        </Grid>
    </ScrollView>
</core_ui_base_pages:DetailBaseContentPage>