@model MOROPO.Framework.Guama.Core.Presentation.Web.Frontend.Models.View.PaginationViewModel<MOROPO.ISCamaguey.Decisor.Servicing.Persistence.Entities.LegalClientSampleAnalysisServiceOrder, long, MOROPO.ISCamaguey.Decisor.Servicing.Presentation.Web.Backend.Models.View.Display.LegalClientSampleAnalysisServiceOrderDisplayViewModel>

@{
    const string HEADER = "Administración de Órdenes de Servicios de Procesamiento de Muestra de un Cliente Jurídico";

    ViewData["TITLE"] = ViewData["HEADER"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<i class=\"mdi mdi-desktop-mac-dashboard\"></i> Panel de Control",
            Url = Url.Action("Index", "Dashboard", new { Area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        ul.nav-tabs > li.nav-item > a.active {
            background-color: transparent;
            border-color: #dddfeb #dddfeb #f8f9fc;
        }
    </style>
}

<ul class="nav nav-pills mb-4 nav-fill">
    <li class="nav-item">
        <a class="nav-link" asp-action="Index" asp-controller="NaturalClientTrainingServiceOrders">Capacitación</a>
    </li>
    <li class="nav-item">
        <a class="nav-link active" href="#">Procesamiento de Muestra</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-action="Index" asp-controller="NaturalClientGroundIntegralStudyServiceOrders">Estudios Int. de Suelo</a>
    </li>
</ul>

<ul class="nav nav-tabs mb-4 nav-fill">
    <li class="nav-item">
        <a class="nav-link" asp-action="Index" asp-controller="NaturalClientSampleAnalysisServiceOrders">Naturales</a>
    </li>
    <li class="nav-item">
        <a class="nav-link active" href="#">Jurídicos</a>
    </li>
</ul>

<div class="clearfix"></div>

<div class="card">
    <div class="card-header">
        <h5 class="m-0 font-weight-bold text-primary">Listado de elementos</h5>
    </div>
    <div class="card-body">
        @if (Model.HasNext || Model.HasPrevious)
        {
            var paginationStart = (Model.Page - 1) * Model.Limit + 1;
            var paginationEnd = paginationStart - 1 + Model.List.Count;

            <div class="row">
                <div class="col mb-2">
                    <span style="font-weight: 600;">Mostrando página @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total de páginas</span>: @Model.MaxPageCount
                </div>
                <div class="col-auto mb-2">
                    <ul class="pagination">
                        @if (Model.HasPrevious)
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page - 1}})">&laquo;</a></li>
                        }
                        else
                        {
                            <li class="disabled page-item"><a class="page-link" href="#">&laquo;</a></li>
                        }

                        @if (Model.MaxPageCount > 5)
                        {
                            if (Model.Page > 3)
                            {
                                if (Model.MaxPageCount - Model.Page < 3)
                                {
                                    for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                                    {
                                        if (i == Model.Page)
                                        {
                                            <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                        }
                                    }
                                }
                                else
                                {
                                    for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                                    {
                                        if (i == Model.Page)
                                        {
                                            <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                        }
                                    }
                                }
                            }
                            else
                            {
                                for (var i = 1; i <= 5; i++)
                                {
                                    if (i == Model.Page)
                                    {
                                        <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                    }
                                    else
                                    {
                                        <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                    }
                                }
                            }
                        }
                        else
                        {
                            for (var i = 1; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }

                        @if (Model.HasNext)
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">&raquo;</a></li>
                        }
                        else
                        {
                            <li class="disabled page-item"><a class="page-link" href="#">&raquo;</a></li>
                        }
                    </ul>
                </div>
            </div>
        }

        <div style="border: 1px solid #DDD; border-radius: 4px;">
            <table class="table table-bordered table-striped m-0">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Servicio</th>
                        <th>Cliente</th>
                        <th class="fit">Habilitado?</th>
                        <th class="fit">Opciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.List.Count > 0)
                    {
                        foreach (var item in Model.List)
                        {
                            <tr>
                                <td style="vertical-align: middle;" title="No.">
                                    @if (item.Archived)
                                    {
                                        <span class="display-archived">@item.Id</span>
                                    }
                                    else
                                    {
                                        <span>@item.Id</span>
                                    }
                                </td>
                                <td style="vertical-align: middle;" title="Servicio">
                                    @if (item.Archived)
                                    {
                                        <span class="display-archived">@item.Service.Name</span>
                                    }
                                    else
                                    {
                                        <span>@item.Service.Name</span>
                                    }
                                </td>
                                <td style="vertical-align: middle;" title="Cliente">
                                    @if (item.Archived)
                                    {
                                        <span class="display-archived">@item.Contract.Client.Contact.Identity</span>
                                    }
                                    else
                                    {
                                        <span>@item.Contract.Client.Contact.Identity</span>
                                    }
                                </td>
                                <td style="vertical-align: middle; text-align: center;" title="Habilitado?">
                                    @if (item.Archived)
                                    {
                                        @if (item.Enabled)
                                        {
                                            <span class="mdi mdi-checkbox-marked"></span>
                                        }
                                        else
                                        {
                                            <span class="mdi mdi-checkbox-blank-outline"></span>
                                        }
                                    }
                                    else
                                    {
                                        using (Html.BeginForm(item.Enabled ? "disable" : "enable", "LegalClientSampleAnalysisServiceOrders", null, FormMethod.Post, true, null))
                                        {
                                            <input type="hidden" name="key" value="@Html.Raw(item.Id)" />

                                            <button type="submit" class="btn btn-link">
                                                @if (item.Enabled)
                                                {
                                                    <span class="mdi mdi-checkbox-marked"></span>
                                                }
                                                else
                                                {
                                                    <span class="mdi mdi-checkbox-blank-outline"></span>
                                                }
                                            </button>
                                        }
                                    }
                                </td>
                                <td class="fit" style="vertical-align: middle;">
                                    @using (Html.BeginForm(item.Archived ? "unarchive" : "archive", "LegalClientSampleAnalysisServiceOrders", null, FormMethod.Post, true, null))
                                    {
                                        <input type="hidden" name="key" value="@Html.Raw(item.Id)" />

                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-light" data-toggle="modal" data-target="#descrip-@item.Id"><span class="mdi mdi-eye"></span><span class="ml-1">Detalles</span></button>
                                            @if (!item.Archived)
                                            {
                                                <button type="submit" class="btn btn-warning" style="width: 96px;">
                                                    <span class="mdi mdi-archive"></span>
                                                    <span>Archivar</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-primary" style="width: 96px;">
                                                    <span class="mdi mdi-archive-outline"></span>
                                                    <span>Recuperar</span>
                                                </button>
                                            }
                                            <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#delete-@item.Id"><span class="mdi mdi-delete"></span><span class="ml-1">Eliminar</span></button>
                                        </div>
                                    }

                                    <div class="modal fade " id="descrip-@item.Id" tabindex="-1" role="dialog" aria-labelledby="descrip-@item.Id-label" aria-hidden="true">
                                        <div class="modal-dialog modal-lg" role="document">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title font-weight-bold text-primary" id="descrip-@item.Id-label">Detalles</h5>
                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="modal-body">
                                                    <dl class="mb-0">
                                                        <dt>Servicio</dt>
                                                        <dd>@item.Service.Name</dd>
                                                        <dt>Habilitado?</dt>
                                                        <dd>
                                                            @if (item.Enabled)
                                                            {
                                                                <span>Si</span>
                                                            }
                                                            else
                                                            {
                                                                <span>No</span>
                                                            }
                                                        </dd>
                                                        <dt>Prioridad</dt>
                                                        <dd>@item.Priority</dd>
                                                    </dl>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="modal fade" id="delete-@item.Id" tabindex="-1" role="dialog" aria-labelledby="delete-@item.Id-lable" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                @using (Html.BeginForm("delete", "LegalClientSampleAnalysisServiceOrders", new { Area = "servicing" }, FormMethod.Post, true, new { @class = "modal-content" }))
                                                {
                                                    @Html.Hidden("Id", item.Id)

                                                    <div class="modal-header">
                                                        <h5 class="modal-title font-weight-bold text-primary" id="delete-@item.Id-lable">Eliminar la Orden de Servicio de Procesamiento de Muestra de un Cliente Jurídico</h5>
                                                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="mb-0">¿ Está seguro que desea eliminar la orden de servicio seleccionado?</p>
                                                    </div>
                                                    <div class="modal-footer" style="margin-top: 0;">
                                                        <button type="submit" class="btn btn-danger">Eliminar</button>
                                                        <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

