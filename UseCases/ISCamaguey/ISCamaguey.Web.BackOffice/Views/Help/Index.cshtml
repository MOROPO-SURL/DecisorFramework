@{
    const string HEADING = "Centro de Ayuda";

    ViewData["Heading"] = HEADING;

    ViewData["Title"] = HEADING;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = $"<span class=\"mdi mdi-account-circle\" style=\"margin-right: 4px;\"></span> {HEADING}"
        }
    };

    Layout = "_Layout";
}

<div class="container">
    <div class="text-center">
        <img src="~/img/identity.png" />
        <h4 class="text-dark font-weight-bold">Instituto de Suelos Camagüey Decisor™</h4>
        <h2 class="mt-3 mb-5">@HEADING</h2>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="jumbotron text-center">
                <h3>Manual de Usuario de Operaciones</h3>
                <p>Documento en formato PDF que documenta el uso de la herramienta en su sección designada a las personas que participan en la parte operativa del funcionamiento de la entidad.</p>
                <a class="btn btn-primary" href="/files/documents/manual-usuario-operaciones.pdf">Descarcar</a>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="jumbotron text-center">
                <h3>Manual de Usuario de Adminstración</h3>
                <p>Documento en formato PDF que documenta el despliegue y uso de la herramienta por parte de los especialistas que participan en la administración del sistema informático.</p>
                <a class="btn btn-primary" href="/files/documents/manual-usuario-administracion.pdf">Descarcar</a>
            </div>
        </div>
    </div>

