                    </DataTemplate>
                </local_datatemplate_selectors:EmploymentContractTemplateSelector.AdmitionContractDataTemplate>
            </local_datatemplate_selectors:EmploymentContractTemplateSelector>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid
                Padding="10"
                MaximumWidthRequest="{Static core_constants:CommonDetailPageConstants.LargeRegularDetailPageFrameWrapperWidth}"
                VerticalOptions="Center">
                <Frame Style="{StaticResource PopupFrameStyle}">
                    <StackLayout 
                        Margin="4" Padding="8"
                        Spacing="8">
                        <FlexLayout 
                            Wrap="Wrap"
                            AlignItems="Start" AlignContent="Start">
                            <Frame
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=1, LargeContainerColumn=2, MediumContainerColumn=3, SmallContainerColumn=4}}"                        
                                Margin="4"
                                Padding="0">
                                <Image
                                    Aspect="AspectFill"
                                    HeightRequest="{Binding Source={RelativeSource AncestorType={Type Frame}}, Path=Width}"
                                    Source="{Binding Domain.Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_person_picture.jpg'}" />
                            </Frame>
                            <VerticalStackLayout
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=11, LargeContainerColumn=10, MediumContainerColumn=9, SmallContainerColumn=8}}"                        
                                Margin="4">
                                <VerticalStackLayout>
                                    <Label
                                        Margin="0"
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Text="Nombre completo" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Domain.Contact.Identity}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout>
                                    <Label
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Text="Número de identificación" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Domain.Contact.PersonalIdentificationNumber, TargetNullValue='---', FallbackValue='---'}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout>
                                    <Label
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Text="Vinculado a la entidad desde" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Domain.At, StringFormat='{0:D}'}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </FlexLayout>
                        <Frame Margin="8" Padding="0">
                            <uraniumui_material_controls:TabView>
                                <uraniumui_material_controls:TabItem Title="Ocupaciones">
                                    <uraniumui_material_controls:TabItem.ContentTemplate>
                                        <DataTemplate>
                                            <CollectionView
                                                Margin="8"
                                                ItemsSource="{Binding EmploymentContracts}"
                                                ItemTemplate="{StaticResource EmploymentContractTemplateSelector}">
                                                <CollectionView.ItemsLayout>
                                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                                                </CollectionView.ItemsLayout>
                                            </CollectionView>
                                        </DataTemplate>
                                    </uraniumui_material_controls:TabItem.ContentTemplate>
                                </uraniumui_material_controls:TabItem>
                                <uraniumui_material_controls:TabItem Title="Asistencia">
                                    <uraniumui_material_controls:TabItem.ContentTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Margin="8" Spacing="0">
                                                <StackLayout 
                                                    Padding="8"
                                                    Spacing="4"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        VerticalOptions="Center"
                                                        FontAttributes="Bold"
                                                        Text="Año:" />
                                                    <Picker
                                                        VerticalOptions="Center"
                                                        ItemsSource="{Binding AvailableYears}"
                                                        SelectedItem="{Binding DailyCheckingYear}"
                                                        SelectedIndexChanged="DailyCheckingParamPicker_SelectedIndexChanged" />
                                                    <Label
                                                        VerticalOptions="Center"
                                                        Margin="4,0,0,0"
                                                        FontAttributes="Bold"
                                                        Text="Mes:" />
                                                    <Picker
                                                        x:Name="Month"
                                                        HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                                        ItemsSource="{Binding AvailableMonths}"
                                                        ItemDisplayBinding="{Binding Converter={StaticResource IntToMonthNameStringConverter}}"
                                                        SelectedItem="{Binding DailyCheckingMonth}"
                                                        SelectedIndexChanged="DailyCheckingParamPicker_SelectedIndexChanged" />
                                                    <Button
                                                        VerticalOptions="Center"
                                                        Margin="4,0,0,0"
                                                        Padding="0"
                                                        FontSize="21"
                                                        FontFamily="MaterialDesignIcons" 
                                                        Text="&#xF453;"
                                                        Clicked="DailyCheckingParamPicker_SelectedIndexChanged" />
                                                </StackLayout>
                                                <Grid 
                                                    Margin="0,8,0,0"
                                                    ColumnSpacing="8" RowSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="32" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="1" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Label
                                                        Grid.Column="0" Grid.RowSpan="3"
                                                        VerticalOptions="Center"
                                                        HorizontalTextAlignment="Center"
                                                        FontAttributes="Bold"
                                                        Text="No." />
                                                    <Label
                                                        Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0"
                                                        HorizontalTextAlignment="Center"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation"
                                                        Text="Mañana" />
                                                    <BoxView 
                                                        Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                                        Color="DimGray" />
                                                    <Label
                                                        Grid.Column="1" Grid.Row="2"
                                                        HorizontalTextAlignment="Center"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation"
                                                        Text="Entrada" />
                                                    <Label
                                                        Grid.Column="2" Grid.Row="2"
                                                        HorizontalTextAlignment="Center"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation"
                                                        Text="Salida" />
                                                    <Label
                                                        Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="0"
                                                        HorizontalTextAlignment="Center"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation"
                                                        Text="Tarde" />
                                                    <BoxView 
                                                        Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="1"
                                                        Color="DimGray" />
                                                    <Label
                                                        Grid.Column="3" Grid.Row="2"
                                                        HorizontalTextAlignment="Center"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation"
                                                        Text="Entrada" />
                                                    <Label
                                                        Grid.Column="4" Grid.Row="2"
                                                        HorizontalTextAlignment="Center"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation"
                                                        Text="Salida" />
                                                    <Label
                                                        Grid.Column="5" Grid.ColumnSpan="2" Grid.Row="0"
                                                        HorizontalTextAlignment="Center"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation"
                                                        Text="Extra" />
                                                    <BoxView 
                                                        Grid.Column="5" Grid.ColumnSpan="2" Grid.Row="1"
                                                        Color="DimGray" />
                                                    <Label
                                                        Grid.Column="5" Grid.Row="2"
                                                        HorizontalTextAlignment="Center"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation"
                                                        Text="Entrada" />
                                                    <Label
                                                        Grid.Column="6" Grid.Row="2"
                                                        HorizontalTextAlignment="Center"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation"
                                                        Text="Salida" />
                                                </Grid>
                                                <BoxView 
                                                    Margin="0,8,0,0"
                                                    HeightRequest="1"
                                                    Color="DimGray" />
                                                <CollectionView
                                                    ItemsSource="{Binding DailyCheckings}">
                                                    <CollectionView.ItemsLayout>
                                                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                                                    </CollectionView.ItemsLayout>
                                                    <CollectionView.ItemTemplate>
                                                        <DataTemplate x:DataType="presentation_view_models:EmployeeDailyCheckingViewModel">
                                                            <VerticalStackLayout Spacing="0">
                                                                <BoxView Color="DimGray" HeightRequest="1" />
                                                                <Grid Margin="0,4" ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="32" />
                                                                        <ColumnDefinition />
                                                                        <ColumnDefinition />
                                                                        <ColumnDefinition />
                                                                        <ColumnDefinition />
                                                                        <ColumnDefinition />
                                                                        <ColumnDefinition />
                                                                        <ColumnDefinition Width="32" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Label
                                                                        Grid.Column="0"
                                                                        VerticalOptions="Center"
                                                                        HorizontalTextAlignment="Center"
                                                                        FontAttributes="Bold"
                                                                        Text="{Binding Day}" />
                                                                    <Label
                                                                        Grid.Column="1"
                                                                        VerticalOptions="Center"
                                                                        HorizontalTextAlignment="Center"
                                                                        LineBreakMode="TailTruncation"
                                                                        Text="{Binding Model.CheckIn, StringFormat='{0:hh\\:mm}'}" />
                                                                    <Label
                                                                        Grid.Column="2"
                                                                        VerticalOptions="Center"
                                                                        HorizontalTextAlignment="Center"
                                                                        LineBreakMode="TailTruncation"
                                                                        Text="{Binding Model.PartialCheckOut, StringFormat='{0:hh\\:mm}'}" />
                                                                    <Label
                                                                        Grid.Column="3"
                                                                        VerticalOptions="Center"
                                                                        HorizontalTextAlignment="Center"
                                                                        LineBreakMode="TailTruncation"
                                                                        Text="{Binding Model.PartialCheckIn, StringFormat='{0:hh\\:mm}'}" />
                                                                    <Label
                                                                        Grid.Column="4"
                                                                        VerticalOptions="Center"
                                                                        HorizontalTextAlignment="Center"
                                                                        LineBreakMode="TailTruncation"
