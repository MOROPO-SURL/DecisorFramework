                                <Label
                                    ToolTipProperties.Text="{Binding Staff.AdministrativeEntity.Identity}"
                                    LineBreakMode="TailTruncation"
                                    FontAttributes="Bold"
                                    Text="{Binding Staff.AdministrativeEntity.Identity}" />
                                <Grid 
                                    Margin="0,8,0,0"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <BoxView 
                                        Grid.Column="0"
                                        VerticalOptions="Center"
                                        HeightRequest="1" 
                                        Color="DimGray" />
                                    <Label
                                        Grid.Column="1"
                                        TextColor="DimGray"
                                        Text="Información relativa a la contratación" />
                                    <BoxView 
                                        Grid.Column="2"
                                        VerticalOptions="Center"
                                        HeightRequest="1" 
                                        Color="DimGray" />
                                </Grid>
                                <FlexLayout 
                                    Wrap="Wrap"
                                    AlignItems="Start" AlignContent="Start">
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Contracto" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Index}" />
                                                    <Span Text=" / " />
                                                    <Span Text="{Binding Year}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Inicio" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}"
                                            Text="{Binding StarAt, StringFormat='{0:dd MMM yyy}'}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Duración" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding DurationUnitCount, TargetNullValue='Indeterminada'}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding DurationUnitMeasureKind}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </FlexLayout>
                                <VerticalStackLayout Margin="8">
                                    <Label
                                        Margin="0"
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Text="Objeto" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Objective}" />
                                </VerticalStackLayout>                                
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </local_datatemplate_selectors:EmploymentContractTemplateSelector.NamingContractDataTemplate>
                <local_datatemplate_selectors:EmploymentContractTemplateSelector.AdmitionContractDataTemplate>
                    <DataTemplate x:DataType="interop_common_display_models:AdmitionEmploymentContractDisplayModel">
                        <Frame Style="{StaticResource OcupationOverviewFrameStyle}">
                            <VerticalStackLayout Padding="8">
                                <Label
                                    ToolTipProperties.Text="{Binding Vacant.WorkPosition.Name}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Vacant.WorkPosition.Name}"
                                    FontSize="Medium" />
                                <Label
                                    ToolTipProperties.Text="{Binding WorkforceOrganizationalUnit.OrganizationalStructuringUnit.OrganizationalUnit.Name}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding WorkforceOrganizationalUnit.OrganizationalStructuringUnit.OrganizationalUnit.Name}" />
                                <Label
                                    ToolTipProperties.Text="{Binding Staff.AdministrativeEntity.Identity}"
                                    LineBreakMode="TailTruncation"
                                    FontAttributes="Bold"
                                    Text="{Binding Staff.AdministrativeEntity.Identity}" />
                                <Grid 
                                    Margin="0,8,0,0"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <BoxView 
                                        Grid.Column="0"
                                        VerticalOptions="Center"
                                        HeightRequest="1" 
                                        Color="DimGray" />
                                    <Label
                                        Grid.Column="1"
                                        TextColor="DimGray"
                                        Text="Información relativa a la contratación" />
                                    <BoxView 
                                        Grid.Column="2"
                                        VerticalOptions="Center"
                                        HeightRequest="1" 
                                        Color="DimGray" />
                                </Grid>
                                <FlexLayout 
                                    Wrap="Wrap"
                                    AlignItems="Start" AlignContent="Start">
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Contracto" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Index}" />
                                                    <Span Text=" / " />
                                                    <Span Text="{Binding Year}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Inicio" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}"
                                            Text="{Binding StarAt, StringFormat='{0:dd MMM yyy}'}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Duración" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding DurationUnitCount, TargetNullValue='Indeterminada'}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding DurationUnitMeasureKind}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </FlexLayout>
                                <VerticalStackLayout Margin="8">
                                    <Label
                                        Margin="0"
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
