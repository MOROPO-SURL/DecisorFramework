<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:DetailBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.HumanResources.Interop.API.Common"
    xmlns:presentation_detail_page_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.Page.Detail;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:presentation_view_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.View;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:local_datatemplate_selectors="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Views.Template.Selector"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_constants="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Constants;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:uraniumui_material_controls="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material"
    x:Class="MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Pages.Detail.EmployeeDetailPage"
    x:TypeArguments="presentation_detail_page_models:EmployeeDetailPageModel"
    x:DataType="presentation_detail_page_models:EmployeeDetailPageModel"
    Title="Detalles de Empleado"
    BackgroundColor="Transparent"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:IntToMonthNameStringConverter x:Key="IntToMonthNameStringConverter" />
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />

            <Style TargetType="Frame" x:Key="OcupationOverviewFrameStyle">
                <Setter Property="Padding" Value="4" />
            </Style>

            <local_datatemplate_selectors:EmploymentContractTemplateSelector x:Key="EmploymentContractTemplateSelector">
                <local_datatemplate_selectors:EmploymentContractTemplateSelector.DesignationContractDataTemplate>
                    <DataTemplate x:DataType="interop_common_display_models:DesignationEmploymentContractDisplayModel">
                        <Frame Style="{StaticResource OcupationOverviewFrameStyle}">
                            <VerticalStackLayout Padding="8">
                                <Label
                                    ToolTipProperties.Text="{Binding Vacant.WorkPosition.Name}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Vacant.WorkPosition.Name}"
                                    FontSize="Medium" />
                                <Label
                                    ToolTipProperties.Text="{Binding WorkforceOrganizationalUnit.OrganizationalStructuringUnit.OrganizationalUnit.Name}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding WorkforceOrganizationalUnit.OrganizationalStructuringUnit.OrganizationalUnit.Name}" />
                                <Label
                                    ToolTipProperties.Text="{Binding Staff.AdministrativeEntity.Identity}"
                                    LineBreakMode="TailTruncation"
                                    FontAttributes="Bold"
                                    Text="{Binding Staff.AdministrativeEntity.Identity}" />
                                <Grid 
                                    Margin="0,8,0,0"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <BoxView 
                                        Grid.Column="0"
                                        VerticalOptions="Center"
                                        HeightRequest="1" 
                                        Color="DimGray" />
                                    <Label
                                        Grid.Column="1"
                                        TextColor="DimGray"
                                        Text="Información relativa a la contratación" />
                                    <BoxView 
                                        Grid.Column="2"
                                        VerticalOptions="Center"
                                        HeightRequest="1" 
                                        Color="DimGray" />
                                </Grid>
                                <FlexLayout 
                                    Wrap="Wrap"
                                    AlignItems="Start" AlignContent="Start">
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Contracto" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Index}" />
                                                    <Span Text=" / " />
                                                    <Span Text="{Binding Year}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Inicio" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}"
                                            Text="{Binding StarAt, StringFormat='{0:dd MMM yyy}'}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Duración" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding DurationUnitCount, TargetNullValue='Indeterminada'}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding DurationUnitMeasureKind}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </FlexLayout>
                                <VerticalStackLayout Margin="8">
                                    <Label
                                        Margin="0"
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Text="Objeto" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Objective}" />
                                </VerticalStackLayout>                                
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </local_datatemplate_selectors:EmploymentContractTemplateSelector.DesignationContractDataTemplate>
                <local_datatemplate_selectors:EmploymentContractTemplateSelector.NamingContractDataTemplate>
