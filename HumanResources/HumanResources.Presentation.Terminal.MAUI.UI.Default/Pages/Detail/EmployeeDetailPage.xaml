<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:DetailBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.HumanResources.Interop.API.Common"
    xmlns:presentation_view_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.View;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:local_datatemplate_selectors="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Views.Template.Selector"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    x:Class="MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Pages.Detail.EmployeeDetailPage"
    x:TypeArguments="presentation_view_models:EmployeeViewModel"
    x:DataType="presentation_view_models:EmployeeViewModel"
    Title="Detalles de Empleado"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />

            <Style TargetType="Frame" x:Key="OcupationOverviewFrameStyle">
                <Setter Property="WidthRequest" Value="480" />
                <Setter Property="Padding" Value="4" />
            </Style>

            <local_datatemplate_selectors:EmploymentContractTemplateSelector x:Key="EmploymentContractTemplateSelector">
                <local_datatemplate_selectors:EmploymentContractTemplateSelector.NamingContractDataTemplate>
                    <DataTemplate x:DataType="interop_common_display_models:NamingEmploymentContractDisplayModel">
                        <Frame Style="{StaticResource OcupationOverviewFrameStyle}">
                            <VerticalStackLayout Padding="8">
                                <Label
                                    ToolTipProperties.Text="{Binding Vacant.WorkPosition.Name}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Vacant.WorkPosition.Name}"
                                    FontSize="Medium" />
                                <Label
                                    ToolTipProperties.Text="{Binding WorkforceOrganizationalUnity.OrganizationalUnity.Name}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding WorkforceOrganizationalUnity.OrganizationalUnity.Name}" />
                                <Label
                                    ToolTipProperties.Text="{Binding Staff.Structure.Identity}"
                                    LineBreakMode="TailTruncation"
                                    FontAttributes="Bold"
                                    Text="{Binding Staff.Structure.Identity}" />
                                <Grid 
                                    Margin="0,8,0,0"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <BoxView 
                                        Grid.Column="0"
                                        VerticalOptions="Center"
                                        HeightRequest="1" 
                                        Color="DimGray" />
                                    <Label
                                        Grid.Column="1"
                                        TextColor="DimGray"
                                        Text="Información relativa a la contratación" />
                                    <BoxView 
                                        Grid.Column="2"
                                        VerticalOptions="Center"
                                        HeightRequest="1" 
                                        Color="DimGray" />
                                </Grid>
                                <FlexLayout 
                                    Wrap="Wrap"
                                    AlignItems="Start" AlignContent="Start">
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Contracto" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Id}" />
                                                    <Span Text=" / " />
                                                    <Span Text="{Binding Year}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Inicio" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}"
                                            Text="{Binding StarAt, StringFormat='{0:dd MMM yyy}'}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Duración" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding DurationUnitCount, TargetNullValue='Indeterminada'}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding DurationUnitMeasureKind}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </FlexLayout>
                                <VerticalStackLayout Margin="8">
                                    <Label
                                        Margin="0"
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Text="Objeto" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Objective}" />
                                </VerticalStackLayout>                                
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </local_datatemplate_selectors:EmploymentContractTemplateSelector.NamingContractDataTemplate>
                <local_datatemplate_selectors:EmploymentContractTemplateSelector.AdmitionContractDataTemplate>
                    <DataTemplate x:DataType="interop_common_display_models:AdmitionEmploymentContractDisplayModel">
                        <Frame Style="{StaticResource OcupationOverviewFrameStyle}">
                            <VerticalStackLayout Padding="8">
                                <Label
                                    ToolTipProperties.Text="{Binding Vacant.WorkPosition.Name}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Vacant.WorkPosition.Name}"
                                    FontSize="Medium" />
                                <Label
                                    ToolTipProperties.Text="{Binding WorkforceOrganizationalUnity.OrganizationalUnity.Name}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding WorkforceOrganizationalUnity.OrganizationalUnity.Name}" />
                                <Label
                                    ToolTipProperties.Text="{Binding Staff.Structure.Identity}"
                                    LineBreakMode="TailTruncation"
                                    FontAttributes="Bold"
                                    Text="{Binding Staff.Structure.Identity}" />
                                <Grid 
                                    Margin="0,8,0,0"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <BoxView 
                                        Grid.Column="0"
                                        VerticalOptions="Center"
                                        HeightRequest="1" 
                                        Color="DimGray" />
                                    <Label
                                        Grid.Column="1"
                                        TextColor="DimGray"
                                        Text="Información relativa a la contratación" />
                                    <BoxView 
                                        Grid.Column="2"
                                        VerticalOptions="Center"
                                        HeightRequest="1" 
                                        Color="DimGray" />
                                </Grid>
                                <FlexLayout 
                                    Wrap="Wrap"
                                    AlignItems="Start" AlignContent="Start">
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Contracto" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Id}" />
                                                    <Span Text=" / " />
                                                    <Span Text="{Binding Year}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Inicio" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}"
                                            Text="{Binding StarAt, StringFormat='{0:dd MMM yyy}'}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel SmallContainerColumn=4}}"                        
                                        Margin="4">
                                        <Label
                                            Margin="0"
                                            Style="{StaticResource CaptionPropertyLabelStyle}"
                                            Text="Duración" />
                                        <Label
                                            Style="{StaticResource ValuePropertyLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding DurationUnitCount, TargetNullValue='Indeterminada'}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding DurationUnitMeasureKind}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </FlexLayout>
                                <VerticalStackLayout Margin="8">
                                    <Label
                                        Margin="0"
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Text="Objeto" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Objective}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </local_datatemplate_selectors:EmploymentContractTemplateSelector.AdmitionContractDataTemplate>
            </local_datatemplate_selectors:EmploymentContractTemplateSelector>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView Orientation="Vertical">
        <Grid>
            <Frame
                Style="{StaticResource PopupFrameStyle}"
                WidthRequest="640">
                <Grid>
                    <StackLayout 
                        Margin="20" Padding="8"
                        Spacing="0">
                        <FlexLayout 
                            Wrap="Wrap"
                            AlignItems="Start" AlignContent="Start">
                            <Frame
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"                        
                                Margin="4"
                                Padding="0">
                                <Image
                                    Aspect="AspectFill"
                                    HeightRequest="{Binding Source={RelativeSource AncestorType={Type Frame}}, Path=Width}"
                                    Source="{Binding Domain.Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_person_picture.jpg'}" />
                            </Frame>
                            <VerticalStackLayout
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=10, ExtraLargeContainerColumn=10, LargeContainerColumn=9, MediumContainerColumn=8, SmallContainerColumn=6}}"                        
                                Margin="4">
                                <VerticalStackLayout>
                                    <Label
                                        Margin="0"
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Text="Nombre completo" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Domain.Contact.Identity}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout>
                                    <Label
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Text="Número de identificación" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Domain.Contact.PersonalIdentificationNumber}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout>
                                    <Label
                                        Style="{StaticResource CaptionPropertyLabelStyle}"
                                        Text="Vinculado a la entidad desde" />
                                    <Label
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Domain.At, StringFormat='{0:D}'}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </FlexLayout>
                        <VerticalStackLayout>
                            <Label
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Text="Ocupaciones" />
                            <ScrollView Orientation="Horizontal">
                                <FlexLayout
                                    Padding="8"
                                    BindableLayout.ItemsSource="{Binding EmploymentContracts}"
                                    BindableLayout.ItemTemplateSelector="{StaticResource EmploymentContractTemplateSelector}" />
                            </ScrollView>
                        </VerticalStackLayout>                        
                    </StackLayout>
                    <Button
                        HorizontalOptions="End" VerticalOptions="Start"
                        Padding="10"
                        BackgroundColor="Transparent"
                        Text="&#xf5ad;"
                        TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                        FontSize="Medium"
                        FontFamily="MaterialDesignIcons"
                        BorderWidth="0"
                        WidthRequest="48" HeightRequest="48"
                        Clicked="DismissControl_Invoked" />
                </Grid>
            </Frame>
        </Grid>
    </ScrollView>
</core_ui_base_pages:DetailBaseContentPage>