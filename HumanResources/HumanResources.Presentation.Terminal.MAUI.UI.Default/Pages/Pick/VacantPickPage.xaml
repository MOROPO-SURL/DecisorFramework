<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_card_views="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:presentation_manage_page_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.Page.Manage;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Pages.Pick.VacantPickPage"
    x:DataType="presentation_manage_page_models:OcupationsManagePageModel"
    Title="Seleccionar Vacante">
    <ContentPage.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="ReloadToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF450;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="0" Padding="8">
                <VerticalStackLayout 
                    Margin="4"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Entidad Administrativa" />
                    <Picker 
                        x:Name="StaffPicker" 
                        ItemsSource="{Binding AvailableStaffs}"
                        ItemDisplayBinding="{Binding Path=Structure.Identity.Name}"
                        SelectedIndexChanged="StaffPicker_SelectedIndexChanged" />
                </VerticalStackLayout>
                <Label 
                    Style="{StaticResource CaptionFieldLabelStyle}"
                    Margin="8,16,8,0"
                    Text="Máxima autoridad" />
                <Frame 
                    HorizontalOptions="Start"
                    Margin="8" Padding="0"
                    IsVisible="{Binding RootChiefVacant, Converter={StaticResource IsNotNullConverter}}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="RootChiefVacantTapGestureRecognizer_Tapped" />
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="0">
                        <Image 
                            WidthRequest="240" HeightRequest="240"
                            BackgroundColor="DimGray"
                            Source="default_person_picture.jpg" />
                        <VerticalStackLayout Margin="8,8,8,12" Spacing="8">
                            <Label
                                HorizontalOptions="Center"
                                ToolTipProperties.Text="{Binding RootChiefVacant.WorkPosition.Name}"
                                Text="{Binding RootChiefVacant.WorkPosition.Name}"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>
                <VerticalStackLayout>
                    <Label 
                        Style="{StaticResource CaptionFieldLabelStyle}" 
                        Margin="8,8,8,0" 
                        Text="Unidades Organizativas" />
                    <BoxView Color="DimGray" Margin="8,4,8,8" HeightRequest="1" />
                    <CollectionView ItemsSource="{Binding Items}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label Text="Seleccione una entidad administrativa ..." FontAttributes="Italic" TextColor="DimGray" Padding="8,4" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <local_card_views:VacantPickOrganizationalUnityCardView 
                                    Padding="8,4"
                                    ItemTapped="ItemTapGestureRecognizer_Tapped" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</caneyframework_mvvm_pages:ContentPage>