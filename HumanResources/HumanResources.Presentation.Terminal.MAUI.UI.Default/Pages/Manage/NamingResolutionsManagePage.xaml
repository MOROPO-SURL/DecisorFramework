<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.HumanResources.Interop.API.Common"
    xmlns:presentation_manage_page_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.Page.Manage;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Pages.Manage.NamingResolutionsManagePage"
    x:DataType="presentation_manage_page_models:NamingResolutionsManagePageModel"
    Title="Gestión de Resoluciones de Nombramiento">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />
            
            <caneyframework_presentation_converters:ViewChildParentWidthToRelativeWidthConverter x:Key="ItemViewChildParentWidthToRelativeWidthConverter" ReferenceWidth="360" AbsoluteHorizontalSeparation="20" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />

            <Style TargetType="Label" x:Key="CaptionFieldLabelStyle">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=DimGray, Dark=Gray}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="Caption" />
                <Setter Property="Margin" Value="0,16,0,0" />
            </Style>
            <Style TargetType="Label" x:Key="ValueFieldLabelStyle">
                <Setter Property="FontSize" Value="Default" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Agregar"
            Clicked="AddToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf415;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="ReloadToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF450;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <StackLayout Orientation="Vertical">
                <SearchBar Margin="20,20,20,0" />
                <ScrollView 
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand">
                    <FlexLayout
                        Margin="10"
                        Wrap="Wrap"
                        AlignItems="Start" AlignContent="Start"
                        BindableLayout.ItemsSource="{Binding Items}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    x:DataType="interop_common_display_models:NamingResolutionDisplayModel"
                                    Margin="5"
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource ItemViewChildParentWidthToRelativeWidthConverter}}"
                                    HeightRequest="240">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ItemTapGestureRecognizer_Tapped" />
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout Spacing="10">
                                        <Label FontSize="Large">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Id}" />
                                                    <Span Text=" / " />
                                                    <Span Text="{Binding At, StringFormat='{0:yyyy}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Border 
                                                Grid.Column="0"
                                                VerticalOptions="Center"
                                                StrokeThickness="2"
                                                StrokeLineJoin="Bevel">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="30" />
                                                </Border.StrokeShape>
                                                <Image                                                
                                                    WidthRequest="60" HeightRequest="60"
                                                    Source="{Binding NamedEmployee.Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_person_picture.jpg'}" />
                                            </Border>
                                            <StackLayout 
                                                Grid.Column="1"
                                                Padding="10">
                                                <Label
                                                    Text="{Binding NamedEmployee.Contact.Identity.Name}"
                                                    FontSize="Medium"
                                                    LineBreakMode="TailTruncation" />
                                                <Label
                                                    Text="{Binding NamedEmployee.Contact.Identity.LastName}"
                                                    LineBreakMode="TailTruncation" />
                                            </StackLayout>
                                        </Grid>
                                        <Label
                                            Text="{Binding Summary}"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="3" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                        <BindableLayout.EmptyView>
                            <Label
                                HorizontalTextAlignment="Center"
                                Margin="5"
                                Text="Sin elementos que mostrar"
                                TextColor="{AppThemeBinding Light=DimGray, Dark=Gray}"
                                FontAttributes="Italic" />
                        </BindableLayout.EmptyView>
                    </FlexLayout>
                </ScrollView>
            </StackLayout>
            <ContentView 
                IsVisible="{Binding PresentedItem, Converter={StaticResource IsNotNullConverter}}"
                BackgroundColor="#A9000000">
                <ScrollView Orientation="Vertical">
                    <Grid>
                        <Frame
                            VerticalOptions="Center" HorizontalOptions="Center"
                            Padding="0" Margin="20"
                            WidthRequest="400">
                            <Grid>
                                <StackLayout Margin="20" Spacing="20">
                                    <StackLayout>
                                        <Label 
                                            Margin="0,0,0,20"
                                            Text="Detalles"
                                            FontAttributes="Bold"
                                            FontSize="Medium" />
                                        <Label
                                            Style="{StaticResource CaptionFieldLabelStyle}"
                                            Margin="0"
                                            Text="No. Consecutivo" />
                                        <Label
                                            Style="{StaticResource ValueFieldLabelStyle}"
                                            Text="{Binding PresentedItem.Id}" />
                                        <Label 
                                            Style="{StaticResource CaptionFieldLabelStyle}"
                                            Text="Emitida" />
                                        <Label
                                            Style="{StaticResource ValueFieldLabelStyle}"
                                            Text="{Binding PresentedItem.At, StringFormat='{0: dddd dd, MMMM, yyyy}'}" />
                                        <Label 
                                            Style="{StaticResource CaptionFieldLabelStyle}"
                                            Text="Resumen" />
                                        <Label
                                            Style="{StaticResource ValueFieldLabelStyle}"
                                            Text="{Binding PresentedItem.Summary, TargetNullValue='---'}" />
                                    </StackLayout>
                                    <StackLayout
                                        Orientation="Horizontal"
                                        Spacing="20">
                                        <Button 
                                            HorizontalOptions="FillAndExpand"
                                            Text="Modificar"
                                            Clicked="PresentedItemEditButton_Clicked" />
                                        <Button 
                                            HorizontalOptions="FillAndExpand"
                                            Text="Eliminar"
                                            Clicked="PresentedItemRemoveButton_Clicked" />
                                    </StackLayout>
                                </StackLayout>
                                <Button
                                    HorizontalOptions="End" VerticalOptions="Start"
                                    Padding="10"
                                    BackgroundColor="Transparent"
                                    Text="&#xf5ad;"
                                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                    FontSize="Medium"
                                    FontFamily="MaterialDesignIcons"
                                    BorderWidth="0"
                                    WidthRequest="48" HeightRequest="48"
                                    Clicked="PresentedItemDismissButton_Clicked" />
                            </Grid>
                        </Frame>
                    </Grid>
                </ScrollView>
            </ContentView>
            <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
        </Grid>
    </ContentPage.Content>
</caneyframework_mvvm_pages:ContentPage>