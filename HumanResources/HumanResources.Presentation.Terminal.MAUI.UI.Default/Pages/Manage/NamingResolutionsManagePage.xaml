<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ManageBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Pages.Manage"
    xmlns:local_datatemplate_selectors="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Views.Template.Selector"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.HumanResources.Interop.API.Common"
    xmlns:presentation_manage_page_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.Page.Manage;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Pages.Manage.NamingResolutionsManagePage"
    x:TypeArguments="interop_common_display_models:NamingResolutionDisplayModel,presentation_manage_page_models:NamingResolutionsManagePageModel,presentation_configuration_page_models:NamingResolutionConfigurationPageModel"
    x:DataType="presentation_manage_page_models:NamingResolutionsManagePageModel"
    Title="Gestión de Candidatos a Admisión">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />

            <communitytoolkit_converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />

            <local_datatemplate_selectors:NamingResolutionTemplateSelector x:Key="NamingResolutionTemplateSelector">
                <local_datatemplate_selectors:NamingResolutionTemplateSelector.DirectNamingResolutionDataTemplate>
                    <DataTemplate x:DataType="interop_common_display_models:NamingResolutionDisplayModel">
                        <Frame HeightRequest="{Static local:NamingResolutionsManagePage.ITEM_VIEW_REQUEST_HEIGHT}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ItemTapGestureRecognizer_Tapped" />
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Label FontSize="Large">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Index}" />
                                            <Span Text=" / " />
                                            <Span Text="{Binding Year}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border 
                                        Grid.Column="0"
                                        VerticalOptions="Center"
                                        StrokeThickness="4"
                                        StrokeLineJoin="Bevel">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="48" />
                                        </Border.StrokeShape>
                                        <Image
                                            WidthRequest="96" HeightRequest="96"
                                            Source="{Binding Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_person_picture.jpg'}" />
                                    </Border>
                                    <StackLayout 
                                        Grid.Column="1"
                                        Padding="10">
                                        <Label
                                            ToolTipProperties.Text="{Binding Contact.Identity.Name}"
                                            Text="{Binding Contact.Identity.Name}"
                                            FontSize="Medium"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            ToolTipProperties.Text="{Binding Contact.Identity.LastName}"
                                            Text="{Binding Contact.Identity.LastName}"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Margin="0,8,0,0"
                                            ToolTipProperties.Text="{Binding Vacant.WorkPosition.Name}"
                                            Text="{Binding Vacant.WorkPosition.Name}"
                                            FontAttributes="Bold"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            ToolTipProperties.Text="{Binding Staff.Structure.Identity.Name}"
                                            Text="{Binding Staff.Structure.Identity.Name}"
                                            LineBreakMode="TailTruncation" />
                                    </StackLayout>
                                </Grid>
                                <Label
                                    Text="{Binding Summary}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="3" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </local_datatemplate_selectors:NamingResolutionTemplateSelector.DirectNamingResolutionDataTemplate>
                <local_datatemplate_selectors:NamingResolutionTemplateSelector.CandidateNamingResolutionDataTemplate>
                    <DataTemplate x:DataType="interop_common_display_models:NamingResolutionDisplayModel">
                        <Frame HeightRequest="{Static local:NamingResolutionsManagePage.ITEM_VIEW_REQUEST_HEIGHT}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ItemTapGestureRecognizer_Tapped" />
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Label FontSize="Large">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Index}" />
                                            <Span Text=" / " />
                                            <Span Text="{Binding Year}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border 
                                        Grid.Column="0"
                                        VerticalOptions="Center"
                                        StrokeThickness="4"
                                        StrokeLineJoin="Bevel">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="48" />
                                        </Border.StrokeShape>
                                        <Image
                                            WidthRequest="96" HeightRequest="96"
                                            Source="{Binding Candidate.Postulation.Contact.Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_person_picture.jpg'}" />
                                    </Border>
                                    <StackLayout 
                                        Grid.Column="1"
                                        Padding="10">
                                        <Label
                                            ToolTipProperties.Text="{Binding Candidate.Postulation.Contact.Identity.Name}"
                                            Text="{Binding Candidate.Postulation.Contact.Identity.Name}"
                                            FontSize="Medium"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            ToolTipProperties.Text="{Binding Candidate.Postulation.Contact.Identity.LastName}"
                                            Text="{Binding Candidate.Postulation.Contact.Identity.LastName}"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Margin="0,8,0,0"
                                            ToolTipProperties.Text="{Binding Vacant.WorkPosition.Name}"
                                            Text="{Binding Candidate.Postulation.Vacant.WorkPosition.Name}"
                                            FontAttributes="Bold"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            ToolTipProperties.Text="{Binding Staff.Structure.Identity.Name}"
                                            Text="{Binding Candidate.Postulation.Staff.Structure.Identity.Name}"
                                            LineBreakMode="TailTruncation" />
                                    </StackLayout>
                                </Grid>
                                <Label
                                    Text="{Binding Summary}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="3" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </local_datatemplate_selectors:NamingResolutionTemplateSelector.CandidateNamingResolutionDataTemplate>
            </local_datatemplate_selectors:NamingResolutionTemplateSelector>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Agregar"
            Clicked="AddItemToolbarItems_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf415;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="ReloadToolbarItems_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF450;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <StackLayout Orientation="Vertical">
                <SearchBar Margin="20,20,20,0" />
                <Grid 
                    VerticalOptions="FillAndExpand"
                    SizeChanged="ItemsCollectionViewLayout_SizeChanged">
                    <CollectionView
                        x:Name="ItemsCollectionView"
                        Margin="10"
                        ItemsSource="{Binding Items}"
                        ItemTemplate="{StaticResource NamingResolutionTemplateSelector}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label
                                IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                HorizontalTextAlignment="Center"
                                Margin="5"
                                Text="Sin elementos que mostrar"
                                TextColor="{AppThemeBinding Light=DimGray, Dark=Gray}"
                                FontAttributes="Italic" />
                        </CollectionView.EmptyView>
                        <CollectionView.Footer>
                            <StackLayout IsVisible="{Binding HasMoreItems}">
                                <Button
                                HorizontalOptions="Center"
                                Margin="5"
                                Text="Mostrar más"
                                Clicked="LoadMoreBurron_Clicked" />
                            </StackLayout>
                        </CollectionView.Footer>
                    </CollectionView>
                </Grid>
            </StackLayout>
            <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
        </Grid>
    </ContentPage.Content>
</core_ui_base_pages:ManageBaseContentPage>