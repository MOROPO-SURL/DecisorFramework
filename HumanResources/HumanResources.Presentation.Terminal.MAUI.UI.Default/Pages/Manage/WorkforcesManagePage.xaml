<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.HumanResources.Interop.API.Common"
    xmlns:presentation_manage_page_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.Page.Manage;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:fwrk_core_behaviors="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Behaviors;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Pages.Manage.WorkforcesManagePage"
    x:DataType="presentation_manage_page_models:WorkforcesManagePageModel"
    Title="Gestión de Estructuras de Plantilla">
    <ContentPage.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />

            <Style TargetType="Label" x:Key="CaptionFieldLabelStyle">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=DimGray, Dark=Gray}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="Caption" />
                <Setter Property="Margin" Value="0,16,0,0" />
            </Style>
            <Style TargetType="Label" x:Key="ValueFieldLabelStyle">
                <Setter Property="FontSize" Value="Default" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Agregar"
            Clicked="AddToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf415;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="ReloadToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF450;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <StackLayout Orientation="Vertical">
                <ScrollView 
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand">
                    <CollectionView
                        Margin="10"
                        ItemsSource="{Binding Items}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="1" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Behaviors>
                            <fwrk_core_behaviors:AdaptableGridItemLayoutCollectionViewBehavior ItemWidth="720" ItemSpacing="20" />
                        </CollectionView.Behaviors>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    x:DataType="interop_common_display_models:WorkforceDisplayModel"
                                    Padding="16"
                                    HeightRequest="112">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ItemTapGestureRecognizer_Tapped" />
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <Label 
                                            FontAttributes="Bold"
                                            FontSize="Medium"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Name}" />
                                        <Label 
                                            Margin="0,8,0,0"
                                            Text="Fecha"
                                            TextColor="DimGray"
                                            FontSize="Caption"
                                            FontAttributes="Bold" />
                                        <Label
                                            VerticalOptions="FillAndExpand"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Text="{Binding At, StringFormat='{0:D}'}" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label
                                HorizontalTextAlignment="Center"
                                Margin="5"
                                Text="Sin elementos que mostrar"
                                TextColor="{AppThemeBinding Light=DimGray, Dark=Gray}"
                                FontAttributes="Italic" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </ScrollView>
            </StackLayout>
            <ContentView 
                IsVisible="{Binding PresentedItem, Converter={StaticResource IsNotNullConverter}}"
                BackgroundColor="#A9000000">
                <ScrollView Orientation="Vertical">
                    <Grid>
                        <Frame
                            Style="{StaticResource PopupFrameStyle}"
                            WidthRequest="400">
                            <Grid>
                                <StackLayout Margin="20" Spacing="20">
                                    <StackLayout>
                                        <Label 
                                            Margin="0,0,0,20"
                                            Text="Detalles"
                                            FontAttributes="Bold"
                                            FontSize="Medium" />
                                        <Label
                                            Style="{StaticResource CaptionFieldLabelStyle}"
                                            Margin="0"
                                            Text="Nombre" />
                                        <Label
                                            Style="{StaticResource ValueFieldLabelStyle}"
                                            Text="{Binding PresentedItem.Name}" />
                                        <Label 
                                            Style="{StaticResource CaptionFieldLabelStyle}"
                                            Text="Prioridad" />
                                        <Label
                                            Style="{StaticResource ValueFieldLabelStyle}"
                                            Text="{Binding PresentedItem.Priority}" />
                                        <Label 
                                            Style="{StaticResource CaptionFieldLabelStyle}"
                                            Text="Fecha" />
                                        <Label
                                            Style="{StaticResource ValueFieldLabelStyle}"
                                            Text="{Binding PresentedItem.At, StringFormat='{0:D}'}" />
                                    </StackLayout>
                                    <StackLayout
                                        Orientation="Horizontal"
                                        Spacing="20">
                                        <Button 
                                            HorizontalOptions="FillAndExpand"
                                            Text="Modificar"
                                            Clicked="PresentedItemEditButton_Clicked" />
                                        <Button 
                                            HorizontalOptions="FillAndExpand"
                                            Text="Eliminar"
                                            Clicked="PresentedItemRemoveButton_Clicked" />
                                    </StackLayout>
                                </StackLayout>
                                <Button
                                    HorizontalOptions="End" VerticalOptions="Start"
                                    Padding="10"
                                    BackgroundColor="Transparent"
                                    Text="&#xf5ad;"
                                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                    FontSize="Medium"
                                    FontFamily="MaterialDesignIcons"
                                    BorderWidth="0"
                                    WidthRequest="48" HeightRequest="48"
                                    Clicked="PresentedItemDismissButton_Clicked" />
                            </Grid>
                        </Frame>
                    </Grid>
                </ScrollView>
            </ContentView>
            <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
        </Grid>
    </ContentPage.Content>
</caneyframework_mvvm_pages:ContentPage>