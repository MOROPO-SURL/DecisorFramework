<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_card_views="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:presentation_configuration_view_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.View;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.HumanResources.Interop.API.Common"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.WorkforceConfigurationPage"
    x:TypeArguments="interop_common_display_models:WorkforceDisplayModel,interop_common_display_models:WorkforceDisplayModel,presentation_configuration_page_models:WorkforceConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:WorkforceConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:ValidationResultToTargetPropertyErrorMessageConverter x:Key="ValidationResultToTargetPropertyErrorMessageConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyHasErrorConverter x:Key="ValidationResultToTargetPropertyHasErrorConverter" />
            
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <communitytoolkit_converters:IsNullConverter x:Key="IsNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="0" Padding="8">
                <VerticalStackLayout
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                    <Entry Text="{Binding Name}" />
                </VerticalStackLayout>
                <FlexLayout
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=3, ExtraLargeContainerColumn=4, LargeContainerColumn=6, MediumContainerColumn=8, SmallContainerColumn=10}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Puesto superior absoluto" />
                        <Frame 
                            IsVisible="{Binding ChiefVacant, Converter={StaticResource IsNotNullConverter}}"
                            Padding="8">
                            <StackLayout Orientation="Horizontal">
                                <VerticalStackLayout 
                                    HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                    Padding="8">
                                    <Label
                                        ToolTipProperties.Text="{Binding ChiefVacant.WorkPosition.Name}"
                                        Text="{Binding ChiefVacant.WorkPosition.Name}"
                                        LineBreakMode="TailTruncation"
                                        FontSize="Medium" />
                                    <Label
                                        Style="{StaticResource CaptionFieldLabelStyle}"
                                        Margin="0,8,0,0"
                                        Text="Referencia" />
                                    <Label
                                        Text="{Binding ChiefVacant.WorkPosition.Reference, TargetNullValue='---'}"
                                        LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Button
                                    Style="{StaticResource FontIconImageButtonStyle}"
                                    VerticalOptions="Start"
                                    Text="&#xF3CC;"
                                    Clicked="RootChiefVacantEditionButton_Clicked" />
                            </StackLayout>
                        </Frame>
                        <Button
                            IsVisible="{Binding ChiefVacant, Converter={StaticResource IsNullConverter}}"
                            HorizontalOptions="Start"                
                            Text="Definir"
                            Clicked="DefineChiefVacantButton_Clicked" />
                    </VerticalStackLayout>
                </FlexLayout>                
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Unidades Organizativas" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="AddOrganizationalUnityButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="DimGray" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemsSource="{Binding OrganizationalUnities}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" Margin="10" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <local_card_views:WorkforceConfigurationOrganizationalUnityAndVacantsCardView
                                                Margin="10"
                                                DefineChiefVacantButtonClick="DefineChiefVacantButton_Clicked"
                                                ChiefVacantEditionButtonClick="ChiefVacantEditionButton_Clicked"
                                                AddVacantButtonClick="AddVacantButton_Clicked"
                                                VacantEditionButtonClick="VacantEditionButton_Clicked"
                                                VacantRemoveButtonClick="VacantRemoveButton_Clicked" />
                                            <Button
                                                Style="{StaticResource DangerKindFontIconImageButtonStyle}" 
                                                HorizontalOptions="End" VerticalOptions="Start"
                                                Margin="0"
                                                Text="&#xFA78;"
                                                Clicked="OrganizationalUnityRemoveButton_Clicked" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <BoxView 
                    Margin="8,16,8,8"
                    HeightRequest="1" 
                    Color="DimGray" />
                <FlexLayout
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <Grid
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=1, ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        ColumnSpacing="6" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Row="0"
                            Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                        <Entry
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            IsReadOnly="True"
                            Text="{Binding Priority}" />
                        <Stepper
                            Grid.Row="1"
                            Margin="0,0,6,0"
                            HorizontalOptions="End" VerticalOptions="Center"
                            Minimum="1"
                            Maximum="100"
                            Value="{Binding Priority}" />
                    </Grid>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_ui_base_pages:ConfigurationBaseContentPage>