<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:local_presentation_card_views="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:domain_presentation_card_views="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:core_interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Core.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Core.Interop.API.Common"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.HumanResources.Interop.API.Common"
    xmlns:domain_interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.OcupationCandidateConfigurationPage"
    x:TypeArguments="interop_common_display_models:OcupationCandidateDisplayModel,interop_common_display_models:OcupationCandidateDisplayModel,presentation_configuration_page_models:OcupationCandidateConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:OcupationCandidateConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:DocumentDisplayModelToMaterialDesignFontIconTextConverter x:Key="DocumentDisplayModelToMaterialDesignFontIconTextConverter" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="0" Padding="8">
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=6, LargeContainerColumn=5, MediumContainerColumn=6, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Postulación" />
                        <ContentView
                            IsVisible="{Binding Postulation, Converter={StaticResource IsNotNullConverter}}"
                            HeightRequest="148">
                            <local_presentation_card_views:VacantPostulationDefaultCardView BindingContext="{Binding Postulation}" />
                        </ContentView>
                        <Button
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="PostulationPickButton_Clicked" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, LargeContainerColumn=4, MediumContainerColumn=6, SmallContainerColumn=8}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Aprueba" />
                        <ContentView
                            IsVisible="{Binding Responsible, Converter={StaticResource IsNotNullConverter}}"
                            HeightRequest="140">
                            <domain_presentation_card_views:EmployeeDefaultCardView BindingContext="{Binding Responsible}" />
                        </ContentView>                        
                        <Button
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="ResponsiblePickButton_Clicked" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=4}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Fecha de entrevista" />
                        <DatePicker Date="{Binding InterviewAt}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Consideraciones (opcional)" />
                    <Editor Text="{Binding Description}" HeightRequest="120" />
                </VerticalStackLayout>
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=4, LargeContainerColumn=6, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Chequeo médico" />
                        <Frame
                            IsVisible="{Binding RawMedicalCheckDocument, Converter={StaticResource IsNotNullConverter}}"
                            Grid.Column="0">
                            <VerticalStackLayout>
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                                <Label Text="{Binding RawMedicalCheckDocument.Name, FallbackValue='---'}" />
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Margin="0,8,0,0" Text="Tipo" />
                                <Label Text="{Binding RawMedicalCheckDocument.Extension, FallbackValue='---'}" />
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Margin="0,8,0,0" Text="Tamaño" />
                                <Label Text="{Binding RawMedicalCheckDocument.Length, FallbackValue='---', StringFormat='{0} bytes'}" />
                            </VerticalStackLayout>
                        </Frame>
                        <HorizontalStackLayout Spacing="8">
                            <Button
                                IsVisible="{Binding RawMedicalCheckDocument, Converter={StaticResource IsNotNullConverter}}"
                                Text="Descartar" />
                            <Button
                                Text="Seleccionar ..."
                                Clicked="RawMedicalCheckDocumentPickButton_Clicked" />                                
                        </HorizontalStackLayout>
                        <HorizontalStackLayout 
                            IsVisible="{Binding RawMedicalCheckDocument, Converter={StaticResource IsNotNullConverter}}"
                            Spacing="8" 
                            Margin="0,8,0,0">
                            <Label 
                                Style="{StaticResource CaptionFieldLabelStyle}"
                                VerticalOptions="Center"
                                Text="Fecha:" />
                            <DatePicker
                                VerticalOptions="Center" HorizontalOptions="FillAndExpand"
                                Date="{Binding MedicalCheckAt}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=4, LargeContainerColumn=6, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Chequeo psicométrico" />
                        <Frame
                            IsVisible="{Binding RawPhysicologicalCheckDocument, Converter={StaticResource IsNotNullConverter}}"
                            Grid.Column="0">
                            <VerticalStackLayout>
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                                <Label Text="{Binding RawPhysicologicalCheckDocument.Name, FallbackValue='---'}" />
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Margin="0,8,0,0" Text="Tipo" />
                                <Label Text="{Binding RawPhysicologicalCheckDocument.Extension, FallbackValue='---'}" />
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Margin="0,8,0,0" Text="Tamaño" />
                                <Label Text="{Binding RawPhysicologicalCheckDocument.Length, FallbackValue='---', StringFormat='{0} bytes'}" />
                            </VerticalStackLayout>
                        </Frame>
                        <HorizontalStackLayout Spacing="8">
                            <Button
                                IsVisible="{Binding RawPhysicologicalCheckDocument, Converter={StaticResource IsNotNullConverter}}"
                                Text="Descartar" />
                            <Button
                                Text="Seleccionar ..."
                                Clicked="RawPhysicologicalCheckDocumentPickButton_Clicked" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout 
                            IsVisible="{Binding RawPhysicologicalCheckDocument, Converter={StaticResource IsNotNullConverter}}"
                            Spacing="8" 
                            Margin="0,8,0,0">
                            <Label 
                                Style="{StaticResource CaptionFieldLabelStyle}"
                                VerticalOptions="Center"
                                Text="Fecha:" />
                            <DatePicker
                                VerticalOptions="Center" HorizontalOptions="FillAndExpand"
                                Date="{Binding PhysicologicalCheckAt}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=4, LargeContainerColumn=6, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Actualización militar" />
                        <Frame
                            IsVisible="{Binding RawDefenseStatusCheckDocument, Converter={StaticResource IsNotNullConverter}}"
                            Grid.Column="0">
                            <VerticalStackLayout>
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                                <Label Text="{Binding RawDefenseStatusCheckDocument.Name, FallbackValue='---'}" />
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Margin="0,8,0,0" Text="Tipo" />
                                <Label Text="{Binding RawDefenseStatusCheckDocument.Extension, FallbackValue='---'}" />
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Margin="0,8,0,0" Text="Tamaño" />
                                <Label Text="{Binding RawDefenseStatusCheckDocument.Length, FallbackValue='---', StringFormat='{0} bytes'}" />
                            </VerticalStackLayout>
                        </Frame>
                        <HorizontalStackLayout Spacing="8">
                            <Button
                                IsVisible="{Binding RawDefenseStatusCheckDocument, Converter={StaticResource IsNotNullConverter}}"
                                Text="Descartar" />
                            <Button
                                Text="Seleccionar ..."
                                Clicked="RawDefenseStatusCheckDocumentPickButton_Clicked" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout 
                            IsVisible="{Binding RawDefenseStatusCheckDocument, Converter={StaticResource IsNotNullConverter}}"
                            Spacing="8" 
                            Margin="0,8,0,0">
                            <Label 
                                Style="{StaticResource CaptionFieldLabelStyle}"
                                VerticalOptions="Center"
                                Text="Fecha:" />
                            <DatePicker
                                VerticalOptions="Center" HorizontalOptions="FillAndExpand"
                                Date="{Binding DefenseStatusCheckAt}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=4, LargeContainerColumn=6, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Informe de la investigación" />
                        <Frame
                            IsVisible="{Binding RawResearchResultDocument, Converter={StaticResource IsNotNullConverter}}"
                            Grid.Column="0">
                            <VerticalStackLayout>
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                                <Label Text="{Binding RawResearchResultDocument.Name, FallbackValue='---'}" />
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Margin="0,8,0,0" Text="Tipo" />
                                <Label Text="{Binding RawResearchResultDocument.Extension, FallbackValue='---'}" />
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Margin="0,8,0,0" Text="Tamaño" />
                                <Label Text="{Binding RawResearchResultDocument.Length, FallbackValue='---', StringFormat='{0} bytes'}" />
                            </VerticalStackLayout>
                        </Frame>
                        <HorizontalStackLayout Spacing="8">
                            <Button
                                IsVisible="{Binding RawResearchResultDocument, Converter={StaticResource IsNotNullConverter}}"
                                Text="Descartar" />
                            <Button
                                Text="Seleccionar ..."
                                Clicked="RawResearchResultDocumentPickButton_Clicked" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout 
                            IsVisible="{Binding RawResearchResultDocument, Converter={StaticResource IsNotNullConverter}}"
                            Spacing="8" 
                            Margin="0,8,0,0">
                            <Label 
                                Style="{StaticResource CaptionFieldLabelStyle}"
                                VerticalOptions="Center"
                                Text="Solicitado:" />
                            <DatePicker
                                VerticalOptions="Center" HorizontalOptions="FillAndExpand"
                                Date="{Binding ResearchRequestAt}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout 
                            IsVisible="{Binding RawResearchResultDocument, Converter={StaticResource IsNotNullConverter}}"
                            Spacing="8" 
                            Margin="0,8,0,0">
                            <Label 
                                Style="{StaticResource CaptionFieldLabelStyle}"
                                VerticalOptions="Center"
                                Text="Resultado:" />
                            <DatePicker
                                VerticalOptions="Center" HorizontalOptions="FillAndExpand"
                                Date="{Binding ResearchResultAt}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_ui_base_pages:ConfigurationBaseContentPage>