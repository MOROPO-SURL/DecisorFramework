<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:domain_presentation_card_views="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Core.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Core.Interop.API.Common"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.HumanResources.Interop.API.Common"
    xmlns:domain_interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.EmployeeDailyCheckingConfigurationPage"
    x:TypeArguments="interop_common_display_models:EmployeeDailyCheckingDisplayModel,interop_common_display_models:EmployeeDailyCheckingDisplayModel,presentation_configuration_page_models:EmployeeDailyCheckingConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:EmployeeDailyCheckingConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
        Text="Cancelar"
        Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="4" Padding="8">
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Fecha correspondiente" />
                    <Label 
                        FontSize="Medium"
                        Text="{Binding At, StringFormat='{0:D}'}" />
                </VerticalStackLayout>
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="Mañana"
                            FontAttributes="Bold" />
                        <BoxView Color="DimGray" HeightRequest="1" />
                        <Grid Grid.ColumnSpan="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Entrada" />
                                <TimePicker Time="{Binding CheckIn}" />
                            </VerticalStackLayout>
                            <Grid
                                Grid.Column="1"
                                ColumnSpacing="0" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label 
                                    Grid.ColumnSpan="2" Grid.Row="0"
                                    Style="{StaticResource CaptionFieldLabelStyle}" 
                                    Text="Salida" />
                                <CheckBox
                                    Grid.Column="0" Grid.Row="1"
                                    TranslationY="-7"
                                    IsChecked="{Binding IsPartialCheckOutSet}" />
                                <TimePicker
                                    IsVisible="{Binding IsPartialCheckOutSet}"
                                    Grid.Column="1" Grid.Row="1"
                                    Time="{Binding PartialCheckOut}" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="Tarde"
                            FontAttributes="Bold" />
                        <BoxView Color="DimGray" HeightRequest="1" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                             <Grid
                                 Grid.Column="0"
                                 ColumnSpacing="0" RowSpacing="6">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition />
                                 </Grid.ColumnDefinitions>
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="Auto" />
                                 </Grid.RowDefinitions>
                                 <Label 
                                     Grid.ColumnSpan="2" Grid.Row="0"
                                     Style="{StaticResource CaptionFieldLabelStyle}" 
                                     Text="Entrada" />
                                <CheckBox
                                    Grid.Column="0" Grid.Row="1"
                                    TranslationY="-7"
                                    IsChecked="{Binding IsPartialCheckInSet}" />
                                 <TimePicker
                                     IsVisible="{Binding IsPartialCheckInSet}"
                                     Grid.Column="1" Grid.Row="1"
                                     Time="{Binding PartialCheckIn}" />
                             </Grid>
                            <Grid
                                Grid.Column="1"
                                ColumnSpacing="0" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label 
                                    Grid.ColumnSpan="2" Grid.Row="0"
                                    Style="{StaticResource CaptionFieldLabelStyle}" 
                                    Text="Salida" />
                                <CheckBox
                                    Grid.Column="0" Grid.Row="1"
                                    TranslationY="-7"
                                    IsChecked="{Binding IsCheckOutSet}" />
                                <TimePicker
                                    IsVisible="{Binding IsCheckOutSet}"
                                    Grid.Column="1" Grid.Row="1"
                                    Time="{Binding CheckOut}" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="Extra"
                            FontAttributes="Bold" />
                        <BoxView Color="DimGray" HeightRequest="1" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid
                                 Grid.Column="0"
                                 ColumnSpacing="0" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label 
                                     Grid.ColumnSpan="2" Grid.Row="0"
                                     Style="{StaticResource CaptionFieldLabelStyle}" 
                                     Text="Entrada" />
                                <CheckBox
                                    Grid.Column="0" Grid.Row="1"
                                    TranslationY="-7"
                                    IsChecked="{Binding IsExtraCheckInSet}" />
                                <TimePicker
                                     IsVisible="{Binding IsExtraCheckInSet}"
                                     Grid.Column="1" Grid.Row="1"
                                     Time="{Binding ExtraCheckIn}" />
                            </Grid>
                            <Grid
                                Grid.Column="1"
                                ColumnSpacing="0" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label 
                                    Grid.ColumnSpan="2" Grid.Row="0"
                                    Style="{StaticResource CaptionFieldLabelStyle}" 
                                    Text="Salida" />
                                <CheckBox
                                    Grid.Column="0" Grid.Row="1"
                                    TranslationY="-7"
                                    IsChecked="{Binding IsExtraCheckOutSet}" />
                                <TimePicker
                                    IsVisible="{Binding IsExtraCheckOutSet}"
                                    Grid.Column="1" Grid.Row="1"
                                    Time="{Binding ExtraCheckOut}" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_ui_base_pages:ConfigurationBaseContentPage>