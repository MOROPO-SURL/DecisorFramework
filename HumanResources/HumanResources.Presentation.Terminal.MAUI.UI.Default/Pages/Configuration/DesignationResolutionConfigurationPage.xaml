<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_presentation_card_views="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:domain_card_views="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.HumanResources.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.DesignationResolutionConfigurationPage"
    x:TypeArguments="interop_common_display_models:DesignationResolutionDisplayModel,interop_common_display_models:DesignationResolutionDisplayModel,presentation_configuration_page_models:DesignationResolutionConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:DesignationResolutionConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:ValidationResultToTargetPropertyErrorMessageConverter x:Key="ValidationResultToTargetPropertyErrorMessageConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyHasErrorConverter x:Key="ValidationResultToTargetPropertyHasErrorConverter" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <communitytoolkit_converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
        Text="Cancelar"
        Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="0" Padding="8">
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=2, ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"                        
                        Margin="4"
                        Spacing="6">
                        <Grid
                            ColumnSpacing="6" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label 
                                Grid.Row="0"
                                Style="{StaticResource CaptionFieldLabelStyle}" Text="No. Resolución" />
                            <Entry
                                Grid.Row="1"
                                BackgroundColor="Transparent"
                                IsReadOnly="True"
                                Text="{Binding Index}" />
                            <Stepper
                                Grid.Row="1"
                                Margin="0,0,6,0"
                                HorizontalOptions="End" VerticalOptions="Center"
                                Value="{Binding Index}" />
                        </Grid>
                        <Label 
                            Style="{StaticResource CaptionFieldLabelStyle}" 
                            Margin="0,8,0,0"
                            Text="Fecha de Emisión" />
                        <DatePicker Date="{Binding At}" Format="dddd dd, MMMM, yyyy" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, ExtraLargeContainerColumn=5, LargeContainerColumn=5, MediumContainerColumn=8, SmallContainerColumn=11}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombrado" />
                        <ContentView IsVisible="{Binding Contact, Converter={StaticResource IsNotNullConverter}}">
                            <domain_card_views:PersonContactDefaultCardView 
                                BindingContext="{Binding Contact}"
                                HeightRequest="140" />
                        </ContentView>
                        <Button
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="ContactPickButton_Clicked" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:DesignationResolutionConfigurationPageModel.ContactValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:DesignationResolutionConfigurationPageModel.ContactValidableProperty}}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, ExtraLargeContainerColumn=5, LargeContainerColumn=4, MediumContainerColumn=8, SmallContainerColumn=10}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Puesto" />
                        <Frame
                            IsVisible="{Binding Vacant, Converter={StaticResource IsNotNullConverter}}"
                            Padding="0">
                            <VerticalStackLayout Margin="16" Spacing="8">
                                <Label
                                    ToolTipProperties.Text="{Binding Vacant.WorkPosition.Name}"
                                    Text="{Binding Vacant.WorkPosition.Name}"
                                    FontSize="Medium"
                                    LineBreakMode="TailTruncation" />
                                <Label
                                    ToolTipProperties.Text="{Binding Staff.AdministrativeEntity.Identity.Name}"
                                    Text="{Binding Staff.AdministrativeEntity.Identity.Name}"
                                    LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Frame>
                        <Button
                            HorizontalOptions="Start"
                            Text="Seleccionar ..."
                            Clicked="VacantPickButton_Clicked" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:DesignationResolutionConfigurationPageModel.VacantValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:DesignationResolutionConfigurationPageModel.VacantValidableProperty}}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Acuerdo (opcional)" />
                    <Frame 
                        IsVisible="{Binding Agreement, Converter={StaticResource IsNotNullConverter}}"
                        Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Column="0" Grid.Row="0"
                                Text="No." />
                            <Label
                                Grid.Column="1" Grid.RowSpan="2"
                                Margin="0,0,4,0"
                                FontSize="Large"
                                Text="{Binding Agreement.Index}" />
                            <Label
                                Grid.Column="2" Grid.ColumnSpan="4"
                                FontAttributes="Bold"
                                Text="{Binding Agreement.Title}" />
                            <Label
                                Grid.Column="2" Grid.Row="1"
                                Style="{StaticResource CaptionFieldLabelStyle}"
                                Margin="0"
                                Text="Grupo Decisor:" />
                            <Label
                                Grid.Column="3" Grid.Row="1"
                                Margin="4,0,8,0"
                                Text="{Binding Agreement.Meeting.DecisionMakingGroup.CanonicalName}" />
                            <Label
                                Grid.Column="4" Grid.Row="1"
                                Style="{StaticResource CaptionFieldLabelStyle}"
                                Margin="0"
                                Text="Reunión:" />
                            <Label
                                Grid.Column="5" Grid.Row="1"
                                Margin="4,0"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Agreement.Meeting.At}" />
                            <Label
                                Grid.ColumnSpan="6" Grid.Row="2"
                                Text="{Binding Agreement.Description, TargetNullValue='---'}" />
                        </Grid>
                    </Frame>
                    <Button
                        HorizontalOptions="Start"
                        Text="Seleccionar ..."
                        Clicked="AgreementPickButton_Clicked" />
                </VerticalStackLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Resumen" />
                    <Editor Text="{Binding Summary}" HeightRequest="120" />
                    <Label
                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:DesignationResolutionConfigurationPageModel.SummaryValidableProperty}}"
                        Style="{StaticResource ValidationMessageLabelStyle}"
                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:DesignationResolutionConfigurationPageModel.SummaryValidableProperty}}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_ui_base_pages:ConfigurationBaseContentPage>