<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:presentation_view_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.Models.View;assembly=MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI"
    xmlns:core_ui_behaviors="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Behaviors;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.HumanResources.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.HumanResources.Interop.API.Common"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.HumanResources.Presentation.Terminal.MAUI.UI.Default.Views.Card.VacantPickOrganizationalStructuringUnitTreeCardView"
    x:DataType="presentation_view_models:TreeVacantPickOrganizationalStructuringUnitViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid ColumnSpacing="0" RowSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label
            IsVisible="{Binding Parent, Converter={StaticResource IsNotNullConverter}}"
            Grid.Column="0"
            VerticalOptions="Start"
            FontSize="Large"
            FontFamily="MaterialDesignIcons"
            Text="&#xF60D;" />
        <BoxView
            IsVisible="{Binding Parent, Converter={StaticResource IsNotNullConverter}}"
            Grid.Column="1" Grid.RowSpan="2"
            WidthRequest="2"
            Color="DimGray" />
        <Frame 
            Grid.Column="2"
            Margin="8,0,0,0"
            Padding="16">
            <VerticalStackLayout Spacing="0">
                <Label
                    LineBreakMode="TailTruncation"
                    FontSize="Medium"
                    Text="{Binding Context.OrganizationalUnit.Name}"
                    ToolTipProperties.Text="{Binding Context.OrganizationalUnit.Name}" />
                <Label 
                    Style="{StaticResource CaptionFieldLabelStyle}"
                    Margin="0,8"
                    Text="Ocupaciones vacantes" />
                <CollectionView 
                    x:Name="VacantsCollectionView"
                    ItemsSource="{Binding Vacants}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="1" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Behaviors>
                        <core_ui_behaviors:AdaptableGridItemLayoutCollectionViewBehavior ItemWidth="240" ItemSpacing="8" />
                    </CollectionView.Behaviors>
                    <CollectionView.EmptyView>
                        <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="interop_common_display_models:VacantDisplayModel">
                            <Frame Padding="0">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="0">
                                    <Image 
                                        HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                                        BackgroundColor="DimGray"
                                        Source="default_person_picture.jpg" />
                                    <VerticalStackLayout Margin="8,8,8,12" Spacing="8">
                                        <Label
                                            HorizontalOptions="Center"
                                            ToolTipProperties.Text="{Binding WorkPosition.Name}"
                                            Text="{Binding WorkPosition.Name}"
                                            FontAttributes="Bold"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label 
                    Style="{StaticResource CaptionFieldLabelStyle}"
                    VerticalOptions="End"
                    Margin="0,16,0,4"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold"
                    Text="Agregados" />
                <BoxView
                    HeightRequest="2"
                    Color="DimGray" />
                <CollectionView 
                    Margin="0,4,0,0"
                    ItemsSource="{Binding CompositionChildren}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label Padding="4,0,4,4" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <local:VacantPickOrganizationalStructuringUnitLeafCardView ItemTapped="TapGestureRecognizer_Tapped" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Frame>
        <VerticalStackLayout
            Grid.Column="2" Grid.Row="1"
            Margin="8,0,0,0"
            Spacing="8">
            <Label 
                Style="{StaticResource CaptionFieldLabelStyle}"
                VerticalOptions="End"
                Text="Dependencias" />
            <BoxView
                HeightRequest="2"
                Color="DimGray" />
            <CollectionView ItemsSource="{Binding DependencyChildren}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Padding="4" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <local:VacantPickOrganizationalStructuringUnitTreeCardView ItemTapped="TapGestureRecognizer_Tapped" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentView>
