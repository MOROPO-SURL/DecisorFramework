<?xml version="1.0" encoding="utf-8" ?>
<core_contract_configuration_pages:BaseConfigurationContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_view_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.Models.View"
    xmlns:local_card_views="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.UI.Views.Card"
    xmlns:local_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.Models.Page.Configuration"
    xmlns:core_contract_configuration_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Configuration.Contract;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Purchasing.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.UI.Pages.Configuration.PurchaseReceptionConfigurationPage"
    x:TypeArguments="interop_common_display_models:PurchaseReceptionDisplayModel"
    x:DataType="local_configuration_page_models:PurchaseReceptionConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />

            <Style TargetType="Label" x:Key="CaptionFieldLabelStyle">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=DimGray, Dark=Gray}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <Grid 
                Padding="20"
                ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="0">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Compra" />
                    <ContentView                        
                        IsVisible="{Binding Path=Purchase, Converter={StaticResource IsNotNullConverter}}">
                        <local_card_views:PurchaseDefaultCardView
                            BindingContext="{Binding Purchase}"
                            HeightRequest="180" />
                    </ContentView>
                    <Button
                        Text="Seleccionar ..."
                        Clicked="PurchasePickButton_Clicked" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.Row="0" VerticalOptions="Start">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Responsable" />
                    <Picker 
                        x:Name="ResponsiblePicker"
                        ItemsSource="{Binding AvailableResponsibles}"
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="2" Grid.Row="1">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Observaciones (Opcional)" />
                    <Editor Text="{Binding Description}" HeightRequest="120" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="2" Grid.Row="2">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Pesaje de Compras" />
                    <Frame Padding="8">
                        <CollectionView
                            Grid.ColumnSpan="2" Grid.Row="2"
                            ItemsSource="{Binding Path=RegularWeights}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="local_view_models:PurchaseReceptionProductCommonWeightBridgeViewModel">
                                    <Frame Padding="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*" />
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Column="0"
                                                VerticalOptions="Center"
                                                Text="{Binding Path=Product.Name}"
                                                FontAttributes="Bold" />
                                            <Editor 
                                                Grid.Column="1"
                                                VerticalOptions="Center"
                                                FontSize="Medium"
                                                Text="{Binding Path=Amount, StringFormat='{0:F2}'}" />
                                            <Label 
                                                Grid.Column="2"
                                                VerticalOptions="Center"
                                                Text="{Binding Path=Product.DefaultUnitMeasurement.Symbol}" />
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Frame>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.Row="0" VerticalOptions="Start">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Almacen" />
                    <Picker 
                        x:Name="WarehousePicker"
                        ItemsSource="{Binding AvailableWarehouses}"
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
        <caneyframework_presentation_views:BusyView
            BackgroundColor="#A7FFFFFF"
            IsVisible="{Binding IsBusy}" />
    </Grid>
</core_contract_configuration_pages:BaseConfigurationContentPage>