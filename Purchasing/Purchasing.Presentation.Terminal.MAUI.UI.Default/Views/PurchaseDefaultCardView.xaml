<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Purchasing.Interop.API.Common"
    x:Class="MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.UI.Default.Views.Card.PurchaseDefaultCardView"
    x:DataType="interop_common_display_models:PurchaseDisplayModel">
    <Frame>
        <StackLayout>
            <Label 
                FontAttributes="Bold"
                FontSize="Medium"
                LineBreakMode="TailTruncation"
                Text="{Binding Path=At, StringFormat='{0:D}'}" />
            <Label Text="{Binding Plan.Zone.Name}" />
            <Label 
                Margin="0,8,0,0"
                Text="Responsable"
                TextColor="DimGray"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label
                LineBreakMode="TailTruncation">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Purchaser.Name}" />
                        <Span Text=" " />
                        <Span Text="{Binding Purchaser.LastName}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label 
                Margin="0,8,0,0"
                Text="Descripción"
                TextColor="DimGray"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label
                VerticalOptions="FillAndExpand"
                LineBreakMode="TailTruncation"
                MaxLines="2"
                Text="{Binding Description, TargetNullValue='---'}" />
        </StackLayout>
    </Frame>
</ContentView>
