<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Purchasing.Interop.API.Common"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.UI.Default.Views.Card.PurchaseOrderDefaultCardView"
    x:DataType="interop_common_display_models:PurchaseOrderDisplayModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:ListToStringConverter x:Key="ListToStringConverter" Separator=", " />
        </ResourceDictionary>
    </ContentView.Resources>
    <Frame>
        <StackLayout>
            <Label 
                FontAttributes="Bold"
                FontSize="Medium"
                Text="{Binding Zone.Name}" />
            <Label Text="{Binding PlannedFor, StringFormat='{0:D}'}" />
            <Label 
                Margin="0,8,0,0"
                Text="Productos"
                TextColor="DimGray"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label
                LineBreakMode="TailTruncation"
                Text="{Binding Request.ProductBridges, Converter={StaticResource ListToStringConverter}}" />
            <Label 
                Margin="0,8,0,0"
                Text="Responsable"
                TextColor="DimGray"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label
                LineBreakMode="TailTruncation">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Responsible.Contact.Identity.Name}" />
                        <Span Text=" " />
                        <Span Text="{Binding Responsible.Contact.Identity.LastName}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label 
                Margin="0,8,0,0"
                Text="Descripción"
                TextColor="DimGray"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label
                VerticalOptions="FillAndExpand"
                LineBreakMode="TailTruncation"
                MaxLines="2"
                Text="{Binding Description, TargetNullValue='---'}" />
        </StackLayout>
    </Frame>
</ContentView>
