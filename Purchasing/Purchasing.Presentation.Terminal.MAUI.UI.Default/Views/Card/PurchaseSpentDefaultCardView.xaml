<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Purchasing.Interop.API.Common"
    x:Class="MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.UI.Default.Views.Card.PurchaseSpentDefaultCardView"
    x:DataType="interop_common_display_models:PurchaseSpentDisplayModel">
    <Frame>
        <StackLayout>
            <Label 
                Text="{Binding Name}"
                LineBreakMode="TailTruncation"
                FontSize="Medium" />
            <Label 
                Margin="0,8,0,0"
                Text="Descripción"
                TextColor="DimGray"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label 
                VerticalOptions="FillAndExpand"
                LineBreakMode="TailTruncation"
                MaxLines="2"
                Text="{Binding Description, TargetNullValue='---'}" />
        </StackLayout>
    </Frame>
</ContentView>
