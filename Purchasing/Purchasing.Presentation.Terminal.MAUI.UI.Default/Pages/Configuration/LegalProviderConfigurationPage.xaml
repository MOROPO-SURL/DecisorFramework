<?xml version="1.0" encoding="utf-8" ?>
<core_contract_configuration_pages:BaseConfigurationContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI"
    xmlns:core_contract_configuration_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.Contract;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Purchasing.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    x:Class="MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.LegalProviderConfigurationPage"
    x:TypeArguments="interop_common_display_models:LegalProviderDisplayModel"
    x:DataType="presentation_configuration_page_models:LegalProviderConfigurationPageModel">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
        Text="Aplicar"
        Clicked="ApplyClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
        Text="Cancelar"
        Clicked="CancelClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <Grid 
                Padding="20"
                ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Frame
                    Grid.Column="3" Grid.Row="0" Grid.RowSpan="3"
                    VerticalOptions="Start"
                    Padding="0"
                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}">
                    <Grid>
                        <Image Source="{Binding ImageSource, TargetNullValue='default_organization_picture.png'}" />
                        <Grid BackgroundColor="#A7000000">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ImageLayoutTapGestureRecognizer_Tapped" />
                            </Grid.GestureRecognizers>
                            <Label
                                Text="&#xF8CB;"
                                TextColor="White"
                                HorizontalOptions="Center" VerticalOptions="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="96" />
                        </Grid>
                    </Grid>
                </Frame>
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                    <Entry Text="{Binding Name}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="1">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="NIT" />
                    <Entry Text="{Binding TaxIdentificationNumber}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tipo" />
                    <Picker 
                        x:Name="BusinessKindPicker"
                        ItemsSource="{Binding AvailableBusinessKinds}" 
                        ItemDisplayBinding="{Binding Name}"
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                </VerticalStackLayout>            
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="2">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Fecha de fundación" />
                    <StackLayout Orientation="Horizontal" Spacing="0">
                        <Switch IsToggled="{Binding IsSettedBornDate}" />
                        <DatePicker
                            HorizontalOptions="FillAndExpand"
                            IsEnabled="{Binding IsSettedBornDate}"
                            IsVisible="{Binding IsSettedBornDate}"
                            Date="{Binding BornDate}" />
                    </StackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="4" Grid.Row="3">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descrición (Opcional)" />
                    <Editor Text="{Binding About}" HeightRequest="200" />
                </VerticalStackLayout>
                <BoxView 
                    Grid.ColumnSpan="4" Grid.Row="4" 
                    Margin="0,8,0,0"
                    HeightRequest="1" 
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray100}}" />
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="5">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                    <Picker SelectedItem="{Binding Priority}" ItemsSource="{StaticResource PriorityValues}" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
        <caneyframework_presentation_views:BusyView
            BackgroundColor="#A7FFFFFF"
            IsVisible="{Binding IsBusy}" />
    </Grid>
</core_contract_configuration_pages:BaseConfigurationContentPage>