<?xml version="1.0" encoding="utf-8" ?>
<core_ui_configuration_pages:BaseConfigurationContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI"
    xmlns:core_ui_configuration_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Configuration;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Purchasing.Interop.API.Common"
    xmlns:interop_common_bridge_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Interop.API.Common.Models.Bridge;assembly=MOROPO.Framework.Decisor.Purchasing.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    x:Class="MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.PurchasePlanConfigurationPage"
    x:TypeArguments="interop_common_display_models:PurchasePlanDisplayModel"
    x:DataType="presentation_configuration_page_models:PurchasePlanConfigurationPageModel">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <Grid 
                Padding="20"
                ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="0">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Zona" />
                    <Picker 
                        x:Name="ZonePicker"
                        ItemsSource="{Binding AvailableZones}"
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Fecha Prevista" />
                    <DatePicker Date="{Binding PlannedFor}" MinimumDate="{Binding PlannerForMinDate}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="1">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Planificador" />
                    <Picker 
                        x:Name="PlannerPicker" 
                        ItemsSource="{Binding AvailablePlanners}"
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Responsable" />
                    <Picker 
                        x:Name="ResponsiblePicker" 
                        ItemsSource="{Binding AvailableResponsibles}"
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="3" Grid.Row="1">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Aprueba" />
                    <Picker 
                        x:Name="DecisorPicker" 
                        ItemsSource="{Binding AvailableDecisors}"
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="4" Grid.Row="2">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descrición (Opcional)" />
                    <Editor Text="{Binding Description}" HeightRequest="120" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="2" Grid.Row="3">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Proveedores Jurídicos" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="AddLegalProviderButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="{StaticResource Gray050}" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                VerticalOptions="Start"
                                ItemsSource="{Binding LegalProviderBridges}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="interop_common_bridge_models:PurchasePlanLegalProviderBridgeModel">
                                        <Frame Padding="8">
                                            <StackLayout Orientation="Horizontal">
                                                <VerticalStackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                                                    <Label                                                 
                                                        Text="{Binding Provider.Name}"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation" />
                                                    <Label 
                                                        Text="{Binding Provider.BusinessKind.Name}"
                                                        FontSize="Caption"
                                                        LineBreakMode="TailTruncation" />
                                                    <Label Margin="0,4,0,0">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Adeudo: " FontAttributes="Bold" TextColor="DimGray" />
                                                                <Span Text="{Binding Debt, StringFormat='{0:F2} CUP'}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </VerticalStackLayout>
                                                <Button
                                                    VerticalOptions="Start"
                                                    FontFamily="MaterialDesignIcons" Text="&#xf1c0;"
                                                    Clicked="LegalProviderRemoveButton_Clicked" />
                                            </StackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="3">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Proveedores Naturales" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="AddNaturalProviderButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="{StaticResource Gray050}" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemsSource="{Binding NaturalProviderBridges}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" Margin="10" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="interop_common_bridge_models:PurchasePlanNaturalProviderBridgeModel">
                                        <Frame Padding="8">
                                            <StackLayout Orientation="Horizontal">
                                                <VerticalStackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                                                    <HorizontalStackLayout Spacing="4">
                                                        <Label                                                 
                                                            Text="{Binding Provider.Name}"
                                                            FontAttributes="Bold"
                                                            LineBreakMode="TailTruncation" />
                                                        <Label                                                 
                                                            Text="{Binding Provider.LastName}"
                                                            LineBreakMode="TailTruncation" />
                                                    </HorizontalStackLayout>
                                                    <Label 
                                                        Text="{Binding Provider.BusinessKind.Name}"
                                                        FontSize="Caption"
                                                        LineBreakMode="TailTruncation" />
                                                    <Label Margin="0,4,0,0">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Adeudo: " FontAttributes="Bold" TextColor="DimGray" />
                                                                <Span Text="{Binding Debt, StringFormat='{0:F2} CUP'}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </VerticalStackLayout>
                                                <Button
                                                    VerticalOptions="Start"
                                                    FontFamily="MaterialDesignIcons" Text="&#xf1c0;"
                                                    Clicked="NaturalProviderRemoveButton_Clicked" />
                                            </StackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="4" Grid.Row="4">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Previsión de Insumos" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="AddInputProductBridgeButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="{StaticResource Gray050}" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemsSource="{Binding InputProductBridges}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" Margin="10" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="interop_common_bridge_models:PurchasePlanCommonProductBridgeModel">
                                        <Frame Padding="8">
                                            <StackLayout Spacing="8" Orientation="Horizontal">
                                                <Label 
                                                    HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                                    Text="{Binding Product.Name}"
                                                    FontAttributes="Bold"
                                                    LineBreakMode="TailTruncation" />
                                                <Label
                                                    HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Amount}" />
                                                            <Span Text=" " />
                                                            <Span Text="{Binding UnitMeasurement.Symbol}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Button
                                                    VerticalOptions="Start"
                                                    FontFamily="MaterialDesignIcons" Text="&#xF90B;"
                                                    Clicked="EditInputProductBridgeButton_Clicked" />
                                                <Button
                                                    VerticalOptions="Start"
                                                    FontFamily="MaterialDesignIcons" Text="&#xf1c0;"
                                                    Clicked="PurchasePlanInputProductBridgeRemoveButton_Clicked" />
                                            </StackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="4" Grid.Row="5">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Previsión de Productos" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="AddOutputProductBridgeButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="{StaticResource Gray050}" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemsSource="{Binding OutputProductBridges}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" Margin="10" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="interop_common_bridge_models:PurchasePlanCommonProductBridgeModel">
                                        <Frame Padding="8">
                                            <StackLayout Spacing="8" Orientation="Horizontal">
                                                <Label 
                                                    HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                                    Text="{Binding Product.Name}"
                                                    FontAttributes="Bold"
                                                    LineBreakMode="TailTruncation" />
                                                <Label
                                                    HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Amount}" />
                                                            <Span Text=" " />
                                                            <Span Text="{Binding UnitMeasurement.Symbol}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Button
                                                    VerticalOptions="Start"
                                                    FontFamily="MaterialDesignIcons" Text="&#xF90B;"
                                                    Clicked="EditOutputProductBridgeButton_Clicked" />
                                                <Button
                                                    VerticalOptions="Start"
                                                    FontFamily="MaterialDesignIcons" Text="&#xf1c0;"
                                                    Clicked="PurchasePlanOutputProductBridgeRemoveButton_Clicked" />
                                            </StackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Anticipo Estimado" />
                    <Entry Text="{Binding EstimatedAdvance, StringFormat='{0:F2}'}" />
                </VerticalStackLayout>
                <BoxView 
                    Grid.ColumnSpan="4" Grid.Row="7" 
                    Margin="0,8,0,0"
                    HeightRequest="1" 
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray100}}" />
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="8">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                    <Picker SelectedItem="{Binding Priority}" ItemsSource="{StaticResource PriorityValues}" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_ui_configuration_pages:BaseConfigurationContentPage>