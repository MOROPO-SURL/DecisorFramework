<?xml version="1.0" encoding="utf-8" ?>
<core_contract_configuration_pages:BaseConfigurationContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_card_views="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI"
    xmlns:core_contract_configuration_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.Contract;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Purchasing.Interop.API.Common"
    xmlns:interop_common_bridge_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Interop.API.Common.Models.Bridge;assembly=MOROPO.Framework.Decisor.Purchasing.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.PurchaseConfigurationPage"
    x:TypeArguments="interop_common_display_models:PurchaseDisplayModel"
    x:DataType="presentation_configuration_page_models:PurchaseConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <Grid 
                Padding="20"
                ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="0">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Plan" />
                    <ContentView                        
                        IsVisible="{Binding Plan, Converter={StaticResource IsNotNullConverter}}">
                        <local_card_views:PurchasePlanToCompleteDefaultCardView
                            BindingContext="{Binding Plan}"
                            HeightRequest="180"
                            Margin="0,0,0,10" />
                    </ContentView>
                    <Button
                        HorizontalOptions="Start"
                        Text="Seleccionar ..."
                        Clicked="PlanPickButton_Clicked" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="1">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Comprador" />
                    <Picker 
                        x:Name="PurchaserPicker" 
                        ItemsSource="{Binding AvailablePurchasers}"
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.Row="1">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Zona" />
                    <Picker 
                        x:Name="ZonePicker"
                        ItemsSource="{Binding AvailableZones}"
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="2" Grid.Row="2">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descrición (Opcional)" />
                    <Editor Text="{Binding Description}" HeightRequest="120" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="2" Grid.Row="3">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Compras a Proveedores Jurídicos" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="AddLegalProviderPurchaseButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="{StaticResource Gray050}" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemsSource="{Binding LegalProviderProductBridges}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="interop_common_bridge_models:PurchaseProductLegalProviderBridgeModel">
                                        <Frame Padding="8">
                                            <StackLayout Orientation="Horizontal">
                                                <VerticalStackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                                                    <Label
                                                        Text="{Binding Product.Name}"
                                                        FontSize="Medium" />
                                                    <Label>
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding Amount, StringFormat='{0:F2}'}" />
                                                                <Span Text=" " />
                                                                <Span Text="{Binding UnitMeasurement.Symbol}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label Margin="0,4,0,0">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Costo Unitario: " FontAttributes="Bold" TextColor="DimGray" />
                                                                <Span Text="{Binding Cost, StringFormat='{0:F2} CUP'}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label
                                                        Style="{StaticResource CaptionFieldLabelStyle}"
                                                        FontSize="Caption"
                                                        Margin="0,8,0,0"
                                                        Text="Proveedor" />
                                                    <Label                                                 
                                                        Text="{Binding Provider.Name}"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation" />
                                                    <Label 
                                                        Text="{Binding Provider.BusinessKind.Name}"
                                                        FontSize="Caption"
                                                        LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Spacing="8">
                                                    <Button
                                                        FontFamily="MaterialDesignIcons" 
                                                        Text="&#xF90B;"
                                                        Clicked="EditLegalProviderPurchaseButton_Clicked" />
                                                    <Button
                                                        VerticalOptions="Start"
                                                        FontFamily="MaterialDesignIcons" 
                                                        Text="&#xFA78;"
                                                        Clicked="PurchaseLegalProviderProductBridgeRemoveButton_Clicked" />
                                                </VerticalStackLayout>
                                            </StackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="2" Grid.Row="4">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Compras a Proveedores Naturales" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="AddNaturalProviderPurchaseButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="{StaticResource Gray050}" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemsSource="{Binding NaturalProviderProductBridges}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="interop_common_bridge_models:PurchaseProductNaturalProviderBridgeModel">
                                        <Frame Padding="8">
                                            <StackLayout Orientation="Horizontal">
                                                <VerticalStackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                                                    <Label
                                                        Text="{Binding Product.Name}"
                                                        FontSize="Medium" />
                                                    <Label>
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding Amount, StringFormat='{0:F2}'}" />
                                                                <Span Text=" " />
                                                                <Span Text="{Binding UnitMeasurement.Symbol}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label Margin="0,4,0,0">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Costo Unitario: " FontAttributes="Bold" TextColor="DimGray" />
                                                                <Span Text="{Binding Cost, StringFormat='{0:F2} CUP'}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label
                                                        Style="{StaticResource CaptionFieldLabelStyle}"
                                                        FontSize="Caption"
                                                        Margin="0,8,0,0"
                                                        Text="Proveedor" />
                                                    <Label                                                 
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding Provider.Name}" />
                                                                <Span Text=" " />
                                                                <Span Text="{Binding Provider.LastName}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label 
                                                        Text="{Binding Provider.BusinessKind.Name}"
                                                        FontSize="Caption"
                                                        LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Spacing="8">
                                                    <Button
                                                        FontFamily="MaterialDesignIcons" 
                                                        Text="&#xF90B;"
                                                        Clicked="EditNaturalProviderPurchaseButton_Clicked" />
                                                    <Button
                                                        VerticalOptions="Start"
                                                        FontFamily="MaterialDesignIcons" 
                                                        Text="&#xFA78;"
                                                        Clicked="PurchaseNaturalProviderProductBridgeRemoveButton_Clicked" />
                                                </VerticalStackLayout>
                                            </StackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
        <caneyframework_presentation_views:BusyView
            BackgroundColor="#A7FFFFFF"
            IsVisible="{Binding IsBusy}" />
    </Grid>
</core_contract_configuration_pages:BaseConfigurationContentPage>