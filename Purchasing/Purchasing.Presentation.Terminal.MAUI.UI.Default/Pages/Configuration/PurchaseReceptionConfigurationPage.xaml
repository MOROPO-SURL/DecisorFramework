<?xml version="1.0" encoding="utf-8" ?>
<core_contract_configuration_pages:BaseConfigurationContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_view_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.Models.View;assembly=MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI"
    xmlns:local_card_views="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:core_contract_configuration_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.Contract;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Purchasing.Interop.API.Common"
    xmlns:inventory_interop_common_input_models="clr-namespace:MOROPO.Framework.Decisor.Inventory.Interop.API.Common.Models.Input;assembly=MOROPO.Framework.Decisor.Inventory.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.PurchaseReceptionConfigurationPage"
    x:TypeArguments="interop_common_display_models:PurchaseReceptionDisplayModel"
    x:Name="Page">
    <ContentPage.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <Grid 
                Padding="20"
                ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="0">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Compra" />
                    <ContentView                        
                        IsVisible="{Binding Path=Purchase, Converter={StaticResource IsNotNullConverter}}">
                        <local_card_views:PurchaseDefaultCardView
                            BindingContext="{Binding Purchase}"
                            HeightRequest="180" />
                    </ContentView>
                    <Button
                        HorizontalOptions="Start"
                        Text="Seleccionar ..."
                        Clicked="PurchasePickButton_Clicked" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.Row="0" VerticalOptions="Start">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Responsable" />
                    <Picker 
                        x:Name="ResponsiblePicker"
                        ItemsSource="{Binding AvailableResponsibles}"
                        SelectedIndexChanged="Picker_SelectedIndexChanged" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="2" Grid.Row="1">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Observaciones (Opcional)" />
                    <Editor Text="{Binding Description}" HeightRequest="120" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="2" Grid.Row="2">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Pesaje y distribución" />
                    <Frame Padding="16,0,16,16">
                        <CollectionView
                            Grid.ColumnSpan="2" Grid.Row="2"
                            ItemsSource="{Binding Weights}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <Label Padding="0,16,0,0" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="presentation_view_models:PurchaseReceptionWeightsByCostCenterViewModel">
                                    <VerticalStackLayout Padding="0,16,0,8">
                                        <Label Text="Centro de costo:" />
                                        <Label
                                            Text="{Binding CostCenter.Name}"
                                            FontSize="Medium"
                                            FontAttributes="Bold" />
                                        <VerticalStackLayout
                                            BindableLayout.ItemsSource="{Binding ProductWeights}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="presentation_view_models:PurchaseReceptionProductWeightBridgeViewModel">
                                                    <Frame x:Name="WrapFrame" Padding="16" Margin="0,4">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="5*" />
                                                                <ColumnDefinition Width="4*" />
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Label
                                                                Grid.Column="0" Grid.Row="0"
                                                                VerticalOptions="Center"
                                                                Text="{Binding Product.Name}"
                                                                FontSize="Medium"
                                                                FontAttributes="Bold" />
                                                            <Entry 
                                                                Grid.Column="1" Grid.Row="0"
                                                                VerticalOptions="Center"
                                                                FontSize="Medium"
                                                                Text="{Binding Amount, StringFormat='{0:F2}'}" />
                                                            <Label 
                                                                Grid.Column="2" Grid.Row="0"
                                                                VerticalOptions="Center"
                                                                Text="{Binding Product.DefaultUnitMeasurement.Symbol}" />
                                                            <BoxView
                                                                Grid.ColumnSpan="3" Grid.Row="2"
                                                                Margin="0,12,0,16"
                                                                HeightRequest="1"
                                                                Color="{AppThemeBinding Light=DimGray, Dark=LightGray}" />
                                                            <Label
                                                                Grid.ColumnSpan="2" Grid.Row="3"
                                                                VerticalOptions="End"
                                                                Text="Lotes"
                                                                FontAttributes="Bold"
                                                                FontSize="Medium" />
                                                            <Button
                                                                Grid.Column="2" Grid.Row="3"
                                                                HorizontalOptions="End" VerticalOptions="End"
                                                                Text="Agregar" />
                                                            <BoxView
                                                                Grid.ColumnSpan="3" Grid.Row="4"
                                                                Margin="0,8,0,12"
                                                                HeightRequest="2"
                                                                Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
                                                            <VerticalStackLayout
                                                                Grid.ColumnSpan="3" Grid.Row="5"
                                                                Margin="0,4"
                                                                BindableLayout.ItemsSource="{Binding Batchs}">
                                                                <BindableLayout.ItemTemplate>
                                                                    <DataTemplate x:DataType="presentation_view_models:BatchSpecificationViewModel">
                                                                        <Frame Padding="12">
                                                                            <Grid ColumnSpacing="12" RowSpacing="6">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition />
                                                                                    <ColumnDefinition />
                                                                                    <ColumnDefinition />
                                                                                    <ColumnDefinition />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>
                                                                                <Label
                                                                                    Grid.Column="0" Grid.Row="0"
                                                                                    Text="Referencia:"
                                                                                    FontAttributes="Bold" />
                                                                                <Entry
                                                                                    Grid.Column="0" Grid.Row="1"
                                                                                    Text="{Binding ExternalReference}" />
                                                                                <Label
                                                                                    Grid.Column="1" Grid.Row="0"
                                                                                    Text="Cantidad:"
                                                                                    FontAttributes="Bold" />
                                                                                <Entry
                                                                                    Grid.Column="1" Grid.Row="1"
                                                                                    Text="{Binding Amount, StringFormat='{0:F2}'}" />
                                                                                <Label
                                                                                    Grid.Column="2" Grid.Row="0"
                                                                                    Text="Clasificación:"
                                                                                    FontAttributes="Bold" />
                                                                                <Picker
                                                                                    Grid.Column="2" Grid.Row="1"
                                                                                    SelectedItem="{Binding Classification}"
                                                                                    ItemsSource="{Binding Source={Reference WrapFrame}, Path=BindingContext.Product.Classifications}"
                                                                                    ItemDisplayBinding="{Binding Path=Name}" />
                                                                                <Label
                                                                                    Grid.Column="3" Grid.Row="0"
                                                                                    Text="Almacen:"
                                                                                    FontAttributes="Bold" />
                                                                                <Picker
                                                                                    Grid.Column="3" Grid.Row="1"
                                                                                    SelectedItem="{Binding Warehouse}"
                                                                                    ItemsSource="{Binding Source={Reference Page}, Path=BindingContext.AvailableWarehouses}"
                                                                                    ItemDisplayBinding="{Binding Name}" />
                                                                                <Button
                                                                                    Grid.Column="4" Grid.RowSpan="2"
                                                                                    VerticalOptions="End"
                                                                                    FontFamily="MaterialDesignIcons" 
                                                                                    Text="&#xFA78;" />
                                                                            </Grid>
                                                                        </Frame>
                                                                    </DataTemplate>
                                                                </BindableLayout.ItemTemplate>
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                    </Frame>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Frame>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_contract_configuration_pages:BaseConfigurationContentPage>