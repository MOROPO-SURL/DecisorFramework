<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:DetailBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Purchasing.Interop.API.Common"
    xmlns:interop_common_bridge_models="clr-namespace:MOROPO.Framework.Decisor.Purchasing.Interop.API.Common.Models.Bridge;assembly=MOROPO.Framework.Decisor.Purchasing.Interop.API.Common"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    x:Class="MOROPO.Framework.Decisor.Purchasing.Presentation.Terminal.MAUI.UI.Default.Pages.Detail.LegalProviderBudgetDetailPage"
    x:TypeArguments="interop_common_display_models:LegalProviderBudgetDisplayModel"
    x:DataType="interop_common_display_models:LegalProviderBudgetDisplayModel"
    Title="Detalles de Oferta de Proveedor Jurídico"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid
                Padding="10"
                MaximumWidthRequest="600"
                VerticalOptions="Center">
                <Frame Style="{StaticResource PopupFrameStyle}">
                    <StackLayout Margin="20" Spacing="20">
                        <StackLayout>
                            <Label 
                                Margin="0,0,0,20"
                                Text="Detalles"
                                FontAttributes="Bold"
                                FontSize="Medium" />
                            <Label
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Margin="0"
                                Text="Proveedor" />
                            <Label
                                Style="{StaticResource ValuePropertyLabelStyle}"
                                Text="{Binding Provider.Contact.Identity.Name, Mode=OneTime}" />
                            <Label
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Text="Número/Año" />
                            <Label Style="{StaticResource ValuePropertyLabelStyle}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Number, Mode=OneTime}" />
                                        <Span Text="/" />
                                        <Span Text="{Binding Year, Mode=OneTime}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Text="Comprador" />
                            <Label
                                Style="{StaticResource ValuePropertyLabelStyle}"
                                Text="{Binding Commercial.Contact.Identity, Mode=OneTime}" />
                            <Label
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Text="Productos en oferta" />
                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding ProductBridges, Mode=OneTime}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="interop_common_bridge_models:CommonBugetProductBridgeModel">
                                        <StackLayout Orientation="Horizontal" Spacing="8">
                                            <Label
                                                Style="{StaticResource ValuePropertyLabelStyle}"
                                                VerticalOptions="Center"
                                                FontAttributes="Bold"
                                                Text="-" />
                                            <Label 
                                                Style="{StaticResource ValuePropertyLabelStyle}"
                                                HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Product.Name, Mode=OneTime}" />
                                                        <Span Text=" (" />
                                                        <Span Text="{Binding Amount, StringFormat='{0:F2}', Mode=OneTime}" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding UnitMeasurement.Symbol, Mode=OneTime}" />
                                                        <Span Text=" => " />
                                                        <Span Text="{Binding UnitPrice, StringFormat='{0:F2}', Mode=OneTime}" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding Currency.Symbol, Mode=OneTime}" />
                                                        <Span Text=")" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Text="Descripción" />
                            <Label
                                Style="{StaticResource ValuePropertyLabelStyle}"
                                Text="{Binding Description, TargetNullValue='---', FallbackValue='---', Mode=OneTime}" />
                        </StackLayout>
                        <StackLayout
                            x:Name="OptionButtonsStackLayout"
                            Orientation="Horizontal"
                            Spacing="20">
                            <Button 
                                HorizontalOptions="FillAndExpand"
                                Text="Exportar" />
                            <Button 
                                HorizontalOptions="FillAndExpand"
                                Text="Modificar"
                                Clicked="EditButton_Clicked" />
                            <Button 
                                HorizontalOptions="FillAndExpand"
                                Text="Eliminar"
                                Clicked="DeleteButton_Clicked" />
                        </StackLayout>
                    </StackLayout>
                </Frame>
                <Button
                    Style="{StaticResource DetailPageCloseButtonStyle}"
                    Clicked="DismissControl_Invoked" />
            </Grid>
        </Grid>
    </ScrollView>
</core_ui_base_pages:DetailBaseContentPage>