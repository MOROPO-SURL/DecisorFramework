<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core_presentation_page_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models.Page;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    x:Class="MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default.Pages.SettingPage"
    x:DataType="core_presentation_page_models:SettingPageModel"
    Title="Configuración"
    BackgroundColor="Transparent"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid
                Padding="10"
                MaximumWidthRequest="480"
                VerticalOptions="Center">
                <Frame Style="{StaticResource PopupFrameStyle}">
                    <StackLayout Margin="20" Spacing="20">
                        <StackLayout>
                            <Label 
                                Margin="0,0,0,20"
                                Text="Configuración"
                                FontAttributes="Bold"
                                FontSize="Medium" />
                            <StackLayout Orientation="Vertical">
                                <Label
                                    Style="{StaticResource CaptionFieldLabelStyle}"
                                    HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                    Text="Usar proxy de red" />
                                <Switch 
                                    VerticalOptions="Center"
                                    IsToggled="{Binding UseProxyServer}" />
                            </StackLayout>
                            <VerticalStackLayout IsVisible="{Binding UseProxyServer}">
                                <Label 
                                    Style="{StaticResource CaptionFieldLabelStyle}"
                                    Text="Dirección del servidor proxy" />
                                <Entry
                                    Placeholder="http(s)://proxy.address.net(:3128)"
                                    Text="{Binding ProxyServerAddress}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding UseProxyServer}">
                                <StackLayout Orientation="Horizontal">
                                    <Label
                                        Style="{StaticResource CaptionFieldLabelStyle}"
                                        HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                        Text="Proxy requiere autenticación" />
                                    <Switch 
                                        VerticalOptions="Center"
                                        IsToggled="{Binding UseProxyAuthentication}" />
                                </StackLayout>
                                <VerticalStackLayout IsVisible="{Binding UseProxyAuthentication}">
                                    <Label 
                                        Style="{StaticResource CaptionFieldLabelStyle}"
                                        Text="Usuario de proxy" />
                                    <Entry Text="{Binding ProxyUsername}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout IsVisible="{Binding UseProxyAuthentication}">
                                    <Label 
                                        Style="{StaticResource CaptionFieldLabelStyle}"
                                        Text="Contraseña de proxy" />
                                    <Entry Text="{Binding ProxyPassword}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </StackLayout>
                        <StackLayout
                            Orientation="Horizontal"
                            Spacing="20">
                            <Button 
                                HorizontalOptions="FillAndExpand"
                                Text="Aplicar"
                                Command="{Binding ApplyChangesCommand}" />
                            <Button 
                                HorizontalOptions="FillAndExpand"
                                Text="Cancelar"
                                Clicked="DismissControl_Invoked" />
                        </StackLayout>
                    </StackLayout>
                </Frame>
                <Button
                    Style="{StaticResource DetailPageCloseButtonStyle}"
                    Clicked="DismissControl_Invoked" />
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>