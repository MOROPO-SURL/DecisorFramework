<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ListBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MOROPO.Framework.Decisor.Commercial.Presentation.Terminal.MAUI.UI.Default.Pages.Pick"
    xmlns:financial_card_views="clr-namespace:MOROPO.Framework.Decisor.Financial.Presentation.Terminal.MAUI.UI.Default.Views.Card;assembly=MOROPO.Framework.Decisor.Financial.Presentation.Terminal.MAUI.UI.Default"
    xmlns:financial_interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Financial.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Financial.Interop.API.Common"
    xmlns:presentation_pick_page_models="clr-namespace:MOROPO.Framework.Decisor.Commercial.Presentation.Terminal.MAUI.Models.Page.Pick;assembly=MOROPO.Framework.Decisor.Commercial.Presentation.Terminal.MAUI"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Commercial.Presentation.Terminal.MAUI.UI.Default.Pages.Pick.NaturalClientByContactBankAccountPickPage"
    x:TypeArguments="financial_interop_common_display_models:BankAccountDisplayModel,presentation_pick_page_models:CommonClientByContactBankAccountPickPageModel"
    x:DataType="presentation_pick_page_models:CommonClientByContactBankAccountPickPageModel"
    Title="Seleccionar Cuenta Bancaria">
    <ContentPage.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="ReloadToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF450;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Agregar"
            Clicked="AddToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf415;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <StackLayout Orientation="Vertical">
                <Grid 
                    VerticalOptions="FillAndExpand"
                    SizeChanged="ItemsCollectionViewLayout_SizeChanged">
                    <CollectionView
                        x:Name="ItemsCollectionView"
                        Margin="10"
                        ItemsSource="{Binding Items}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <financial_card_views:BankAccountDefaultCardView HeightRequest="{Static local:LegalClientByContactBankAccountPickPage.ITEM_VIEW_REQUEST_HEIGHT}">
                                    <ContentView.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ItemTapGestureRecognizer_Tapped" />
                                    </ContentView.GestureRecognizers>
                                </financial_card_views:BankAccountDefaultCardView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label
                                IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                HorizontalTextAlignment="Center"
                                Margin="5"
                                Text="Sin elementos que mostrar"
                                TextColor="{AppThemeBinding Light=DimGray, Dark=Gray}"
                                FontAttributes="Italic" />
                        </CollectionView.EmptyView>
                        <CollectionView.Footer>
                            <StackLayout IsVisible="{Binding HasMoreItems}">
                                <Button
                                    HorizontalOptions="Center"
                                    Margin="5"
                                    Text="Mostrar más"
                                    Clicked="LoadMoreBurron_Clicked" />
                            </StackLayout>
                        </CollectionView.Footer>
                    </CollectionView>
                </Grid>
            </StackLayout>
            <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
        </Grid>
    </ContentPage.Content>
</core_ui_base_pages:ListBaseContentPage>