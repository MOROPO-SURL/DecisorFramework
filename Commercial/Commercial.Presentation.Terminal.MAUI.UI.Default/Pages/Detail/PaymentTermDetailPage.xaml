<core_ui_base_pages:DetailBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Commercial.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Commercial.Interop.API.Common"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    x:Class="MOROPO.Framework.Decisor.Commercial.Presentation.Terminal.MAUI.UI.Default.Pages.Detail.PaymentTermDetailPage"
    x:TypeArguments="interop_common_display_models:PaymentTermDisplayModel"
    x:DataType="interop_common_display_models:PaymentTermDisplayModel"
    Title="Detalles de Término de Pago"
    BackgroundColor="Transparent"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid
                Padding="10"
                MaximumWidthRequest="400"
                VerticalOptions="Center">
                <Frame Style="{StaticResource PopupFrameStyle}">
                    <StackLayout Margin="20" Spacing="20">
                        <StackLayout>
                            <Label 
                                Margin="0,0,0,20"
                                Text="Detalles"
                                FontAttributes="Bold"
                                FontSize="Medium" />
                            <Label
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Margin="0"
                                Text="Nombre" />
                            <Label
                                Style="{StaticResource ValuePropertyLabelStyle}"
                                Text="{Binding Name}" />
                            <Label 
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Text="Término" />
                            <Label
                                Style="{StaticResource ValuePropertyLabelStyle}"
                                Text="{Binding Term, StringFormat='{0} día(s)'}" />
                            <Label 
                                Style="{StaticResource CaptionPropertyLabelStyle}"
                                Text="Prioridad" />
                            <Label
                                Style="{StaticResource ValuePropertyLabelStyle}"
                                Text="{Binding Priority}" />
                        </StackLayout>
                    </StackLayout>
                </Frame>
                <Button
                    HorizontalOptions="End" VerticalOptions="Start"
                    Text="&#xf5ad;"
                    FontSize="Medium"
                    FontFamily="MaterialDesignIcons"
                    BorderWidth="0"
                    WidthRequest="48" HeightRequest="48"
                    Clicked="DismissControl_Invoked" />
            </Grid>
        </Grid>
    </ScrollView>
</core_ui_base_pages:DetailBaseContentPage>