<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card.OrganizationalStructuringUnitTreeCardView"
    x:DataType="presentation_configuration_page_models:OrganizationalStructuringUnitConfigurationPageModel"
    IsVisible="{Binding Converter={StaticResource IsNotNullConverter}}">
    <ContentView.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid ColumnSpacing="0" RowSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label
            IsVisible="{Binding Parent, Converter={StaticResource IsNotNullConverter}}"
            Grid.Column="0" Grid.RowSpan="3"
            VerticalOptions="Center"
            Margin="0,0,0,0"
            FontSize="Large"
            FontFamily="MaterialDesignIcons"
            Text="&#xF60D;" />
        <Frame 
            Grid.Column="1" Grid.RowSpan="3"
            Padding="16">
            <VerticalStackLayout Spacing="0">
                <Label
                    FontSize="Medium"
                    Text="{Binding OrganizationalUnit.Name}" />
                <Label 
                    Margin="0,4,0,0"
                    Text="Referencia"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold" />
                <Label Text="{Binding Reference, TargetNullValue='---'}" />               
            </VerticalStackLayout>
        </Frame>
        <Button
            Style="{StaticResource FontIconImageButtonStyle}" 
            Grid.Column="2" Grid.Row="0"
            Margin="8,0,0,0"
            Text="&#xF90B;"
            Clicked="EditChildButton_Clicked" />
        <Button
            Style="{StaticResource DangerKindFontIconImageButtonStyle}" 
            IsVisible="{Binding Parent, Converter={StaticResource IsNotNullConverter}}"
            Grid.Column="2" Grid.Row="1"
            Margin="8,0,0,0"
            Text="&#xFA78;"
            Clicked="RemoveChildButton_Clicked" />
        <Grid
            Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3"
            Margin="8,0,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label 
                Style="{StaticResource CaptionFieldLabelStyle}"
                Grid.Column="0" Grid.Row="0"
                Margin="0,0,0,8"
                VerticalOptions="End"
                Text="Dependencias" />
            <BoxView
                Grid.Column="0" Grid.Row="1"
                Color="DimGray" />
            <Button
                Grid.Column="1" Grid.RowSpan="2"
                HorizontalOptions="Center"
                Text="Agregar"
                Clicked="AddChildButton_Clicked" />
            <CollectionView 
                Grid.ColumnSpan="2" Grid.Row="2"
                ItemsSource="{Binding Children}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Padding="4" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <local:OrganizationalStructuringUnitTreeCardView
                            AddChildButtonClick="AddChildButton_Clicked"
                            EditChildButtonClick="EditChildButton_Clicked"
                            RemoveChildButtonClick="RemoveChildButton_Clicked" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentView>
