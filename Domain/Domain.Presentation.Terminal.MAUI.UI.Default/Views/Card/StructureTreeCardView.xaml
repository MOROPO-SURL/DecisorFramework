<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_card_views="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card.StructureTreeCardView"
    x:DataType="interop_common_display_models:StructureTreeDisplayModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <caneyframework_presentation_converters:ViewChildParentWidthToRelativeWidthConverter x:Key="ItemViewChildParentWidthToRelativeWidthConverter" ReferenceWidth="280" AbsoluteHorizontalSeparation="20" />
            
            <communitytoolkit_converters:IsListNotNullOrEmptyConverter x:Key="IsListNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Frame>
        <VerticalStackLayout>
            <Label
                FontSize="Medium"
                Text="{Binding Identity.Name}" />
            <Label Text="{Binding Kind.Name}" />
            <Label 
                IsVisible="{Binding Children, Converter={StaticResource IsListNotNullOrEmptyConverter}}"
                Style="{StaticResource CaptionPropertyLabelStyle}"
                Text="Unidades Organizativas" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding OrganizationalUnities}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="interop_common_display_models:OrganizationalUnityTreeDisplayModel">
                        <Frame Margin="0,8,0,0">
                            <StackLayout>
                                <Label 
                                    Text="{Binding Name}"
                                    LineBreakMode="TailTruncation" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label 
                IsVisible="{Binding Children, Converter={StaticResource IsListNotNullOrEmptyConverter}}"
                Style="{StaticResource CaptionPropertyLabelStyle}"
                Text="Dependencias" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Children}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <local_card_views:StructureTreeCardView 
                            ItemTapGestureRecognizerTapped="TapGestureRecognizer_Tapped"
                            Margin="0,8,0,0">
                            <ContentView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                            </ContentView.GestureRecognizers>
                        </local_card_views:StructureTreeCardView>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Frame>
</ContentView>
