<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    x:Class="MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card.OrganizationalUnitCardView"
    x:DataType="interop_common_display_models:OrganizationalUnitDisplayModel">
    <Frame Padding="16">
        <VerticalStackLayout>
            <Label
                FontSize="Medium"
                LineBreakMode="TailTruncation"
                Text="{Binding Name}"
                ToolTipProperties.Text="{Binding Name}" />
            <Label 
                Margin="0,8,0,0"
                Text="Descripción"
                TextColor="DimGray"
                FontSize="Caption"
                FontAttributes="Bold" />
            <Label 
                VerticalOptions="FillAndExpand"
                LineBreakMode="TailTruncation"
                MaxLines="2"
                Text="{Binding Description, TargetNullValue='---'}" />
        </VerticalStackLayout>
    </Frame>
</ContentView>
