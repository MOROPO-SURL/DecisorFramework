<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    xmlns:ffimageloading_views="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:Class="MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card.OrganizationContactDefaultCardView"
    x:DataType="interop_common_display_models:OrganizationContactDisplayModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Frame Padding="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ffimageloading_views:CachedImage
                Grid.Column="0"
                Aspect="AspectFill"
                WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}"
                Source="{Binding Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
            <BoxView Grid.Column="1" Color="{AppThemeBinding Light=LightGray, Dark=DimGray}" />
            <StackLayout 
                Grid.Column="2"
                Padding="10">
                <Label 
                    FontAttributes="Bold"
                    FontSize="Medium"
                    LineBreakMode="TailTruncation"
                    Text="{Binding Identity.Name}" />
                <Label 
                    Margin="0,2,0,0"
                    Text="{Binding BusinessKind.Name}" />
                <Label 
                    Margin="0,8,0,0"
                    Text="Descripción"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold" />
                <Label
                    VerticalOptions="FillAndExpand"
                    LineBreakMode="TailTruncation"
                    MaxLines="2"
                    Text="{Binding Identity.About, TargetNullValue='---'}" />
            </StackLayout>
        </Grid>
    </Frame>
</ContentView>
