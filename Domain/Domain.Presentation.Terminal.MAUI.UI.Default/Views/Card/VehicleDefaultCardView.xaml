<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    xmlns:ffimageloading_views="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:Class="MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card.VehicleDefaultCardView"
    x:DataType="interop_common_display_models:VehicleDisplayModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />

            <caneyframework_presentation_converters:DoubleToFractionConverter x:Key="DoubleToFractionConverter" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Frame Padding="0">
        <StackLayout Spacing="0">
            <Grid 
                VerticalOptions="FillAndExpand"
                IsClippedToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <ffimageloading_views:CachedImage
                    Grid.RowSpan="2"
                    Aspect="AspectFill"
                    Error="CachedImage_Error"
                    Source="{Binding FeatureImage, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
                <Grid
                    IsVisible="{Binding Assignment, Converter={StaticResource IsNotNullConverter}}"
                    Grid.Row="0"
                    VerticalOptions="Center"
                    Padding="0,2"
                    BackgroundColor="#A7FFFFFF"
                    Rotation="45"
                    TranslationX="{Binding Source={RelativeSource Mode=Self}, Path=Width, Converter={StaticResource DoubleToFractionConverter}, ConverterParameter=3}">
                    <Label                    
                        Padding="8"
                        BackgroundColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center"
                        FontAttributes="Bold"
                        TextColor="White"
                        Text="{Binding Assignment}" />
                </Grid>
            </Grid>
            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=LightGray, Dark=DimGray}" />
            <StackLayout
                IsClippedToBounds="True"
                Padding="10">
                <Label
                    LineBreakMode="TailTruncation"
                    FontAttributes="Bold"
                    Text="{Binding Kind.Name}" />
                <Label                    
                    LineBreakMode="TailTruncation"
                    FontSize="Medium">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Brand.Name}" />
                            <Span Text=" " />
                            <Span Text="{Binding Model}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label                    
                    LineBreakMode="TailTruncation"
                    FontAttributes="Bold"
                    Text="{Binding Plate}" />
            </StackLayout>
        </StackLayout>
    </Frame>
</ContentView>
