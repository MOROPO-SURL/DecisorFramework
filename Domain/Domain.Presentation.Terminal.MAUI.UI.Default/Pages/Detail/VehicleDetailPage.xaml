<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:DetailBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Pages.Detail.VehicleDetailPage"
    x:TypeArguments="interop_common_display_models:VehicleDisplayModel"
    x:DataType="interop_common_display_models:VehicleDisplayModel"
    Title="Detalles de Vehículo"
    BackgroundColor="Transparent"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />

            <caneyframework_presentation_converters:DoubleToFractionConverter x:Key="DoubleToFractionConverter" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid
                Padding="10"
                MaximumWidthRequest="720"
                VerticalOptions="Center">
                <Frame Style="{StaticResource PopupFrameStyle}">
                    <VerticalStackLayout Margin="12" Padding="8">
                        <VerticalStackLayout>
                            <Frame
                                Margin="8"
                                Padding="0">
                                <Grid 
                                    VerticalOptions="FillAndExpand"
                                    IsClippedToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Image
                                        Grid.RowSpan="2"
                                        Aspect="AspectFill"
                                        HeightRequest="{Binding Source={RelativeSource AncestorType={Type Grid}, AncestorLevel=2}, Path=Width, Converter={StaticResource DoubleToFractionConverter}, ConverterParameter=1.8}"
                                        Source="{Binding FeatureImage, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
                                    <Grid
                                        IsVisible="{Binding Assignment, Converter={StaticResource IsNotNullConverter}}"
                                        Grid.Row="0"
                                        VerticalOptions="Center"
                                        Padding="0,2"
                                        BackgroundColor="#A7FFFFFF"
                                        Rotation="45"
                                        TranslationX="{Binding Source={RelativeSource Mode=Self}, Path=Width, Converter={StaticResource DoubleToFractionConverter}, ConverterParameter=3}">
                                        <Label                    
                                            Padding="8"
                                            BackgroundColor="{StaticResource Primary}"
                                            HorizontalTextAlignment="Center"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            Text="{Binding Assignment}" />
                                    </Grid>
                                </Grid>
                            </Frame>
                            <Label
                                Margin="8,4"
                                LineBreakMode="TailTruncation"
                                FontSize="Large"
                                Text="{Binding Reference}" />
                            <VerticalStackLayout 
                                Margin="8,4"
                                Spacing="6">
                                <Label 
                                    Style="{StaticResource CaptionPropertyLabelStyle}" 
                                    Text="Entidad Administrativa" />
                                <Label 
                                    Style="{StaticResource ValuePropertyLabelStyle}"
                                    Text="{Binding Structure.Identity.Name}" />
                            </VerticalStackLayout>
                            <FlexLayout 
                                Wrap="Wrap"
                                AlignItems="Start" 
                                AlignContent="Start">
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                    Margin="4"
                                    Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                                        Text="Marca" />
                                    <Label 
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Brand.Name}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                    Margin="4"
                                    Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                                        Text="Modelo" />
                                    <Label 
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Model}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                    Margin="4"
                                    Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                                        Text="Tipo" />
                                    <Label 
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Kind.Name}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                    Margin="4"
                                    Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                                        Text="Año" />
                                    <Label 
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Year}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                    Margin="4"
                                    Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                                        Text="Chapa" />
                                    <Label 
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding Plate}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                    Margin="4"
                                    Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                                        Text="No. de Circulación" />
                                    <Label 
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding TrafficCirculationIdentifier}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                    Margin="4"
                                    Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                                        Text="No. de Carrocería" />
                                    <Label 
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding BodyIdentifier}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                    Margin="4"
                                    Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                                        Text="No. de Motor" />
                                    <Label 
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding BodyIdentifier}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                    Margin="4"
                                    Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                                        Text="Tipo de Motorización" />
                                    <Label 
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding EngineKind.Name}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                    Margin="4"
                                    Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                                        Text="No. de Asientos" />
                                    <Label 
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding SeatCount}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                    Margin="4"
                                    Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                                        Text="Capacidad de Carga" />
                                    <Label 
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding LoadCapacity, StringFormat='{0:F2} ton'}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout 
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                    Margin="4"
                                    Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionPropertyLabelStyle}" 
                                        Text="Disponibilidad Técnica" />
                                    <Label 
                                        Style="{StaticResource ValuePropertyLabelStyle}"
                                        Text="{Binding TechnicalAvailabilityIndex, StringFormat='{0}%'}" />
                                </VerticalStackLayout>
                            </FlexLayout>
                            <VerticalStackLayout Margin="8,4">
                                <Label 
                                    Style="{StaticResource CaptionPropertyLabelStyle}"
                                    Text="Descripción" />
                                <Label
                                    Style="{StaticResource ValuePropertyLabelStyle}"
                                    Text="{Binding Description, TargetNullValue='---'}" />
                                <Label 
                                    Style="{StaticResource CaptionPropertyLabelStyle}"
                                    Text="Prioridad" />
                                <Label
                                    Style="{StaticResource ValuePropertyLabelStyle}"
                                    Text="{Binding Priority}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <StackLayout
                            x:Name="OptionsStackLayout"
                            Margin="8,16,8,8"
                            Orientation="Horizontal"
                            Spacing="20">
                            <Button 
                                HorizontalOptions="FillAndExpand"
                                Text="Modificar"
                                Clicked="EditButton_Clicked" />
                            <Button 
                                HorizontalOptions="FillAndExpand"
                                Text="Eliminar"
                                Clicked="DeleteButton_Clicked" />
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>
                <Button
                    Style="{StaticResource DetailPageCloseButtonStyle}"
                    Clicked="DismissControl_Invoked" />
            </Grid>
        </Grid>
    </ScrollView>
</core_ui_base_pages:DetailBaseContentPage>