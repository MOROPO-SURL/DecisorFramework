<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_constants="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Constants"
    xmlns:local_default_card_views="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Views.Card"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_behaviors="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Behaviors;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_default_constants="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default.Constants;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default"
    xmlns:core_ui_default_card_views="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default.Views.Card;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Core.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Core.Interop.API.Common"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.PersonContactConfigurationPage"
    x:TypeArguments="interop_common_display_models:PersonContactDisplayModel,interop_common_display_models:PersonContactDisplayModel,presentation_configuration_page_models:PersonContactConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:PersonContactConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="WrapFlexLayoutItemResponsiveWithConverter" WrapSpacing="4" SingleSpacing="0" />
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="PostalContactDetailFlexLayoutItemResponsiveWithConverter" SingleSpacing="8" />
            <core_ui_converters:StringToLocalizedStringConverter x:Key="StringToLocalizedStringConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyErrorMessageConverter x:Key="ValidationResultToTargetPropertyErrorMessageConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyHasErrorConverter x:Key="ValidationResultToTargetPropertyHasErrorConverter" />
            
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="0" Padding="8">
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <Frame
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=3, LargeContainerColumn=4, SmallContainerColumn=6}}"
                        HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                        VerticalOptions="Start"
                        Margin="4"
                        Padding="0">
                        <Grid>
                            <Image Source="{Binding ImageSource, TargetNullValue='default_person_picture.jpg'}" />
                            <Grid BackgroundColor="#A7000000">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ImageLayoutTapGestureRecognizer_Tapped" />
                                </Grid.GestureRecognizers>
                                <Label
                                    Text="&#xF8CB;"
                                    TextColor="White"
                                    HorizontalOptions="Center" VerticalOptions="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="96" />
                            </Grid>
                        </Grid>
                    </Frame>
                    <Grid WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource WrapFlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=9, LargeContainerColumn=8, MediumContainerColumn=12}}">
                        <FlexLayout 
                            Wrap="Wrap"
                            AlignItems="Start" AlignContent="Start">
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}, AncestorLevel=1}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=6, MediumContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                                <Entry Text="{Binding Name}" />
                                <Label
                                    IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:PersonContactConfigurationPageModel.NameValidableProperty}}"
                                    Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:PersonContactConfigurationPageModel.NameValidableProperty}}"
                                    Style="{StaticResource ValidationMessageLabelStyle}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=6, MediumContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Apellidos" />
                                <Entry Text="{Binding LastName}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Identificador personal (opcional)" />
                                <Entry Text="{Binding PersonalIdentificationNumber}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Alias (opcional)" />
                                <Entry Text="{Binding Alias}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Color de piel" />
                                <Picker 
                                    x:Name="SkinKindPicker" 
                                    ItemsSource="{Static presentation_configuration_page_models:PersonContactConfigurationPageModel.AVAILABLE_SKIN_KINDS}"
                                    ItemDisplayBinding="{Binding Converter={StaticResource StringToLocalizedStringConverter}}"
                                    SelectedItem="{Binding SkinKind}"
                                    SelectedIndexChanged="Picker_SelectedIndexChanged" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Sexo" />
                                <Picker 
                                    x:Name="SexPicker" 
                                    ItemsSource="{Static presentation_configuration_page_models:PersonContactConfigurationPageModel.AVAILABLE_SEXS}"
                                    ItemDisplayBinding="{Binding Converter={StaticResource StringToLocalizedStringConverter}}"
                                    SelectedItem="{Binding Sex}"
                                    SelectedIndexChanged="Picker_SelectedIndexChanged" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, SmallContainerColumn=6}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Estado Civil" />
                                <Picker 
                                    x:Name="CivilStatusPicker" 
                                    ItemsSource="{Static presentation_configuration_page_models:PersonContactConfigurationPageModel.AVAILABLE_CIVIL_STATUSES}"
                                    ItemDisplayBinding="{Binding Converter={StaticResource StringToLocalizedStringConverter}}"
                                    SelectedItem="{Binding CivilStatus}"
                                    SelectedIndexChanged="Picker_SelectedIndexChanged" />
                            </VerticalStackLayout>
                        </FlexLayout>
                    </Grid>
                </FlexLayout>
                <FlexLayout
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=6, LargeContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Teléfonos" />
                        <Frame Padding="8">
                            <Grid RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    Grid.Column="1" Grid.Row="0"
                                    HorizontalOptions="End"
                                    Text="Agregar"
                                    Clicked="PhoneContactItemAgregationButton_Clicked" />
                                <BoxView
                                    Style="{StaticResource SeparatorBoxView}"
                                    Grid.ColumnSpan="2" Grid.Row="1" />
                                <CollectionView
                                    Grid.ColumnSpan="2" Grid.Row="2"
                                    ItemsSource="{Binding PhoneContactItems}">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.EmptyView>
                                        <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="core_interop_common_display_models:PhoneContactItemDisplayModel">
                                            <Frame 
                                                Padding="8"
                                                Margin="0,12,0,0">
                                                <StackLayout Orientation="Horizontal" Spacing="8">
                                                    <VerticalStackLayout 
                                                        HorizontalOptions="FillAndExpand"
                                                        Margin="8">
                                                        <Label 
                                                            IsVisible="{Binding Label, Converter={StaticResource IsNotNullConverter}}"
                                                            Margin="4,0"
                                                            Text="{Binding Label}"
                                                            LineBreakMode="TailTruncation"
                                                            FontAttributes="Bold" />
                                                        <Label 
                                                            Margin="8,4" 
                                                            Text="{Binding PhoneNumber}"
                                                            LineBreakMode="TailTruncation"
                                                            FontSize="Medium" />
                                                    </VerticalStackLayout>
                                                    <Button
                                                        VerticalOptions="Center"
                                                        Style="{StaticResource FontIconImageButtonStyle}" 
                                                        Text="&#xF90B;"
                                                        Clicked="PhoneContactItemEditionButton_Clicked" />
                                                    <Button
                                                        VerticalOptions="Center"
                                                        Style="{StaticResource DangerKindFontIconImageButtonStyle}" 
                                                        Text="&#xFA78;"
                                                        Clicked="PhoneContactItemRemotionButton_Clicked" />
                                                </StackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=6, LargeContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Correos electrónicos" />
                        <Frame Padding="8">
                            <Grid RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    Grid.Column="1" Grid.Row="0"
                                    HorizontalOptions="End"
                                    Text="Agregar"
                                    Clicked="EmailContactItemAgregationButton_Clicked" />
                                <BoxView
                                    Style="{StaticResource SeparatorBoxView}"
                                    Grid.ColumnSpan="2" Grid.Row="1" />
                                <CollectionView
                                    Grid.ColumnSpan="2" Grid.Row="2"
                                    ItemsSource="{Binding EmailContactItems}">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.EmptyView>
                                        <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="core_interop_common_display_models:EmailContactItemDisplayModel">
                                            <Frame 
                                                Padding="8"
                                                Margin="0,12,0,0">
                                                <StackLayout Orientation="Horizontal" Spacing="8">
                                                    <VerticalStackLayout 
                                                        HorizontalOptions="FillAndExpand"
                                                        Margin="8">
                                                        <Label 
                                                            IsVisible="{Binding Label, Converter={StaticResource IsNotNullConverter}}"
                                                            Margin="4,0"
                                                            Text="{Binding Label}"
                                                            LineBreakMode="TailTruncation"
                                                            FontAttributes="Bold" />
                                                        <Label 
                                                            Margin="8,4" 
                                                            Text="{Binding EmailAddress}"
                                                            LineBreakMode="TailTruncation"
                                                            FontSize="Medium" />
                                                    </VerticalStackLayout>
                                                    <Button
                                                        VerticalOptions="Center"
                                                        Style="{StaticResource FontIconImageButtonStyle}" 
                                                        Text="&#xF90B;"
                                                        Clicked="EmailContactItemEditionButton_Clicked" />
                                                    <Button
                                                        VerticalOptions="Center"
                                                        Style="{StaticResource DangerKindFontIconImageButtonStyle}" 
                                                        Text="&#xFA78;"
                                                        Clicked="EmailContactItemRemotionButton_Clicked" />
                                                </StackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=6, LargeContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Direcciones postales" />
                        <Frame Padding="8">
                            <Grid RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    Grid.Column="1" Grid.Row="0"
                                    HorizontalOptions="End"
                                    Text="Agregar"
                                    Clicked="PostalContactItemAgregationButton_Clicked" />
                                <BoxView
                                    Style="{StaticResource SeparatorBoxView}"
                                    Grid.ColumnSpan="2" Grid.Row="1" />
                                <CollectionView
                                    Grid.ColumnSpan="2" Grid.Row="2"
                                    ItemsSource="{Binding PostalContactItems}">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.EmptyView>
                                        <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="core_interop_common_display_models:PostalContactItemDisplayModel">
                                            <Frame 
                                                Padding="8"
                                                Margin="0,12,0,0">
                                                <StackLayout Orientation="Horizontal">
                                                    <VerticalStackLayout 
                                                        HorizontalOptions="FillAndExpand"
                                                        Margin="8">
                                                        <Label 
                                                            IsVisible="{Binding Label, Converter={StaticResource IsNotNullConverter}}"
                                                            Margin="4,0"
                                                            Text="{Binding Label}"
                                                            FontSize="Medium" />
                                                        <BoxView 
                                                            IsVisible="{Binding Label, Converter={StaticResource IsNotNullConverter}}"
                                                            Margin="4,8"
                                                            HeightRequest="1"
                                                            Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray100}}" />
                                                        <Label Margin="8,4" Text="{Binding Address}" />
                                                        <FlexLayout
                                                            Wrap="Wrap"
                                                            AlignItems="Start" AlignContent="Start">
                                                            <VerticalStackLayout 
                                                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource PostalContactDetailFlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                                                Margin="4"
                                                                Spacing="6">
                                                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Provincia" />
                                                                <Label Text="{Binding Municipality.State.Name}" />
                                                            </VerticalStackLayout>
                                                            <VerticalStackLayout 
                                                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource PostalContactDetailFlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                                                Margin="4"
                                                                Spacing="6">
                                                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Municipio" />
                                                                <Label Text="{Binding Municipality.Name}" />
                                                            </VerticalStackLayout>
                                                            <VerticalStackLayout 
                                                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource PostalContactDetailFlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=4, SmallContainerColumn=6}}"
                                                                Margin="4"
                                                                Spacing="6">
                                                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Código Postal" />
                                                                <Label Text="{Binding ZipCode, TargetNullValue='---'}" />
                                                            </VerticalStackLayout>
                                                        </FlexLayout>
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Spacing="8">
                                                        <Button
                                                            Style="{StaticResource FontIconImageButtonStyle}" 
                                                            Text="&#xF90B;"
                                                            Clicked="PostalContactItemEditionButton_Clicked" />
                                                        <Button
                                                            VerticalOptions="Start"
                                                            Style="{StaticResource DangerKindFontIconImageButtonStyle}" 
                                                            Text="&#xFA78;"
                                                            Clicked="PostalContactItemRemotionButton_Clicked" />
                                                    </VerticalStackLayout>
                                                </StackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=6, LargeContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Sitios de Internet" />
                        <Frame Padding="8">
                            <Grid RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    Grid.Column="1" Grid.Row="0"
                                    HorizontalOptions="End"
                                    Text="Agregar"
                                    Clicked="WebContactItemAgregationButton_Clicked" />
                                <BoxView
                                    Style="{StaticResource SeparatorBoxView}"
                                    Grid.ColumnSpan="2" Grid.Row="1" />
                                <CollectionView
                                    Grid.ColumnSpan="2" Grid.Row="2"
                                    ItemsSource="{Binding WebContactItems}">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.EmptyView>
                                        <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="core_interop_common_display_models:WebContactItemDisplayModel">
                                            <Frame 
                                                Padding="8"
                                                Margin="0,12,0,0">
                                                <StackLayout Orientation="Horizontal" Spacing="8">
                                                    <VerticalStackLayout 
                                                        HorizontalOptions="FillAndExpand"
                                                        Margin="8">
                                                        <Label 
                                                            IsVisible="{Binding Label, Converter={StaticResource IsNotNullConverter}}"
                                                            Margin="4,0"
                                                            Text="{Binding Label}"
                                                            LineBreakMode="TailTruncation"
                                                            FontAttributes="Bold" />
                                                        <Label 
                                                            Margin="8,4" 
                                                            Text="{Binding Url}"
                                                            FontSize="Medium" />
                                                    </VerticalStackLayout>
                                                    <Button
                                                        VerticalOptions="Center"
                                                        Style="{StaticResource FontIconImageButtonStyle}" 
                                                        Text="&#xF90B;"
                                                        Clicked="WebContactItemEditionButton_Clicked" />
                                                    <Button
                                                        VerticalOptions="Center"
                                                        Style="{StaticResource DangerKindFontIconImageButtonStyle}" 
                                                        Text="&#xFA78;"
                                                        Clicked="WebContactItemRemotionButton_Clicked" />
                                                </StackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descrición (Opcional)" />
                    <Editor Text="{Binding About}" HeightRequest="200" />
                </VerticalStackLayout>
                <FlexLayout
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=4, ExtraLargeContainerColumn=6, LargeContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Doctorados" />
                        <Frame Padding="8">
                            <Grid RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    Grid.Column="1" Grid.Row="0"
                                    HorizontalOptions="End"
                                    Text="Agregar"
                                    Clicked="DoctorateAcademicAchievementAgregationButton_Clicked" />
                                <BoxView
                                    Style="{StaticResource SeparatorBoxView}"
                                    Grid.ColumnSpan="2" Grid.Row="1" />
                                <CollectionView
                                    Grid.ColumnSpan="2" Grid.Row="2"
                                    ItemsSource="{Binding DoctorateAcademicAchievements}">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.EmptyView>
                                        <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid 
                                                ColumnSpacing="8" RowSpacing="8"
                                                HeightRequest="{Static local_constants:CardViewHeightConstants.ACADEMIC_ACHIVEMENT_DEFAULT_CARD_VIEW_HEIGHT}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
