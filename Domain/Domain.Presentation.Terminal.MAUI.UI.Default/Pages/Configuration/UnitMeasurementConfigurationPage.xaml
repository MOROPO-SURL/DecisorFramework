<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"    
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"    
    xmlns:interop_common_bridge_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Bridge;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    x:Class="MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.UnitMeasurementConfigurationPage"
    x:TypeArguments="interop_common_display_models:UnitMeasurementDisplayModel,interop_common_display_models:UnitMeasurementDisplayModel,presentation_configuration_page_models:UnitMeasurementConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:UnitMeasurementConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:ValidationResultToTargetPropertyErrorMessageConverter x:Key="ValidationResultToTargetPropertyErrorMessageConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyHasErrorConverter x:Key="ValidationResultToTargetPropertyHasErrorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="0" Padding="8">
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=11,ExtraLargeContainerColumn=10, LargeContainerColumn=9, MediumContainerColumn=12, SmallContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                        <Entry Text="{Binding Name}" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:UnitMeasurementConfigurationPageModel.NameValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:UnitMeasurementConfigurationPageModel.NameValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=1,ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=2, SmallContainerColumn=4}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Símbolo" />
                        <Entry Text="{Binding Symbol}" />
                        <Label
                            IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static presentation_configuration_page_models:UnitMeasurementConfigurationPageModel.SymbolValidableProperty}}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static presentation_configuration_page_models:UnitMeasurementConfigurationPageModel.SymbolValidableProperty}}"
                            Style="{StaticResource ValidationMessageLabelStyle}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Conversiones" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar"
                                Clicked="ConvertionBridgeAgregationButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="{StaticResource Gray050}" />
                            <CollectionView
                                Grid.ColumnSpan="2" Grid.Row="2"
                                ItemsSource="{Binding ConvertionBridges}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="interop_common_bridge_models:UnitMeasurementConvertionBridgeModel">
                                        <Frame 
                                            Padding="8"
                                            Margin="0,12,0,0">
                                            <StackLayout Orientation="Horizontal" Spacing="8">
                                                <Label
                                                    HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                                    FontSize="Medium">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Unidad = " />
                                                            <Span Text="{Binding Convertion, StringFormat='{0:F}'}" />
                                                            <Span Text=" " />
                                                            <Span Text="{Binding Destination.Name}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Button
                                                    VerticalOptions="Center"
                                                    FontFamily="MaterialDesignIcons" 
                                                    Text="&#xF90B;"
                                                    Clicked="ConvertionBridgeEditionButton_Clicked" />
                                                <Button
                                                    VerticalOptions="Center"
                                                    FontFamily="MaterialDesignIcons" 
                                                    Text="&#xFA78;"
                                                    Clicked="ConvertionBridgeRemotionButton_Clicked" />
                                            </StackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <BoxView 
                    Margin="8,16,8,8"
                    HeightRequest="1" 
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray100}}" />
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <Grid
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        ColumnSpacing="6" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Row="0"
                            Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                        <Entry
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            IsReadOnly="True"
                            Text="{Binding Priority}" />
                        <Stepper
                            Grid.Row="1"
                            Margin="0,0,6,0"
                            HorizontalOptions="End" VerticalOptions="Center"
                            Minimum="1"
                            Maximum="100"
                            Value="{Binding Priority}" />
                    </Grid>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_ui_base_pages:ConfigurationBaseContentPage>