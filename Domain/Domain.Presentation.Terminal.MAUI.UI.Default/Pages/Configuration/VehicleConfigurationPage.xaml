<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.VehicleConfigurationPage"
    x:TypeArguments="interop_common_display_models:VehicleDisplayModel,presentation_configuration_page_models:VehicleConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:VehicleConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="RootFlexLayoutItemResponsiveWithConverter" SingleSpacing="4" />
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="WrappedFlexLayoutItemResponsiveWithConverter" WrapSpacing="4" SingleSpacing="4" />
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="PostalContactDetailFlexLayoutItemResponsiveWithConverter" SingleSpacing="8" />

            <caneyframework_presentation_converters:DoubleToFractionConverter x:Key="DoubleToFractionConverter" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyControl_Invoked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelControl_Invoked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="0" Padding="8">
                <FlexLayout
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <Frame
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                        HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width, Converter={StaticResource DoubleToFractionConverter}, ConverterParameter=1.777777777777778}"
                        VerticalOptions="Start"
                        Margin="4"
                        Padding="0">
                        <Grid>
                            <Image 
                                Aspect="AspectFill"
                                Source="{Binding Path=FeatureImageSource, TargetNullValue='default_organization_picture.png'}" />
                            <Grid BackgroundColor="#A7000000">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ImageLayoutTapGestureRecognizer_Tapped" />
                                </Grid.GestureRecognizers>
                                <Label
                                    Text="&#xF8CB;"
                                    TextColor="White"
                                    HorizontalOptions="Center" VerticalOptions="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="96" />
                            </Grid>
                        </Grid>
                    </Frame>
                    <StackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}">
                        <FlexLayout
                            Wrap="Wrap">
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Unidad Administrativa" />
                                <Picker 
                                    x:Name="StructurePicker" 
                                    ItemsSource="{Binding AvailableStructures}"
                                    ItemDisplayBinding="{Binding Identity.Name}"
                                    SelectedIndexChanged="Picker_SelectedIndexChanged" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="No. Activo Fijo" />
                                <Entry Text="{Binding Reference}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Marca" />
                                <Picker 
                                    x:Name="BrandPicker" 
                                    ItemsSource="{Binding AvailableBrands}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedIndexChanged="Picker_SelectedIndexChanged" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Modelo" />
                                <Entry Text="{Binding Model}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Año" />
                                <Entry Text="{Binding Year}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tipo" />
                                <Picker 
                                    x:Name="KindPicker" 
                                    ItemsSource="{Binding AvailableKinds}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedIndexChanged="Picker_SelectedIndexChanged" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Chapa" />
                                <Entry Text="{Binding Plate}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="No. de Circulación" />
                                <Entry Text="{Binding TrafficCirculationIdentifier}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Tipo de Motorización" />
                                <Picker 
                                    x:Name="EngineKindPicker" 
                                    ItemsSource="{Binding AvailableEngineKinds}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedIndexChanged="Picker_SelectedIndexChanged" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="No. Motor" />
                                <Entry Text="{Binding EngineIdentifier}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="No. de Carrocería" />
                                <Entry Text="{Binding BodyIdentifier}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="No. de Asientos" />
                                <Frame 
                                    CornerRadius="4"
                                    Padding="10,5,5,5">
                                    <StackLayout Orientation="Horizontal">
                                        <Label
                                            Grid.Column="0" Grid.Row="1"
                                            HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                            Text="{Binding SeatCount}" />
                                        <Stepper 
                                            Grid.Column="1" Grid.Row="1"
                                            VerticalOptions="Center"
                                            Value="{Binding SeatCount}" />
                                    </StackLayout>
                                </Frame>
                            </VerticalStackLayout>
                            <Grid 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label 
                                    Grid.ColumnSpan="2" Grid.Row="0"
                                    Style="{StaticResource CaptionFieldLabelStyle}" 
                                    Text="Capacidad de Carga" />
                                <Entry 
                                    Grid.Column="0" Grid.Row="1"
                                    Text="{Binding LoadCapacity, StringFormat='{0:F2}'}" />
                                <Label
                                    Grid.Column="1" Grid.Row="1"
                                    VerticalOptions="Center"
                                    Text="Ton"
                                    FontSize="Medium" />
                            </Grid>
                        </FlexLayout>
                    </StackLayout>
                </FlexLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descrición (Opcional)" />
                    <Editor Text="{Binding Description}" HeightRequest="120" />
                </VerticalStackLayout>
                <BoxView 
                    Margin="8,16,8,8"
                    HeightRequest="1" 
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray100}}" />
                <FlexLayout
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                        <Picker SelectedItem="{Binding Priority}" ItemsSource="{StaticResource PriorityValues}" />
                    </VerticalStackLayout>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_ui_base_pages:ConfigurationBaseContentPage>