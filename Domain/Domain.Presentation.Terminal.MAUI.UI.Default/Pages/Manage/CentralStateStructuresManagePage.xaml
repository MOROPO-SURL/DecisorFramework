<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_manage_page_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.Models.Page.Manage;assembly=MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Domain.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Domain.Interop.API.Common"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.Framework.Decisor.Domain.Presentation.Terminal.MAUI.UI.Default.Pages.Manage.CentralStateStructuresManagePage"
    x:DataType="presentation_manage_page_models:CentralStateStructuresManagePageModel"
    Title="Gestión de Organismos de la Administración Central del Estado">
    <ContentPage.Resources>
        <ResourceDictionary>
            <caneyframework_presentation_converters:ViewChildParentWidthToRelativeWidthConverter x:Key="ItemViewChildParentWidthToRelativeWidthConverter" ReferenceWidth="560" AbsoluteHorizontalSeparation="20" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />

            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />

            <Style TargetType="Label" x:Key="CaptionFieldLabelStyle">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=DimGray, Dark=Gray}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="Caption" />
                <Setter Property="Margin" Value="0,16,0,0" />
            </Style>
            <Style TargetType="Label" x:Key="ValueFieldLabelStyle">
                <Setter Property="FontSize" Value="Default" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Agregar"
            Clicked="AddToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf415;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="ReloadToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF450;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <StackLayout Orientation="Vertical">
                <SearchBar Margin="20,20,20,0" />
                <ScrollView 
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand">
                    <FlexLayout
                        Margin="10"
                        Wrap="Wrap"
                        AlignItems="Start" AlignContent="Start"
                        BindableLayout.ItemsSource="{Binding Items}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    x:DataType="interop_common_display_models:CentralStateStructureDisplayModel"
                                    Margin="5" Padding="0"
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource ItemViewChildParentWidthToRelativeWidthConverter}}"
                                    HeightRequest="140">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ItemTapGestureRecognizer_Tapped" />
                                    </Frame.GestureRecognizers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0" Grid.RowSpan="3"
                                            Aspect="AspectFill"
                                            WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}"
                                            Source="{Binding Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
                                        <StackLayout 
                                            Grid.Column="1"
                                            Padding="10">
                                            <Label 
                                                FontAttributes="Bold"
                                                FontSize="Medium"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding Identity.Name}" />
                                            <Label 
                                                Margin="0,8,0,0"
                                                Text="Descripción"
                                                TextColor="DimGray"
                                                FontSize="Caption"
                                                FontAttributes="Bold" />
                                            <Label
                                                VerticalOptions="FillAndExpand"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="2"
                                                Text="{Binding Identity.About, TargetNullValue='---'}" />
                                        </StackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                        <BindableLayout.EmptyView>
                            <Label
                                HorizontalTextAlignment="Center"
                                Margin="5"
                                Text="Sin elementos que mostrar"
                                TextColor="{AppThemeBinding Light=DimGray, Dark=Gray}"
                                FontAttributes="Italic" />
                        </BindableLayout.EmptyView>
                    </FlexLayout>
                </ScrollView>
            </StackLayout>
            <ContentView 
                IsVisible="{Binding PresentedItem, Converter={StaticResource IsNotNullConverter}}"
                Style="{StaticResource ModalFrameWrapContentViewStyle}">
                <ScrollView Orientation="Vertical">
                    <Grid>
                        <Frame
                            VerticalOptions="Center" HorizontalOptions="Center"
                            Padding="0" Margin="20"
                            WidthRequest="400">
                            <Grid>
                                <StackLayout Margin="20" Spacing="20">
                                    <StackLayout>
                                        <Label 
                                            Margin="0,0,0,20"
                                            Text="Detalles"
                                            FontAttributes="Bold"
                                            FontSize="Medium" />
                                        <Label
                                            Style="{StaticResource CaptionFieldLabelStyle}"
                                            Margin="0"
                                            Text="Nombre" />
                                        <Label
                                            Style="{StaticResource ValueFieldLabelStyle}"
                                            Text="{Binding PresentedItem.Identity.Name}" />
                                        <Label 
                                            Style="{StaticResource CaptionFieldLabelStyle}"
                                            Text="Prioridad" />
                                        <Label
                                            Style="{StaticResource ValueFieldLabelStyle}"
                                            Text="{Binding PresentedItem.Priority}" />
                                        <Label 
                                            Style="{StaticResource CaptionFieldLabelStyle}"
                                            Text="Descripción" />
                                        <Label
                                            Style="{StaticResource ValueFieldLabelStyle}"
                                            Text="{Binding PresentedItem.Identity.About, TargetNullValue='---'}" />
                                    </StackLayout>
                                    <StackLayout
                                        Orientation="Horizontal"
                                        Spacing="20">
                                        <Button 
                                            HorizontalOptions="FillAndExpand"
                                            Text="Modificar"
                                            Clicked="PresentedItemEditButton_Clicked" />
                                        <Button 
                                            HorizontalOptions="FillAndExpand"
                                            Text="Eliminar"
                                            Clicked="PresentedItemRemoveButton_Clicked" />
                                    </StackLayout>
                                </StackLayout>
                                <Button
                                    HorizontalOptions="End" VerticalOptions="Start"
                                    Padding="10"
                                    BackgroundColor="Transparent"
                                    Text="&#xf5ad;"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    FontSize="Medium"
                                    FontFamily="MaterialDesignIcons"
                                    BorderWidth="0"
                                    WidthRequest="48" HeightRequest="48"
                                    Clicked="PresentedItemDismissButton_Clicked" />
                            </Grid>
                        </Frame>
                    </Grid>
                </ScrollView>
            </ContentView>
            <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
        </Grid>
    </ContentPage.Content>
</caneyframework_mvvm_pages:ContentPage>