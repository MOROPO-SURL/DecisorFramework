<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:BindingContextedContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_page_models="clr-namespace:MOROPO.Framework.Decisor.Supervision.Presentation.Terminal.MAUI.Models.Page;assembly=MOROPO.Framework.Decisor.Supervision.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:live_charts_controls="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    x:Class="MOROPO.Framework.Decisor.Supervision.Presentation.Terminal.MAUI.UI.Default.Pages.PurchasingDashboardPage"
    x:TypeArguments="presentation_page_models:PurchasingDashboardPageModel"
    x:DataType="presentation_page_models:PurchasingDashboardPageModel"
    Title="Panel de Control para Compras">
    <ContentPage.Resources>
        <ResourceDictionary>
            <caneyframework_presentation_converters:ViewChildParentWidthToRelativeWidthConverter x:Key="CountCardItemViewChildParentWidthToRelativeWidthConverter" ReferenceWidth="360" AbsoluteHorizontalSeparation="20" />
            
            <Style x:Key="CardHeaderSeparatorBoxViewStyle" TargetType="BoxView">
                <Setter Property="Color" Value="DimGray" />
                <Setter Property="Margin" Value="0,5,0,10" />
                <Setter Property="HeightRequest" Value="2" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout>
                <Grid 
                    Margin="20"
                    ColumnSpacing="20" RowSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Frame 
                        Grid.Column="0"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label
                                FontSize="Medium"
                                FontAttributes="Bold"
                                Text="Actividad de Compra (6 meses)" />
                            <BoxView Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <live_charts_controls:CartesianChart 
                                HeightRequest="360" 
                                Series="{Binding PurchaseLastMonthsCountAreaChart.Series}"
                                XAxes="{Binding PurchaseLastMonthsCountAreaChart.XAxes}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label
                                FontSize="Medium"
                                FontAttributes="Bold"
                                Text="Compras por Zonas" />
                            <BoxView Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <live_charts_controls:PieChart 
                                HeightRequest="360"
                                Series="{Binding PurchaseZonePurchasesDoughnutChart.Series}"
                                LegendPosition="Bottom" />
                        </StackLayout>
                    </Frame>
                </Grid>
                <Frame Margin="20,0">
                    <StackLayout>
                        <Label
                            FontSize="Medium"
                            FontAttributes="Bold"
                            Text="Compras a Principales Proveedores (6 meses)" />
                        <BoxView Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                        <live_charts_controls:CartesianChart 
                            MinimumHeightRequest="300"
                            Series="{Binding ProviderPurchasingAmountHeatChart.Series}"
                            XAxes="{Binding ProviderPurchasingAmountHeatChart.XAxes}"
                            YAxes="{Binding ProviderPurchasingAmountHeatChart.YAxes}" />
                    </StackLayout>
                </Frame>
                <FlexLayout
                    Margin="10"
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <Frame
                        Margin="5"
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource CountCardItemViewChildParentWidthToRelativeWidthConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                FontSize="Medium"
                                FontAttributes="Bold"
                                Text="Compras Realizadas" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <Label
                                Grid.Column="0" Grid.Row="2"
                                VerticalOptions="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="Header"
                                Text="&#xFCB0;" />
                            <Label
                                Grid.Column="1" Grid.Row="2"
                                VerticalOptions="Center"
                                FontSize="Large"
                                HorizontalTextAlignment="End"
                                LineBreakMode="MiddleTruncation"
                                Text="{Binding PurchaseCount}" />
                        </Grid>
                    </Frame>
                    <Frame
                        Margin="5"
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource CountCardItemViewChildParentWidthToRelativeWidthConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                FontSize="Medium"
                                FontAttributes="Bold"
                                Text="Planes de Compra" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <Label
                                Grid.Column="0" Grid.Row="2"
                                VerticalOptions="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="Header"
                                Text="&#xF787;" />
                            <Label
                                Grid.Column="1" Grid.Row="2"
                                VerticalOptions="Center"
                                FontSize="Large"
                                HorizontalTextAlignment="End"
                                LineBreakMode="MiddleTruncation"
                                Text="{Binding PurchasePlanCount}" />
                        </Grid>
                    </Frame>
                    <Frame
                        Margin="5"
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource CountCardItemViewChildParentWidthToRelativeWidthConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                FontSize="Medium"
                                FontAttributes="Bold"
                                Text="Proveedores" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <Label
                                Grid.Column="0" Grid.Row="2"
                                VerticalOptions="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="Header"
                                Text="&#xF6D8;" />
                            <Label
                                Grid.Column="1" Grid.Row="2"
                                VerticalOptions="Center"
                                FontSize="Large"
                                HorizontalTextAlignment="End"
                                LineBreakMode="MiddleTruncation"
                                Text="{Binding ProviderCount}" />
                        </Grid>
                    </Frame>
                    <Frame
                        Margin="5"
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource CountCardItemViewChildParentWidthToRelativeWidthConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                FontSize="Medium"
                                FontAttributes="Bold"
                                Text="Zonas de Compra" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <Label
                                Grid.Column="0" Grid.Row="2"
                                VerticalOptions="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="Header"
                                Text="&#xF352;" />
                            <Label
                                Grid.Column="1" Grid.Row="2"
                                VerticalOptions="Center"
                                FontSize="Large"
                                HorizontalTextAlignment="End"
                                LineBreakMode="MiddleTruncation"
                                Text="{Binding PurchaseZoneCount}" />
                        </Grid>
                    </Frame>
                </FlexLayout>
            </VerticalStackLayout>            
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}" />
    </Grid>
</caneyframework_mvvm_pages:BindingContextedContentPage>