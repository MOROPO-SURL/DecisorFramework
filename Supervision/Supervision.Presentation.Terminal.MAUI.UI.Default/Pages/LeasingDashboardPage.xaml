<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:BindingContextedContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_page_models="clr-namespace:MOROPO.Framework.Decisor.Supervision.Presentation.Terminal.MAUI.Models.Page;assembly=MOROPO.Framework.Decisor.Supervision.Presentation.Terminal.MAUI"
    xmlns:core_models="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:live_charts_controls="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:live_charts_core_skiasharpview_painting="clr-namespace:LiveChartsCore.SkiaSharpView.Painting;assembly=LiveChartsCore.SkiaSharpView"
    x:Class="MOROPO.Framework.Decisor.Supervision.Presentation.Terminal.MAUI.UI.Default.Pages.LeasingDashboardPage"
    x:TypeArguments="presentation_page_models:LeasingDashboardPageModel"
    x:DataType="presentation_page_models:LeasingDashboardPageModel"
    Title="Panel de Control para Arrendamiento">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="FlexLayoutItemResponsiveWithConverter" WrapSpacing="8" SingleSpacing="4" />

            <Style x:Key="CardHeaderSeparatorBoxViewStyle" TargetType="BoxView">
                <Setter Property="Color" Value="DimGray" />
                <Setter Property="Margin" Value="0,5,0,10" />
                <Setter Property="HeightRequest" Value="2" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="4" Margin="8">
                <FlexLayout
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <Frame
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        VerticalOptions="Start">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                FontSize="Medium"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                Text="Propuestas" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <Label
                                Grid.Column="0" Grid.Row="2"
                                VerticalOptions="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="Header"
                                Text="&#xF64A;" />
                            <Label
                                Grid.Column="1" Grid.Row="2"
                                VerticalOptions="Center"
                                FontSize="Large"
                                HorizontalTextAlignment="End"
                                LineBreakMode="TailTruncation"
                                Text="{Binding PropousalCount}" />
                        </Grid>
                    </Frame>
                    <Frame
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        VerticalOptions="Start">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                FontSize="Medium"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                Text="Ofertas" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <Label
                                Grid.Column="0" Grid.Row="2"
                                VerticalOptions="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="Header"
                                Text="&#xF0246;" />
                            <Label
                                Grid.Column="1" Grid.Row="2"
                                VerticalOptions="Center"
                                FontSize="Large"
                                HorizontalTextAlignment="End"
                                LineBreakMode="TailTruncation"
                                Text="{Binding OfferCount}" />
                        </Grid>
                    </Frame>
                    <Frame
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        VerticalOptions="Start">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                FontSize="Medium"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                Text="Postulaciones" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <Label
                                Grid.Column="0" Grid.Row="2"
                                VerticalOptions="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="Header"
                                Text="&#xF0032;" />
                            <Label
                                Grid.Column="1" Grid.Row="2"
                                VerticalOptions="Center"
                                FontSize="Large"
                                HorizontalTextAlignment="End"
                                LineBreakMode="TailTruncation"
                                Text="{Binding PostulationCount}" />
                        </Grid>
                    </Frame>
                    <Frame
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        VerticalOptions="Start">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                FontSize="Medium"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                Text="Arrendamientos" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <Label
                                Grid.Column="0" Grid.Row="2"
                                VerticalOptions="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="Header"
                                Text="&#xF01C9;" />
                            <Label
                                Grid.Column="1" Grid.Row="2"
                                VerticalOptions="Center"
                                FontSize="Large"
                                HorizontalTextAlignment="End"
                                LineBreakMode="TailTruncation"
                                Text="{Binding LeasingCount}" />
                        </Grid>
                    </Frame>
                    <Frame
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        VerticalOptions="Start">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                FontSize="Medium"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                Text="Cont. Terminales" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <Label
                                Grid.Column="0" Grid.Row="2"
                                VerticalOptions="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="Header"
                                Text="&#xF954;" />
                            <Label
                                Grid.Column="1" Grid.Row="2"
                                VerticalOptions="Center"
                                FontSize="Large"
                                HorizontalTextAlignment="End"
                                LineBreakMode="TailTruncation"
                                Text="{Binding EndingContractCount}" />
                        </Grid>
                    </Frame>
                    <Frame
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        VerticalOptions="Start">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                FontSize="Medium"
                                FontAttributes="Bold"
                                LineBreakMode="HeadTruncation"
                                Text="Cont. Vencidos" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <Label
                                Grid.Column="0" Grid.Row="2"
                                VerticalOptions="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="Header"
                                Text="&#xF030C;" />
                            <Label
                                Grid.Column="1" Grid.Row="2"
                                VerticalOptions="Center"
                                FontSize="Large"
                                HorizontalTextAlignment="End"
                                LineBreakMode="TailTruncation"
                                Text="{Binding EndedContractCount}" />
                        </Grid>
                    </Frame>
                </FlexLayout>
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <Frame 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=6, LargeContainerColumn=12}}"
                        VerticalOptions="Start"
                        Margin="4">
                        <VerticalStackLayout>
                            <Label
                                FontSize="Medium"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                Text="Estado de Arrendamiento de Vehículos" />
                            <BoxView Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <FlexLayout 
                                Wrap="Wrap"
                                AlignItems="Start" AlignContent="Start">
                                <VerticalStackLayout
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=6, ExtraLargeContainerColumn=12, LargeContainerColumn=6, MediumContainerColumn=12}}"
                                    Margin="4"
                                    Spacing="6">
                                    <live_charts_controls:PieChart 
                                        x:Name="VehicleAssignmentPieChart"
                                        HeightRequest="360"
                                        Series="{Binding VehicleAssignmentPieChart.Series}"
                                        LegendPosition="Right" />
                                    <BoxView
                                        HeightRequest="2"
                                        Color="DimGray" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        Text="Asignación de vehículos" />
                                </VerticalStackLayout>
                                <VerticalStackLayout
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=6, ExtraLargeContainerColumn=12, LargeContainerColumn=6, MediumContainerColumn=12}}"
                                    Margin="4"
                                    Spacing="6">
                                    <live_charts_controls:PieChart 
                                        x:Name="VehicleLeasingPieChart"
                                        HeightRequest="360"
                                        Series="{Binding VehicleLeasingPieChart.Series}"
                                        LegendPosition="Right" />
                                    <BoxView
                                        HeightRequest="2"
                                        Color="DimGray" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        Text="Contrataciones por Tipo de Actor" />
                                </VerticalStackLayout>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=6, LargeContainerColumn=12}}"
                        VerticalOptions="Start"
                        Margin="4">
                        <VerticalStackLayout>
                            <Label
                                FontSize="Medium"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                Text="Estado de Arrendamiento de Inmuebles" />
                            <BoxView Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <FlexLayout 
                                Wrap="Wrap"
                                AlignItems="Start" AlignContent="Start">
                                <VerticalStackLayout
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=6, ExtraLargeContainerColumn=12, LargeContainerColumn=6, MediumContainerColumn=12}}"
                                    Margin="4"
                                    Spacing="6">
                                    <live_charts_controls:PieChart 
                                        x:Name="PropertySpaceAssignmentPieChart"
                                        HeightRequest="360"
                                        Series="{Binding PropertySpaceAssignmentPieChart.Series}"
                                        LegendPosition="Right" />
                                    <BoxView
                                        HeightRequest="2"
                                        Color="DimGray" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        Text="Asignación de espacios en inmuebles" />
                                </VerticalStackLayout>
                                <VerticalStackLayout
                                    WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource FlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=6, ExtraLargeContainerColumn=12, LargeContainerColumn=6, MediumContainerColumn=12}}"
                                    Margin="4"
                                    Spacing="6">
                                    <live_charts_controls:PieChart 
                                        x:Name="PropertyLeasingPieChart"
                                        HeightRequest="360"
                                        Series="{Binding PropertyLeasingPieChart.Series}"
                                        LegendPosition="Right" />
                                    <BoxView
                                        HeightRequest="2"
                                        Color="DimGray" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        Text="Contrataciones por Tipo de Actor" />
                                </VerticalStackLayout>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Frame>
                </FlexLayout>
                <Frame Margin="8">
                    <StackLayout>
                        <Label
                            FontSize="Medium"
                            FontAttributes="Bold"
                            LineBreakMode="TailTruncation"
                            Text="Cumplimiento de los Pagos (6 meses)" />
                        <BoxView Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                        <live_charts_controls:CartesianChart 
                            MinimumHeightRequest="420"
                            Series="{Binding ClientPaymentPertinenceHeatChart.Series}"
                            XAxes="{Binding ClientPaymentPertinenceHeatChart.XAxes}"
                            YAxes="{Binding ClientPaymentPertinenceHeatChart.YAxes}" />
                    </StackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}" />
    </Grid>
</caneyframework_mvvm_pages:BindingContextedContentPage>