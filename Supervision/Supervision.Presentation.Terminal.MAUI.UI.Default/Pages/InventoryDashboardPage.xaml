<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:BindingContextedContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_page_models="clr-namespace:MOROPO.Framework.Decisor.Supervision.Presentation.Terminal.MAUI.Models.Page;assembly=MOROPO.Framework.Decisor.Supervision.Presentation.Terminal.MAUI"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:live_charts_controls="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    x:Class="MOROPO.Framework.Decisor.Supervision.Presentation.Terminal.MAUI.UI.Default.Pages.InventoryDashboardPage"
    x:TypeArguments="presentation_page_models:InventoryDashboardPageModel"
    x:DataType="presentation_page_models:InventoryDashboardPageModel"
    Title="Panel de Control para Inventario">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CardHeaderSeparatorBoxViewStyle" TargetType="BoxView">
                <Setter Property="Color" Value="DimGray" />
                <Setter Property="Margin" Value="0,5,0,10" />
                <Setter Property="HeightRequest" Value="2" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout>
                <Grid 
                    Margin="20"
                    ColumnSpacing="20" RowSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Frame 
                        Grid.Column="0"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label
                                FontSize="Medium"
                                FontAttributes="Bold"
                                Text="Recepciones en Almacen (6 meses)" />
                            <BoxView Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <live_charts_controls:CartesianChart 
                                HeightRequest="240" 
                                Series="{Binding ReceptionsChart.Series}"
                                XAxes="{Binding ReceptionsChart.XAxes}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label
                                FontSize="Medium"
                                FontAttributes="Bold"
                                Text="Salidas de Almacen (6 meses)" />
                            <BoxView Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <live_charts_controls:CartesianChart 
                                HeightRequest="240" 
                                Series="{Binding DeparturesChart.Series}"
                                XAxes="{Binding DeparturesChart.XAxes}" />
                        </StackLayout>
                    </Frame>
                </Grid>
                <Grid 
                    Margin="20,0"
                    ColumnSpacing="20" RowSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Frame 
                        Grid.Column="0"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label
                                FontSize="Medium"
                                FontAttributes="Bold"
                                Text="Almacenamiento" />
                            <BoxView Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <live_charts_controls:PieChart 
                                HeightRequest="360"
                                Series="{Binding WarehoursesChart.Series}"
                                LegendPosition="Bottom" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.ColumnSpan="2"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label
                                FontSize="Medium"
                                FontAttributes="Bold"
                                Text="Distribución por Categoría" />
                            <BoxView Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                            <live_charts_controls:PieChart 
                                HeightRequest="360"
                                Series="{Binding RootCategoriesChart.Series}"
                                LegendPosition="Right" />
                        </StackLayout>
                    </Frame>
                    <VerticalStackLayout
                        Grid.Column="3"
                        VerticalOptions="Start"
                        Spacing="20">
                        <Frame>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.ColumnSpan="2" Grid.Row="0"
                                    FontSize="Medium"
                                    FontAttributes="Bold"
                                    Text="Productos" />
                                <BoxView
                                    Grid.ColumnSpan="2" Grid.Row="1"
                                    Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                                <Label
                                    Grid.Column="0" Grid.Row="2"
                                    VerticalOptions="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="Header"
                                    Text="&#xF3D7;" />
                                <Label
                                    Grid.Column="1" Grid.Row="2"
                                    VerticalOptions="Center"
                                    FontSize="Large"
                                    HorizontalTextAlignment="End"
                                    LineBreakMode="MiddleTruncation"
                                    Text="{Binding ProductDefinitionCount}" />
                            </Grid>
                        </Frame>
                        <Frame>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.ColumnSpan="2" Grid.Row="0"
                                    FontSize="Medium"
                                    FontAttributes="Bold"
                                    Text="Almacenes" />
                                <BoxView
                                    Grid.ColumnSpan="2" Grid.Row="1"
                                    Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                                <Label
                                    Grid.Column="0" Grid.Row="2"
                                    VerticalOptions="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="Header"
                                    Text="&#xFFBB;" />
                                <Label
                                    Grid.Column="1" Grid.Row="2"
                                    VerticalOptions="Center"
                                    FontSize="Large"
                                    HorizontalTextAlignment="End"
                                    LineBreakMode="MiddleTruncation"
                                    Text="{Binding WarehouseCount}" />
                            </Grid>
                        </Frame>
                        <Frame>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.ColumnSpan="2" Grid.Row="0"
                                    FontSize="Medium"
                                    FontAttributes="Bold"
                                    Text="Categorías" />
                                <BoxView
                                    Grid.ColumnSpan="2" Grid.Row="1"
                                    Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                                <Label
                                    Grid.Column="0" Grid.Row="2"
                                    VerticalOptions="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="Header"
                                    Text="&#xF0C0;" />
                                <Label
                                    Grid.Column="1" Grid.Row="2"
                                    VerticalOptions="Center"
                                    FontSize="Large"
                                    HorizontalTextAlignment="End"
                                    LineBreakMode="MiddleTruncation"
                                    Text="{Binding CategoryCount}" />
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                </Grid>
                <Frame 
                    Margin="20"
                    Grid.Column="0"
                    VerticalOptions="Start">
                    <StackLayout>
                        <Label
                            FontSize="Medium"
                            FontAttributes="Bold"
                            Text="Existencias por Almacen" />
                        <BoxView Style="{StaticResource CardHeaderSeparatorBoxViewStyle}" />
                        <live_charts_controls:CartesianChart 
                            HeightRequest="480"
                            Series="{Binding ProductsChart.Series}"
                            XAxes="{Binding ProductsChart.XAxes}"
                            LegendPosition="Bottom" />
                    </StackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}" />
    </Grid>
</caneyframework_mvvm_pages:BindingContextedContentPage>