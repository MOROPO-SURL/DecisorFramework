<?xml version="1.0" encoding="utf-8" ?>
<core_contract_configuration_pages:BaseConfigurationContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Essential.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Essential.Presentation.Terminal.MAUI"
    xmlns:core_contract_configuration_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.Contract;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Essential.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Essential.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    x:Class="MOROPO.Framework.Decisor.Essential.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.ColaboratorConfigurationPage"
    x:TypeArguments="interop_common_display_models:ColaboratorDisplayModel"
    x:DataType="presentation_configuration_page_models:ColaboratorConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label" x:Key="CaptionFieldLabelStyle">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=DimGray, Dark=Gray}" />
            </Style>

            <Array Type="{x:Type x:Int32}" x:Key="PriorityValues">
                <x:Int32>1</x:Int32>
                <x:Int32>2</x:Int32>
                <x:Int32>3</x:Int32>
                <x:Int32>4</x:Int32>
                <x:Int32>5</x:Int32>
                <x:Int32>6</x:Int32>
                <x:Int32>7</x:Int32>
                <x:Int32>8</x:Int32>
                <x:Int32>9</x:Int32>
                <x:Int32>10</x:Int32>
            </Array>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
        Text="Aplicar"
        Clicked="ApplyClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
        Text="Cancelar"
        Clicked="CancelClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <Grid 
                Padding="20"
                ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Frame
                    Grid.Column="0" Grid.Row="0" Grid.RowSpan="5"
                    VerticalOptions="Start"
                    Padding="0"
                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}">
                    <Grid>
                        <Image Source="{Binding ImageSource, TargetNullValue='default_person_picture.jpg'}" />
                        <Grid BackgroundColor="#A7000000">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ImageLayoutTapGestureRecognizer_Tapped" />
                            </Grid.GestureRecognizers>
                            <Label
                                Text="&#xF8CB;"
                                TextColor="White"
                                HorizontalOptions="Center" VerticalOptions="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="96" />
                        </Grid>
                    </Grid>
                </Frame>
                <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="0">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                    <Entry Text="{Binding Name}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Apellidos" />
                    <Entry Text="{Binding LastName}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.Row="2">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Número de identidad" />
                    <Entry Text="{Binding PersonalIdentificationNumber}" Keyboard="Numeric" MaxLength="11" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="2" Grid.Row="2">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Alias" />
                    <Entry Text="{Binding Alias}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.Row="3">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Sexo" />
                    <Picker
                        x:Name="SexPicker"
                        SelectedItem="{Binding Sex}" 
                        ItemsSource="{Binding AvailableSexs}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="2" Grid.Row="3">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Estado Civil" />
                    <Picker
                        x:Name="CivilStatusPicker"
                        SelectedItem="{Binding CivilStatus}" 
                        ItemsSource="{Binding AvailableCivilStatuses}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="4" Grid.Row="4">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descrición (Opcional)" />
                    <Editor Text="{Binding About}" HeightRequest="200" BackgroundColor="#F8F9FA" />
                </VerticalStackLayout>
                <BoxView 
                    Grid.ColumnSpan="4" Grid.Row="5" 
                    Margin="0,8,0,0"
                    HeightRequest="1" 
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray100}}" />
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                    <Picker SelectedItem="{Binding Priority}" ItemsSource="{StaticResource PriorityValues}" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
        <caneyframework_presentation_views:BusyView
            BackgroundColor="#A7FFFFFF"
            IsVisible="{Binding IsBusy}" />
    </Grid>
</core_contract_configuration_pages:BaseConfigurationContentPage>