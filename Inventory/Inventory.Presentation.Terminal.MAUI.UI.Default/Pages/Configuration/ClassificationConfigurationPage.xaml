<core_ui_base_pages:ConfigurationBaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Inventory.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Inventory.Presentation.Terminal.MAUI"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:interop_common_input_models="clr-namespace:MOROPO.Framework.Decisor.Inventory.Interop.API.Common.Models.Input;assembly=MOROPO.Framework.Decisor.Inventory.Interop.API.Common"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    x:Class="MOROPO.Framework.Decisor.Inventory.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.ClassificationConfigurationPage"
    x:TypeArguments="interop_common_input_models:ClassificationInputModel,interop_common_input_models:ClassificationInputModel,presentation_configuration_page_models:ClassificationConfigurationPageModel"
    x:DataType="presentation_configuration_page_models:ClassificationConfigurationPageModel">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyControl_Invoked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
        Text="Cancelar"
        Clicked="CancelControl_Invoked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ScrollView Orientation="Vertical">
        <VerticalStackLayout 
            Padding="20"
            Spacing="16">
            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                <Entry Text="{Binding Name}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descrición (Opcional)" />
                <Editor Text="{Binding Description}" HeightRequest="200" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Producto" />
                <Entry IsEnabled="False" Text="{Binding ProductConfigurationPageModel.Name}" />
            </VerticalStackLayout>
            <BoxView 
                Margin="0,8,0,0"
                HeightRequest="1" 
                Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray100}}" />
            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                <Picker SelectedItem="{Binding Priority}" ItemsSource="{StaticResource PriorityValues}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</core_ui_base_pages:ConfigurationBaseContentPage>
