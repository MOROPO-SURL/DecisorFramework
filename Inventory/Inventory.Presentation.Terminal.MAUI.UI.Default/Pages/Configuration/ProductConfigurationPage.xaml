<?xml version="1.0" encoding="utf-8" ?>
<core_contract_configuration_pages:BaseConfigurationContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation_configuration_page_models="clr-namespace:MOROPO.Framework.Decisor.Inventory.Presentation.Terminal.MAUI.Models.Page.Configuration;assembly=MOROPO.Framework.Decisor.Inventory.Presentation.Terminal.MAUI"
    xmlns:core_contract_configuration_pages="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.Contract;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Default"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Inventory.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Inventory.Interop.API.Common"
    xmlns:caneyframework_presentation_converters="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Converters;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    x:Class="MOROPO.Framework.Decisor.Inventory.Presentation.Terminal.MAUI.UI.Default.Pages.Configuration.ProductConfigurationPage"
    x:TypeArguments="interop_common_display_models:ProductDisplayModel"
    x:DataType="presentation_configuration_page_models:ProductConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label" x:Key="CaptionFieldLabelStyle">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=DimGray, Dark=Gray}" />
            </Style>

            <Array Type="{x:Type x:Int32}" x:Key="PriorityValues">
                <x:Int32>1</x:Int32>
                <x:Int32>2</x:Int32>
                <x:Int32>3</x:Int32>
                <x:Int32>4</x:Int32>
                <x:Int32>5</x:Int32>
                <x:Int32>6</x:Int32>
                <x:Int32>7</x:Int32>
                <x:Int32>8</x:Int32>
                <x:Int32>9</x:Int32>
                <x:Int32>10</x:Int32>
            </Array>

            <caneyframework_presentation_converters:DoubleToFractionConverter x:Key="DoubleToFractionConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
        Text="Aplicar"
        Clicked="ApplyClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
        Text="Cancelar"
        Clicked="CancelClickableControl_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <Grid 
                Padding="20"
                ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Frame
                    Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                    VerticalOptions="Start"
                    Padding="0"
                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width, Converter={StaticResource DoubleToFractionConverter}, ConverterParameter=1.777777777777778}">
                    <Grid>
                        <Image 
                            Aspect="AspectFill"
                            Source="{Binding Path=FeatureImageSource, TargetNullValue='default_organization_picture.png'}" />
                        <Grid BackgroundColor="#A7000000">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ImageLayoutTapGestureRecognizer_Tapped" />
                            </Grid.GestureRecognizers>
                            <Label
                                Text="&#xF8CB;"
                                TextColor="White"
                                HorizontalOptions="Center" VerticalOptions="Center"
                                FontFamily="MaterialDesignIcons"
                                FontSize="96" />
                        </Grid>
                    </Grid>
                </Frame>
                <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="0">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                    <Entry Text="{Binding Name}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" VerticalOptions="Start">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Unidad de Medida por defecto" />
                    <Picker 
                        x:Name="DefaultUnitMeasurementPicker"
                        ItemsSource="{Binding Path=AvailableUnitMeasurements}" 
                        ItemDisplayBinding="{Binding Name}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.ColumnSpan="4" Grid.Row="2">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descrición (Opcional)" />
                    <Editor Text="{Binding Description}" HeightRequest="200" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Mermas de Almacenamiento" />
                    <Frame Padding="8">
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                HorizontalOptions="End"
                                Text="Agregar" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Color="{StaticResource Gray050}" />
                            <CollectionView
                                Margin="4"
                                Grid.ColumnSpan="2" Grid.Row="2">
                                <CollectionView.EmptyView>
                                    <Label Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" Margin="10" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
                <BoxView 
                    Grid.ColumnSpan="4" Grid.Row="4" 
                    Margin="0,8,0,0"
                    HeightRequest="1" 
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray100}}" />
                <VerticalStackLayout Spacing="6" Grid.Column="0" Grid.Row="5">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                    <Picker SelectedItem="{Binding Priority}" ItemsSource="{StaticResource PriorityValues}" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
        <caneyframework_presentation_views:BusyView
            Grid.ColumnSpan="4" Grid.RowSpan="6"
            BackgroundColor="#A7FFFFFF"
            IsVisible="{Binding IsBusy}" />
    </Grid>
</core_contract_configuration_pages:BaseConfigurationContentPage>