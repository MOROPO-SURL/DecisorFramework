<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core_ui_converters="clr-namespace:MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.Framework.Decisor.Core.Presentation.Terminal.MAUI"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.Framework.Decisor.Inventory.Interop.API.Common.Models.Display;assembly=MOROPO.Framework.Decisor.Inventory.Interop.API.Common"
    x:Class="MOROPO.Framework.Decisor.Inventory.Presentation.Terminal.MAUI.UI.Default.Views.Card.ProductDefaultCardView"
    x:DataType="interop_common_display_models:ProductDisplayModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Frame 
        Padding="0"
        HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}">
        <StackLayout Spacing="0">
            <Image
                VerticalOptions="FillAndExpand"
                Aspect="AspectFill"
                Source="{Binding FeatureImage, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_organization_picture.png'}" />
            <VerticalStackLayout
                IsClippedToBounds="True"
                HeightRequest="168"
                Padding="16">
                <Label
                    LineBreakMode="TailTruncation"
                    FontSize="Medium"
                    Text="{Binding Name}"
                    ToolTipProperties.Text="{Binding Name}" />
                <Label 
                    Margin="0,6,0,0"
                    Text="Familia"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold" />
                <Label
                    VerticalOptions="FillAndExpand"
                    LineBreakMode="TailTruncation"
                    MaxLines="2"
                    Text="{Binding Category.Name, FallbackValue='---', TargetNullValue='---'}" />
                <Label 
                    Margin="0,6,0,0"
                    Text="Descripción"
                    TextColor="DimGray"
                    FontSize="Caption"
                    FontAttributes="Bold" />
                <Label
                    VerticalOptions="FillAndExpand"
                    LineBreakMode="TailTruncation"
                    MaxLines="2"
                    Text="{Binding Description, FallbackValue='---', TargetNullValue='---'}" />
            </VerticalStackLayout>
        </StackLayout>
    </Frame>
</ContentView>
